{pad:meta title='The option form', about='ignore on another tag protects that tag\'s content - here a data block whose rows hold braces.'/}
{format:auto 'snippets' ignore}
  [ { "code": "{$name}" }, { "code": "{pad:echo 1 + 1}" } ]
{/format:auto}
<ul>
  {data:snippets}
    <li><code>{$code}</code></li>
  {/data:snippets}
</ul>

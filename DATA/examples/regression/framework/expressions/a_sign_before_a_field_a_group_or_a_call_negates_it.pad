[{echo 5 * -$b}][{echo $a - -$b}][{echo 5 * -(1 + 2)}][{echo 10 / -$n}][{echo 2 ** -$n}]
[{echo 5 * - 3}][{echo 2 - - 3}][{echo 3 - -$n * 2}][{echo 5 * -php:abs(3)}][{echo 1 + +$b}]
[{echo 10 | * -$n}][{echo 'abcdef' | substr(-$n)}][{echo 'abcdef' | substr(1, -$n)}][{echo php:max(1, -$n)}]
[{if $neg gt -$b}T{else}F{/if}][{echo -$b}][{echo 10 | - 3}]

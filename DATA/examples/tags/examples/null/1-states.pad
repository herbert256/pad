{pad:meta title='Three states side by side', about='The @else@ part renders for {pad:false} but not for {pad:null}.'/}
<ul>
  <li>true: {pad:true}content@else@else part{/pad:true}</li>
  <li>false: {pad:false}content@else@else part{/pad:false}</li>
  <li>null: {pad:null}content@else@else part{/pad:null}</li>
</ul>

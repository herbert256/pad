{pad:meta title='Slides from data, no captions', about='A slide per row of the data; a carousel slide may go without a label.'/}
{widget:carousel label='What customers say'}
  {array:quotes}
    {widget:tab}
      <blockquote>
        <p>{$text}</p>
        <footer>{$name}</footer>
      </blockquote>
    {/widget:tab}
  {/array:quotes}
{/widget:carousel}

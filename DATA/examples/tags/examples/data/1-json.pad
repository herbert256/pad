{pad:meta title='JSON rows', about='An array of objects becomes rows with fields, iterated by the name it was given.'/}
{pad:data 'dataPlanets'}
[
  { "name": "Mercury", "moons": 0 },
  { "name": "Earth",   "moons": 1 },
  { "name": "Mars",    "moons": 2 }
]
{/pad:data}
<ul>
{data:dataPlanets}
  <li>{$name}: {$moons} {pad:echo $moons eq 1 ? 'moon' : 'moons'/}</li>
{/data:dataPlanets}
</ul>

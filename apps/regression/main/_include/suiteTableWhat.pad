<table border="1" cellpadding="4" cellspacing="0">
  <tr><th>page</th><th>what it checks</th><th>status</th></tr>
  {array:tests}
    <tr>
      <td><a href="{$url}">{$name}</a></td>
      <td>{pad:echo $what | ignore/}</td>
      <td>{$status}</td>
    </tr>
    {pad:if $status ne 'ok'}
      <tr>
        <td colspan="3">
          <b>want</b> <pre>{!want}</pre>
          <b>got</b> <pre>{!got}</pre>
          {pad:if $recordable eq 1}
            <a href="?record&suite={$suiteKey}{?name}">record what it answers now</a>
          {/pad:if}
        </td>
      </tr>
    {/pad:if}
  {/array:tests}
</table>

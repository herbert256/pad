{meta title='Accents, text and colour', about='Hats, bars and vectors over a letter, words as text in a formula, a part in colour and one struck through.'/}
{math display='block'}vec v = hat i + 2 hat j, quad bar x = 1/n sum x_i, quad dot x = (dx)/(dt){/math}
{math display='block'}text(speed) = text(distance)/text(time), quad color(red)(x) + cancel(y - y) = x{/math}
{math display='block'}ubrace(1 + 2 + ... + n)_(n text( terms)) = (n(n+1))/2{/math}

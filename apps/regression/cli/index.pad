{if $tested eq 1}
  <p>render: <b>{$render}</b></p>
  <p>new: <b>{$new}</b></p>
  <p>lint: <b>{$lint}</b></p>
  <p>serve: <b>{$serve}</b></p>
  <p>export: <b>{$export}</b></p>
  <p>test: <b>{$test}</b></p>
  <p>migrate: <b>{$migrate}</b></p>
  <p>seed: <b>{$seed}</b></p>
  <p>down: <b>{$down}</b></p>
  <p>work: <b>{$work}</b></p>
  <p>schedule: <b>{$schedule}</b></p>
{else}
  <p><a href="?index&test">Test</a> the pad command</p>
{/if}

{pad:meta title='Options and an empty result', about='Handling options work on the rows; @else@ shows when there are none.'/}
{pad:array "number, total from orders where status='open'", name='open', sort='total DESC', first=5}
  {property:first@open}<table>{/property:first@open}
  <tr><td>{$number}</td><td>{$total | currency('EUR')}</td></tr>
  {property:last@open}</table>{/property:last@open}
@else@
  <p>No open orders.</p>
{/pad:array}

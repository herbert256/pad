{pad:content 'myContent'}
  <table border=1 valign=center>
    <tr>
      <th>        </th>
      <th> first  </th>
      <th> border </th>
      <th> middle </th>
      <th> last   </th>
      <th> even   </th>
      <th> odd    </th>
    </tr>
    @content@
  </table>
{/pad:content}

{content:myContent}
  {local:staff}
    <tr>
      <td> {$name}                          </td>
      <td> {property:first@staff}  X {/property:first@staff}  </td>
      <td> {property:border@staff} X {/property:border@staff} </td>
      <td> {property:middle@staff} X {/property:middle@staff} </td>
      <td> {property:last@staff}   X {/property:last@staff}   </td>
      <td> {property:even@staff}   X {/property:even@staff}   </td>
      <td> {property:odd@staff}    X {/property:odd@staff}    </td>
    </tr>
  {/local:staff}
{/content:myContent}

{content:myContent}
  {local:staff}
  	{pad:true}
	    <tr>
	      <td> {$name}                     </td>
	      <td> {property:first@-2}  X {/property:first@-2}  </td>
	      <td> {property:border@-2} X {/property:border@-2} </td>
	      <td> {property:middle@-2} X {/property:middle@-2} </td>
	      <td> {property:last@-2}   X {/property:last@-2}   </td>
	      <td> {property:even@-2}   X {/property:even@-2}   </td>
	      <td> {property:odd@-2}    X {/property:odd@-2}    </td>
	    </tr>
    {/pad:true}
  {/local:staff}
{/content:myContent}

{content:myContent}
  {local:staff}
  	<tr>
      <td> {$name}                </td>
      <td> {property:first@}  X {/property:first@}  </td>
      <td> {property:border@} X {/property:border@} </td>
      <td> {property:middle@} X {/property:middle@} </td>
      <td> {property:last@}   X {/property:last@}   </td>
      <td> {property:even@}   X {/property:even@}   </td>
      <td> {property:odd@}    X {/property:odd@}    </td>
    </tr>
  {/local:staff}
{/content:myContent}

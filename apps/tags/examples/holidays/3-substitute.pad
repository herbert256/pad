{meta title='Substitute days', about='A bank holiday on a weekend gets the next free weekday; from= and to= ask for the days between two dates.'/}
<ul>
  {holidays 'gb', from='2021-12-20', to='2022-01-10', lang='en'}
    <li>{$date} {$name}{if $substitute} - made up for{/if}</li>
  {/holidays}
</ul>

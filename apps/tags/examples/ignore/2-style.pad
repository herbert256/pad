{meta title='An inline style block', about='CSS selector blocks inside the pair reach the browser; the rest of the page is rendered as usual.'}
{ignore}
<style>
  .ignore-demo { padding: 8px 12px; border-left: 4px solid #eb6834; }
  .ignore-demo b { color: #eb6834; }
</style>
{/ignore}
{set $who = 'PAD'}
<p class="ignore-demo">Styled by <b>{$who}</b>.</p>

{calendar holidays='za'}{days}{if $holiday}{$date}={$holiday};{/if}{/days}{/calendar}|
{calendar $month, holidays='za'}{days}{if $holiday}{$date}={$holiday};{/if}{/days}{/calendar}|
{calendar query='later', holidays='nz'}{days}{if $holiday}{$date}={$holiday};{/if}{/days}{/calendar}|
{calendar '2014-01', holidays='za'}{days}{if $holiday}{$date}={$holiday};{/if}{/days}{/calendar}|
{calendar '2052-12', holidays='nz'}{days}{if $holiday}{$date}={$holiday};{/if}{/days}{/calendar}

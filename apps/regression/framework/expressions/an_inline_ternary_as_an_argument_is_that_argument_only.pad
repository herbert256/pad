{pad:set $n = 5/}{pad:set $s = 'banana'/}{pad:set $z = 0/}[{pad:echo $s | replace('a', $n gt 1 ? 'x' : 'y')/}][{pad:echo php:str_repeat('-', $n gt 0 ? $n : 1)/}][{pad:echo php:str_repeat($n gt 0 ? '+' : '-', 3)/}][{pad:echo php:max($n gt 3 ? 1 : 9, $z ? 4 : 2)/}][{pad:echo php:max($z ? 1 : php:min(8, 7), 3)/}][{pad:echo php:implode('-', [1, $n gt 3 ? 2 : 0, 3])/}][{pad:echo $s | replace('a', $n gt 9 ? 'x' : $n gt 4 ? 'm' : 's')/}]

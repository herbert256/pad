[{pad:echo 1 ? 'yes' : $missing/}][{pad:echo 0 ? $missing : 'no'/}][{pad:echo 'x' ?: $missing . '!'/}][{pad:echo 0 and $missing/}][{pad:echo 1 or 7 / 0/}][{pad:echo 'ok' ?? (7 / 0)/}][{pad:echo 0 and php:branchCount(1)/}][{pad:echo 1 || php:branchCount(1)/}][{pad:echo 'ok' ?? php:branchCount('e')/}][{$branchCalls}][{pad:echo 1 and php:branchCount(1)/}][{pad:echo '' ?? php:branchCount('e')/}][{$branchCalls}][{pad:echo 'v' | php:branchCount | $later/}]

{meta title='Tags by name'/}
<h1>Tags by name</h1>
<p class="lead">All {$tagsCount} tags from A to Z, by their name after the type prefix.</p>

<nav class="jump" aria-label="Letters">{letters}<a href="#letter-{$letter}">{$letter}</a>{/letters}</nav>

{letters}
<section class="section" id="letter-{$letter}">
  <div class="section-head"><h2>{$letter}</h2><span>{$count} {echo $count eq 1 ? 'tag' : 'tags'/}</span></div>
  <ul class="list">
    {tags}
    <li><a class="name" href="?{$link}">&#123;{$key}&#125;</a> <span class="about">{$about} <a class="meta" href="?groups#{$group}">{$groupLabel}</a></span></li>
    {/tags}
  </ul>
</section>
{/letters}

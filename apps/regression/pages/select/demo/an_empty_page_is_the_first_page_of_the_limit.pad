one: [{select:customerSel fields="customerNumber", sort="customerNumber desc", page=1}{$customerNumber} {/select:customerSel}]
empty: [{select:customerSel fields="customerNumber", sort="customerNumber desc", page=$none}{$customerNumber} {/select:customerSel}]
zero: [{select:customerSel fields="customerNumber", sort="customerNumber desc", page=$zero}{$customerNumber} {/select:customerSel}]

tag: [{select:staffSel rows=0}{$name} @else@none{/select:staffSel}]
value: [{select:staffSel rows=$none}{$name} @else@none{/select:staffSel}]
list: [{array:names rows=0}{$names} @else@none{/array:names}]
declared: [{select:allCustomers}{property:last@allCustomers}{property:count@allCustomers/}{/property:last@allCustomers}{/select:allCustomers}]
paged: [{select:allCustomers page=2}{property:last@allCustomers}{property:count@allCustomers/}{/property:last@allCustomers}{/select:allCustomers}]

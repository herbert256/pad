<h3>getReference over the type handlers</h3><p>{getReference 'types', 'tag'}{$item} {/getReference}</p><h3>The Xref link builders</h3><p>parts: {$partsCount}</p><p>forLink: {forLink}</p><p>itemLink: {itemLink}</p><p>secondLink: {secondLink}</p><?php // The globals the Xref link builders read; parts() answers an empty list these days, and // the count asserts exactly that. $first = 1; $for = 'demo'; $xitem = 'clock'; $second = 'x'; $go = 1; $partsCount = count ( parts () ); return TRUE;?>
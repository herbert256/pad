<form class="bar" method="get">
  <input type="hidden" name="files" value="">
  <label>Application
    <select name="app" onchange="this.form.submit()">
      <option value="">- choose -</option>
      {array:appRows}<option value="{$name}" {pad:if $selected}selected{/pad:if}>{$name}</option>{/array:appRows}
    </select>
  </label>
  {pad:if $app ne ''}{pad:if $hasWww}
    <label>Root
      <select name="root" onchange="this.form.submit()">
        <option value="app" {pad:if $root eq 'app'}selected{/pad:if}>apps/{$app}/</option>
        <option value="www" {pad:if $root eq 'www'}selected{/pad:if}>www/{$app}/</option>
      </select>
    </label>
  {/pad:if}{/pad:if}
  <noscript><button>Show</button></noscript>
</form>

{pad:if $app ne ''}

  <p class="crumbs">
    {array:crumbs}{property:notFirst@crumbs} / {/property:notFirst@crumbs}<a href="?files&amp;app={$app}&amp;root={$root}&amp;dir={$dir | url}">{$label}</a>{/array:crumbs}
  </p>

  <div class="browser">

    <nav class="card" aria-label="Files">
      <ul class="tree">
        {pad:if $hasParent}
          <li><a href="?files&amp;app={$app}&amp;root={$root}&amp;dir={$parentDir | url}">{icon:arrow-up size=14/} ..</a></li>
        {/pad:if}
        {array:dirRows}
          <li><a href="?files&amp;app={$app}&amp;root={$root}&amp;dir={$path | url}">{icon:folder size=14/} {$name}</a></li>
        {/array:dirRows}
        {array:fileRows}
          <li><a href="?files&amp;app={$app}&amp;root={$root}&amp;dir={$dir | url}&amp;file={$path | url}" {pad:if $current}class="current" aria-current="page"{/pad:if}>{icon:file size=14/} {$name}</a></li>
        {/array:fileRows}
      </ul>
    </nav>

    <div>
      {pad:if $fileName ne ''}
        <section class="card">
          <h2>{icon:file size=18/} {$fileName}</h2>
          <p class="dim">
            {$fileInfo}
            - <a href="{$padRoot}edit/?app={$app}">open in the editor</a>
            {pad:if $isMarkdown} - <a href="?files&amp;app={$app}&amp;root={$root}&amp;file={$fileName | url}&amp;as=text">as text</a>{/pad:if}
            {pad:if $isMdText} - <a href="?files&amp;app={$app}&amp;root={$root}&amp;file={$fileName | url}">as Markdown</a>{/pad:if}
          </p>
          {pad:if $notShown ne ''}
            <p class="flash warn">{$notShown}</p>
          {pad:elseif $isMarkdown}
            <div class="markdown">{!shown}</div>
          {pad:else}
            <div class="source">{!shown}</div>
          {/pad:if}
        </section>
      {pad:else}
        <section class="card"><p class="dim">Choose a file on the left.</p></section>
      {/pad:if}
    </div>

  </div>

{pad:else}
  <section class="card"><p class="dim">Choose an application.</p></section>
{/pad:if}

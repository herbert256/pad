{pad:data 'xs'}[{"n":"a"},{"n":"b"},{"n":"c"}]{/pad:data}
{data:xs}[{pad:echo current@ eq 2/}]{/data:xs}
{data:xs}[{pad:echo current@ + 0/}]{/data:xs}
{data:xs}[{pad:if current@ eq 2}two{pad:else}no{/pad:if}]{/data:xs}
{data:xs}[{pad:if 1 eq 1}{pad:echo current@ * 10/}{/pad:if}]{/data:xs}
{data:xs}[{$n | @ . current@}]{/data:xs}

{common:table}

{common:demo}{sequence:loop 25, push='mySequence'/} {/common:demo}

{common:demo}{pad:pull mySequence, make,   range='5..15'} {$sequence} {/pad:pull}{/common:demo}

{common:demo}{pad:pull mySequence, keep,   range='5..15'} {$sequence} {/pad:pull}{/common:demo}

{common:demo}{pad:pull mySequence, remove, range='5..15'} {$sequence} {/pad:pull}{/common:demo}

{common:demo}{pad:pull mySequence, flag,   range='5..15'} {$sequence} {/pad:pull}{/common:demo}

{/common:table}

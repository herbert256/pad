{pad:meta title='The prefix says which is meant', about='A data store named upper: {data:upper} selects the store, and function:upper selects the function.'/}
{format:auto 'upper'}["a", "b"]{/format:auto}
<p>{data:upper}{$upper} {/data:upper}</p>
<p>{function:upper}the function{/function:upper}</p>

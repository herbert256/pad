<table border=1>
  <tr>
    <td> employee </td>
    <td> manager </td>
    <td> boss </td>
  </tr>
  {select:employees}
    <tr>
      <td> {$lastName},
           {$firstName}
           ({$employeeNumber})
      </td>
      <td>
        {select:managers}
          {$lastName},
             {$firstName}
             ({$employeeNumber})
        {/select:managers}
      </td>
      <td>
        {select:managers}
          {select:bosses}
            {$lastName},
               {$firstName}
               ({$employeeNumber})
          {/select:bosses}
        {/select:managers}
      </td>
    </tr>
  {/select:employees}
</table>

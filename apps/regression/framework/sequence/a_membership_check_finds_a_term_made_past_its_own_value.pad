[{sequence eval='100 - @', rows=3}{$sequence} {/sequence}][{sequence '1;50;99', flag, eval='100 - @'}{$sequence}{/sequence}][{sequence '-3;-2;-1', flag, eval='@ * -1'}{$sequence}{/sequence}][{sequence '0;1;2;3', flag, eval='@ % 4'}{$sequence}{/sequence}][{sequence '0.5;1;1.5', flag, eval='@ / 2'}{$sequence}{/sequence}][{sequence '8.5;3.5', flag, step=2.5}{$sequence}{/sequence}][{sequence '3.5;8.5', flag, step=2.5}{$sequence}{/sequence}][{sequence '2.5;7.5;5', flag, floor=2.5}{$sequence}{/sequence}][{sequence '30000;30001', flag, eval='@ * 2'}{$sequence}{/sequence}]
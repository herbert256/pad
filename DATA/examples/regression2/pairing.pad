{$greeting}:{items}{$items}{/items}<?php // The thing an in-request case cannot be: a page whose .php half leaves variables for its // .pad half. A nested pass has a scope of its own, so a case rendered inside another // request has to state its data in the template; here the two files pair the way every // PAD page does. $greeting = 'Hello'; $items = [ 'a', 'b', 'c' ];?>
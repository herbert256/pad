[{array:rows}{$name}:{pad:while $n gt 0}{$n}{pad:decrement $n/}{/pad:while}/{$n};{/array:rows}]
[{array:rows}{$n}>{pad:set $n = $n - 1/}{$n}/{pad:echo $n/}/{pad:if $n eq 1}one{pad:else}not{/pad:if};{/array:rows}]
[{pad:set $n = 0/}{array:rows}{pad:set $n = 99/}{/array:rows}{$n}]
[{array:rows}{pad:increment $n/}{/array:rows}{$n}]

{meta title='The space age', about='Ten moments on a time axis with round year ticks - the cards alternate above and below and step outward where they would collide.'}
{timeline date='when', label='what', text='detail', format='Y', title='Milestones of spaceflight'}
  when,what,detail
  1957-10-04,Sputnik 1,First satellite
  1961-04-12,Vostok 1,Gagarin in orbit
  1962-02-20,Friendship 7,Glenn orbits the Earth
  1965-03-18,Voskhod 2,The first spacewalk
  1969-07-20,Apollo 11,People on the Moon
  1971-04-19,Salyut 1,First space station
  1981-04-12,STS-1,First Space Shuttle flight
  1990-04-24,Hubble,A telescope in orbit
  1998-11-20,Zarya,The ISS begins
  2012-08-06,Curiosity,A rover lands on Mars
{/timeline}

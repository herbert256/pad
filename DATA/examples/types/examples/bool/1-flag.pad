{pad:meta title='A boolean store', about='The pair shows when the flag is true, its @else@ when it is not.'/}
{pad:bool 'isAdmin'}1{/pad:bool}
{pad:bool 'isGuest'}0{/pad:bool}
<p>{bool:isAdmin}An administrator.@else@No administrator.{/bool:isAdmin}</p>
<p>{bool:isGuest}A guest.@else@No guest.{/bool:isGuest}</p>

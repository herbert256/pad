{
    "PAD if block": {
        "prefix": "padif",
        "body": [
            "{pad:if \\$${1:var} ${2:eq} ${3:1}}",
            "\t$0",
            "{/pad:if}"
        ],
        "description": "PAD if block"
    },
    "PAD data iteration": {
        "prefix": "padloop",
        "body": [
            "{array:${1:items}}",
            "\t$0",
            "{/array:${1:items}}"
        ],
        "description": "PAD data iteration pair"
    },
    "PAD data definition": {
        "prefix": "paddata",
        "body": [
            "{format:auto '${1:name}'}",
            "\t$0",
            "{/format:auto}"
        ],
        "description": "PAD data definition"
    },
    "PAD ignore block": {
        "prefix": "padignore",
        "body": [
            "{pad:ignore}",
            "$0",
            "{/pad:ignore}"
        ],
        "description": "PAD ignore block (raw braces)"
    },
    "PAD case block": {
        "prefix": "padcase",
        "body": [
            "{pad:case \\$${1:var}}",
            "\t{pad:when '${2:value}'} $0",
            "\t{pad:else}",
            "{/pad:case}"
        ],
        "description": "PAD case/when block"
    }
}

{common:padFrame}
  {pad:slot 'head'}
    <meta name="robots" content="noindex">
    {pad:asset 'admin.css', tag/}
    {pad:asset 'admin.js', tag/}
  {/pad:slot}

  {pad:slot 'foot'}
    {pad:if $adminIn}
      <div class="frame-foot">
        {icon:user size=16/} {$adminWho} <span class="dim">on {$adminHost}</span>
        <form method="post" action="?logout"><button>{icon:log-out size=16/} Log out</button></form>
      </div>
    {/pad:if}
  {/pad:slot}
{/common:padFrame}

{pad:if $adminIn}
  {pad:flash}
    <p class="flash {$type}" role="status">{$message}</p>
  {/pad:flash}
{/pad:if}

@page@

{common:padFrameEnd/}

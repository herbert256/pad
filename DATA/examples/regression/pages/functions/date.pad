{# this page prints the clock, so its answer is different every second - the crawl reads the
   word random here and stops comparing it. The pages suite asserts its shape instead. #}
{pad:echo date/} <br>
{pad:echo 772345654 | date /} <br>
{pad:echo date ('Y-m-d H:i:s')/} <br>
{pad:echo 772345654 | date ('Y-m-d H:i:s')/} <br>
{pad:echo date ('Y-m-d', 'tomorrow')/} <br>
{pad:echo date ('Y-m-d', 'yesterday')/} <br>

{format:auto 'trip', format='toml'}
  title = "Weekend in Ghent"
  start = 2026-11-06

  [[stops]]
  name = "Gravensteen"
  hours = 2

  [[stops]]
  name = "Graslei"
  hours = 1.5
{/format:auto}

{data:trip}
  <h3>{$title} - {$start}</h3>
  <ul>
    {array:stops}
      <li>{$name}: {$hours} h</li>
    {/array:stops}
  </ul>
{/data:trip}

{# This page prints the clock, so it says something different every second and can never
   match a stored copy - and not only in its digits: AM turns to PM and the weekday changes
   name, which digit masking cannot cover. The crawl marks this page uncomparable by name
   and only checks that it still answers. #}
<p>Current date and time information.</p>

<h2>Current Time</h2>

<div class="counter" style="font-size: 36px;">
  {app:clock 'l, F j, Y'/}<br>
  {app:clock 'g:i:s A'/}
</div>

<h2>Time Formats</h2>

<table>
  <tr>
    <th>Format</th>
    <th>Value</th>
  </tr>
  <tr>
    <td>12-hour format</td>
    <td>{app:clock 'g:i:s A'/}</td>
  </tr>
  <tr>
    <td>24-hour format</td>
    <td>{app:clock 'H:i:s'/}</td>
  </tr>
  <tr>
    <td>ISO 8601</td>
    <td>{app:clock 'c'/}</td>
  </tr>
  <tr>
    <td>RFC 2822</td>
    <td>{app:clock 'r'/}</td>
  </tr>
  <tr>
    <td>Unix Timestamp</td>
    <td>{app:clock 'U'/}</td>
  </tr>
</table>

<h2>Calendar Information</h2>

<table>
  <tr>
    <th>Property</th>
    <th>Value</th>
  </tr>
  <tr>
    <td>Day of Week</td>
    <td>{app:clock 'l'/}</td>
  </tr>
  <tr>
    <td>Month</td>
    <td>{app:clock 'F'/}</td>
  </tr>
  <tr>
    <td>Year</td>
    <td>{app:clock 'Y'/}</td>
  </tr>
  <tr>
    <td>Day of Year</td>
    <td>{app:clock 'z' | + 1/} of {pad:if {app:clock 'L'/} eq 1}366@else@365{/pad:if}</td>
  </tr>
  <tr>
    <td>Week of Year</td>
    <td>{app:clock 'W'/}</td>
  </tr>
  <tr>
    <td>Days in This Month</td>
    <td>{app:clock 't'/}</td>
  </tr>
  <tr>
    <td>Days Remaining in Year</td>
    <td>{pad:if {app:clock 'L'/} eq 1}{pad:echo 365 - {app:clock 'z'/}/}@else@{pad:echo 364 - {app:clock 'z'/}/}{/pad:if}</td>
  </tr>
  <tr>
    <td>Leap Year</td>
    <td>{pad:if {app:clock 'L'/} eq 1}Yes@else@No{/pad:if}</td>
  </tr>
  <tr>
    <td>Timezone</td>
    <td>{php:date_default_timezone_get/}</td>
  </tr>
</table>

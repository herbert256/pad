{meta title='Filters of a shop', about='The filters in a panel from the left and the cart from the right - Escape, the cross or a click beside it closes them.'/}
<div style="width:100%; max-width:560px">
  <h2>Kettles</h2>
  <p>
    {drawer 'shop-filters', title='Filters', button='Filters', side='left'}
      <p><label><input type="checkbox" checked> In stock</label></p>
      <p><label><input type="checkbox"> On sale</label></p>
      <p><label><input type="checkbox"> Free delivery</label></p>
    {/drawer}
    {drawer 'shop-cart', title='Your cart', button='Cart (1)'}
      <p>1 × Aurora electric kettle, <strong>€ 79.00</strong></p>
      <p>Delivery tomorrow, free above € 50.</p>
    {/drawer}
  </p>
  <p>Twelve kettles, from € 29 to € 149.</p>
</div>

<table border=1>
  <tr>
    <td> employee </td>
    <td> manager </td>
    <td> boss </td>
  </tr>
  {select:employees}
    <tr>
      <td> {$lastName}, {$firstName} ({$employeeNumber}) </td>
      {select:managers}
        <td> {$lastName}, {$firstName} ({$employeeNumber}) </td>
        {select:bosses}
          <td> {$lastName}, {$firstName} ({$employeeNumber}) </td>
        {/select:bosses}
      {/select:managers}
    </tr>
  {/select:employees}
</table>

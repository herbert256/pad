{pad:meta title='A form field, three ways', about='Values given in order, by name, or left to the default.'/}
{pad:macro 'macroEntry', label, kind='text', value=''}
  <p><label>{$label} <input type="{$kind}" name="{$label}" value="{$value}"></label></p>
{/pad:macro}

{macro:macroEntry 'E-mail', 'email'/}
{macro:macroEntry label='Name', value='Ada'/}
{macro:macroEntry 'City'/}

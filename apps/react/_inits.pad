<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="csrf-token" content="{csrf token}">
  <meta name="pad-react-version" content="{$reactVersion}">
  <title>{$title}</title>

  <link rel="stylesheet" href="{$padRoot}react/react.css?v={$reactVersion}">

  <!-- React 18 from a CDN, then the runtime of this application - islands, requests back
       to PAD, the theme - and Babel, which turns the JSX of the components into JavaScript
       in the browser: no build step -->
  <script crossorigin src="https://unpkg.com/react@18.3.1/umd/react.development.js"></script>
  <script crossorigin src="https://unpkg.com/react-dom@18.3.1/umd/react-dom.development.js"></script>
  <script src="{$padRoot}react/pad-react.js?v={$reactVersion}"></script>
  <script src="https://unpkg.com/@babel/standalone@7/babel.min.js"></script>
  <script type="text/babel" src="{$padRoot}react/ui.js"></script>
</head>
<body>

<header class="topbar">
  <div class="wrap topbar-inner">

    <a class="brand" href="?index" aria-label="PAD + React home">
      <svg class="brand-atom" viewBox="-12 -12 24 24" aria-hidden="true">
        <circle r="2.1"/>
        <g fill="none" stroke-width="1.1">
          <ellipse rx="10" ry="3.9"/>
          <ellipse rx="10" ry="3.9" transform="rotate(60)"/>
          <ellipse rx="10" ry="3.9" transform="rotate(120)"/>
        </g>
      </svg>
      <span>PAD <em>+</em> React</span>
    </a>

    <nav class="menu" aria-label="Sections">
      {local:nav.json}
        <a href="?{$page}"{if $navSection eq $section} class="is-active" aria-current="page"{/if}>{$label}</a>
      {/local:nav.json}
    </nav>

    <button type="button" class="theme" data-theme-toggle aria-label="Switch between light and dark">
      <svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.5"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg>
    </button>

  </div>
</header>

<main class="wrap main">
@page@
</main>

<footer class="footer">
  <div class="wrap">
    <p><strong>PAD</strong> renders the page and owns the data &middot; <strong>React</strong> makes the islands in it interactive</p>
    <p class="footer-small">React 18 and Babel come from unpkg.com &middot; the components live in <code>www/react/</code>, the pages in <code>apps/react/</code></p>
  </div>
</footer>

</body>
</html>

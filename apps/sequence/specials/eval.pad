{common:table}

{common:demo}{sequence:range '1..15', name='mySeq'/}{/common:demo}

{common:demo}{pull:mySeq}
  {$sequence}
{/pull:mySeq}{/common:demo} 

{common:demo}{pull:mySeq eval='* 10 | - 1'}
  {$sequence}
{/pull:mySeq}{/common:demo} 

{common:demo}{pull:mySeq eval='15 + @'}
  {$sequence}
{/pull:mySeq}{/common:demo} 

{/common:table}

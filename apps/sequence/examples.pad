{format:auto 'list'} 
  (
    'sequences',
    'specials',
    'random',
    'play/single',
    'play/double',
    'keepRemoveFlag'
  )
{/format:auto}

{common:block}

<p>Examples ! Many are generated and do not always make sence, <br>the examples from 'specials' are hand crafted and gives a good view of what the Sequences subsystem of PAD can do.</p>

{/common:block}

<br>
{common:lines}
  {data:list}
    {pad:if $example eq $list}
      <b>{$list}</b>
    @else@
      <a href="?examples&example={$list}{?item}">{$list}</a>
    {/pad:if}
  {property:notLast} | {/property:notLast}
  {/data:list}
{/common:lines}

<br>

{common:block}<center>

  {array:exam} 
    {pad:if $item eq $exam}
      <b>{$exam}</b>
    @else@
      <a href="?examples&example={$example}&item={$exam}">{$exam}</a>
    {/pad:if}
    &nbsp;
  {/array:exam}

  <br><br><hr>

  {pad:if $example eq 'sequences' }
    <h3>{$item}</h3>
      {pad:exists APP . 'basic/{$item}.pad'}
        <h5>{pad:echo 'basic/{$item}.pad'/}</h5>
        {common:example 'basic/{$item}', onlyResult/}
      {/pad:exists}
    {data:list}
      {pad:exists APP . '{$list}/{$item}.pad'}
        <h5>{pad:echo '{$list}/{$item}.pad'/}</h5>
        {common:example '{$list}/{$item}', onlyResult/}
      {/pad:exists}
    {/data:list}
  @else@
    {common:example '{$example}/{$item}', onlyResult, include/}
  {/pad:if}

</center>{/common:block}

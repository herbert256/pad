{pad:search 'pagine', q='viaggi', lang='it'}{$t}; {/pad:search}|
{pad:search 'pagine', q='"con gli amici"', lang='it'}{$t}; {/pad:search}|
{pad:search 'pagine', q='con', lang='it'}{$t}; @else@none{/pad:search}

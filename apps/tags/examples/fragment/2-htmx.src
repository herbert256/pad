{pad:meta title='Swapped by htmx', about='The search field asks this page for the fragment named like its target; htmx swaps the answer in.'/}
<input type="search" name="q" hx-get="?orders" hx-trigger="keyup changed delay:300ms" hx-target="#order-list">
{pad:fragment 'order-list'}
  <ul id="order-list">{array:orders}<li>{$number}: {$customer}</li>{/array:orders}</ul>
{/pad:fragment}

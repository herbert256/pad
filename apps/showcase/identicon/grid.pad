{pad:meta title='A wall of identicons', about='Twenty user ids, twenty patterns - each mirrored left to right, each in a colour of its own.'/}
<div style="display:grid; grid-template-columns:repeat(5, 56px); gap:12px; justify-content:center">
  {sequence:range '1..20', name='id'}{avatar:identicon 'user-' . $id, size=56, title='User ' . $id/}{/sequence:range}
</div>

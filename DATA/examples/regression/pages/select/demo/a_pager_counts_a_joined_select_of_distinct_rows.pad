distinct: [{select:orderSel join="customers on customers.customerNumber = orders.customerNumber", distinct, where="orders.customerNumber = 103", order="orderNumber", page=1, rows=2}{$orderNumber} {/select:orderSel}] ({widget:pager 'orderSel', window=0}{$kind}:{$page} {/widget:pager})
group: [{select:orderSel join="customers on customers.customerNumber = orders.customerNumber", group="orders.status", where="customers.country = 'France'", order="orders.status", page=1, rows=1}{$status} {/select:orderSel}] ({widget:pager 'orderSel', window=0}{$kind}:{$page} {/widget:pager})
parens: [{select:orderSel join="customers on customers.customerNumber = orders.customerNumber", fields="distinct(orders.customerNumber), customers.customerNumber", where="customers.country = 'France'", order="1", page=1, rows=4}{$customerNumber} {/select:orderSel}] ({widget:pager 'orderSel', window=0}{$kind}:{$page} {/widget:pager})

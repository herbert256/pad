{meta title='A gallery', about='Thumbnails that open their picture large over the page, with the pictures before and after it.'/}
{lightbox label='Skies'}
  {tab 'Morning'}<svg viewBox="0 0 400 300" role="img" aria-label="A yellow sky"><rect width="400" height="300" fill="#fbd38d"/><circle cx="200" cy="230" r="60" fill="#f6ad55"/></svg>{/tab}
  {tab 'Noon'}<svg viewBox="0 0 400 300" role="img" aria-label="A blue sky"><rect width="400" height="300" fill="#90cdf4"/><circle cx="200" cy="80" r="40" fill="#fefcbf"/></svg>{/tab}
  {tab 'Night'}<svg viewBox="0 0 400 300" role="img" aria-label="A dark violet sky"><rect width="400" height="300" fill="#553c9a"/><circle cx="300" cy="70" r="25" fill="#e9d8fd"/></svg>{/tab}
{/lightbox}

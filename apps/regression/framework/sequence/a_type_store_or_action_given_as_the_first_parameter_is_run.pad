[{sequence:prime}{$sequence} {/sequence:prime}][{pad:set $t = 'fibonacci'/}{sequence:auto $t, rows=5}{$sequence} {/sequence:auto}]{sequence:range '1..5', push='s'}{/sequence:range}[{sequence:auto 's'}{$sequence} {/sequence:auto}][{action:auto 's', reverse}{$sequence} {/action:auto}][{keep:odd s}{$sequence} {/keep:odd}][{pull:s 'reverse'}{$sequence} {/pull:s}][{sequence:repeat 'prime', rows=2}{$repeat} {/sequence:repeat}][{sequence:sum from=1, to=4}{$sequence}{/sequence:sum}]

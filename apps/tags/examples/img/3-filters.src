{meta title='Filters', about='filter= changes the picture once, as it is made - a list is applied in the order written; halftone writes dots, blurhash a placeholder behind it.'/}
{img 'photos/harbour.jpg', width=240, filter='duotone', colors='#16213e, #f5c26b', alt='The harbour in two colours'/}
{img 'photos/harbour.jpg', width=240, filter='grayscale, dither', alt='The harbour, dithered'/}
{img 'photos/harbour.jpg', width=240, filter='halftone', cell=6, alt='The harbour in dots'/}
{img 'photos/harbour.jpg', width=240, filter='blurhash', alt='The harbour'/}

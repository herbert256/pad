{pad:meta title='A flag tested twice', about='The expression is evaluated once; the flag answers in two places, with an @else@ part.'/}
{pad:set $stock = 3/}
{pad:bool 'boolInStock'}$stock gt 0{/pad:bool}
<p>{bool:boolInStock}In stock.@else@Sold out.{/bool:boolInStock}</p>
<p>{bool:boolInStock}<button>Add to cart</button>@else@<button disabled>Notify me</button>{/bool:boolInStock}</p>

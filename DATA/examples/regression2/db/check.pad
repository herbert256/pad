<h3>check, found</h3>{if $check_1}<p>Jim works here</p>@else@<p>Jim does not work here</p>{/if}<h3>check, not found</h3>{if $check_2}<p>John works here</p>@else@<p>John does not work here</p>{/if}<?php $check_1 = db ("check staff where name = 'jim'"); $check_2 = db ("check staff where name = 'john'");?>
{table}
{demo}[{echo 1 and 0}] [{echo 1 && 1}]{/demo}
{demo}[{echo 1 or 0}] [{echo 0 || 0}]{/demo}
{demo}[{echo 1 xor 1}] [{echo 1 xor 0}]{/demo}
{demo}[{echo not 1}] [{echo !0}]{/demo}
{demo}[{echo not 1 eq 2}]{/demo}
{demo}[{echo 1 eq 1 and not 2 eq 3}]{/demo}
{demo}[{echo 2 gt 1 and 3 gt 2 or 0}]{/demo}
{/table}

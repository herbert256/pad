</section>

  {tagExampleRows}
  {first@tagExampleRows}<section class="block" aria-labelledby="examples"><h2 id="examples">Examples</h2>{/first@tagExampleRows}
    <div class="example" id="example-{$number}">
      <h3>{$title}</h3>
      {if $about}<p class="example-about">{$about}</p>{/if}
      <div class="example-grid{if not $run} is-static{/if}">
        <div class="cell">
          <div class="cell-head"><span>Template</span><span class="cell-file">{$file}</span></div>
          <pre class="code"><code>{!padHtml}</code></pre>
          {if $php}
          <div class="cell-head"><span>PHP</span><span class="cell-file">{$php}</span></div>
          <pre class="code"><code>{!phpHtml}</code></pre>
          {/if}
        </div>
        {if $run}
        <div class="cell">
          <div class="cell-head"><span>Result</span><a class="cell-file" href="?{$page}">open alone</a></div>
          <div class="result">{page $page}</div>
        </div>
        {/if}
      </div>
    </div>
  {last@tagExampleRows}</section>{/last@tagExampleRows}
  {/tagExampleRows}

  {tagSeeRows}
  {first@tagSeeRows}<section class="block" aria-labelledby="see"><h2 id="see">See also</h2><ul class="list">{/first@tagSeeRows}
    <li><a class="name" href="?tag/{$see}">&#123;{$see}&#125;</a> <span class="about">{$about}</span></li>
  {last@tagSeeRows}</ul></section>{/last@tagSeeRows}
  {/tagSeeRows}

  <nav class="prevnext" aria-label="Other tags">
    <a href="?tag/{$tagPrev}">&larr; &#123;{$tagPrev}&#125;</a>
    <a href="?names">All tags A-Z</a>
    <a href="?tag/{$tagNext}">&#123;{$tagNext}&#125; &rarr;</a>
  </nav>

</article>

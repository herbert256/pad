{pad:meta title='Store once, read twice', about='The squares are generated once and pulled as they are and reversed.'/}
{sequence:square rows=6, push='squares'/}
<p>{pad:pull 'squares'}{$sequence} {/pad:pull}</p>
<p>{pad:pull 'squares', reverse}{$sequence} {/pad:pull}</p>
<p>{pull:squares sum}Sum: {$sequence}{/pull:squares}</p>

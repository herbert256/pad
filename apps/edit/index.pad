<div class="editor-page" data-boot="{^editBoot}">

  <section class="work">

    <div class="tabs" id="tabs" role="tablist" aria-label="Open files"></div>

    <div class="center">
      <div class="editor-area">
        <div class="editor-host" id="editorHost"></div>
        <div class="welcome" id="welcome"></div>
        <div class="viewer" id="viewer" hidden></div>
      </div>
      <div class="gutter gutter-x" id="previewGutter" hidden></div>
      <section class="preview" id="preview" aria-label="Preview" hidden>
        <div class="preview-bar">
          <input type="text" id="previewUrl" class="preview-url" aria-label="Previewed address" spellcheck="false">
          <button type="button" class="btn ghost device" id="devicePhone" title="Phone width" aria-label="Phone width"></button>
          <button type="button" class="btn ghost device" id="deviceTablet" title="Tablet width" aria-label="Tablet width"></button>
          <button type="button" class="btn ghost device on" id="deviceDesktop" title="Full width" aria-label="Full width"></button>
          <button type="button" class="btn ghost" id="previewReload" title="Reload" aria-label="Reload"></button>
          <a class="btn ghost" id="previewOpen" href="#" target="_blank" rel="noopener" title="Open in a new tab" aria-label="Open in a new tab"></a>
          <button type="button" class="btn ghost" id="previewClose" title="Close the preview" aria-label="Close the preview"></button>
        </div>
        <div class="preview-stage"><iframe id="previewFrame" title="Preview" sandbox="allow-scripts allow-forms allow-popups allow-modals allow-downloads"></iframe></div>
      </section>
    </div>

    <div class="gutter gutter-y" id="panelGutter" title="Drag to resize, double-click to reset"></div>

    <section class="panel" aria-label="Panel">
      <div class="panel-tabs" role="tablist">
        <button type="button" class="ptab active" id="ptab-problems" role="tab" aria-selected="true">Problems <span class="count" id="problemsCount"></span></button>
        <button type="button" class="ptab" id="ptab-search" role="tab" aria-selected="false">Search</button>
        <button type="button" class="ptab" id="ptab-history" role="tab" aria-selected="false">History</button>
        <button type="button" class="ptab" id="ptab-terminal" role="tab" aria-selected="false">Terminal</button>
        <button type="button" class="ptab" id="ptab-debug" role="tab" aria-selected="false">Debug <span class="dbg-dot" id="dbgDot"></span></button>
        <span class="term-state" id="termState" aria-live="polite"></span>
        <button type="button" class="btn small term-stop" id="termStop" hidden>Stop</button>
        <button type="button" class="btn ghost panel-close" id="panelClose" title="Close the panel" aria-label="Close the panel"></button>
      </div>
      <div class="panel-body" id="panel-problems" role="tabpanel"><div id="problemsList"></div></div>
      <div class="panel-body" id="panel-search" role="tabpanel" hidden>
        <form class="search-form" id="searchForm">
          <input type="search" id="searchInput" placeholder="Search in the application" aria-label="Search" spellcheck="false">
          <label class="toggle" title="Regular expression"><input type="checkbox" id="searchRegex"><span>.*</span></label>
          <label class="toggle" title="Match case"><input type="checkbox" id="searchCase"><span>Aa</span></label>
          <label class="toggle" title="Whole word"><input type="checkbox" id="searchWord"><span>ab</span></label>
          <label class="check-label" title="Search the framework, pad/, as well"><input type="checkbox" id="searchEngine"> pad/ too</label>
          <button type="submit" class="btn primary small">Search</button>
        </form>
        <div id="searchResults"></div>
      </div>
      <div class="panel-body" id="panel-history" role="tabpanel" hidden><div id="historyList"></div></div>
      <div class="panel-body dbg" id="panel-debug" role="tabpanel" hidden></div>
      <div class="panel-body term" id="panel-terminal" role="tabpanel" hidden>
        <div class="term-screen" id="termScreen">
          <div class="term-out" id="termOut" role="log" aria-label="Terminal output"></div>
          <form class="term-line" id="termForm" autocomplete="off">
            <label class="term-prompt" id="termPrompt" for="termInput"></label>
            <input type="text" class="term-input" id="termInput" spellcheck="false" autocapitalize="off" aria-label="Command">
          </form>
        </div>
      </div>
    </section>

  </section>

  <footer class="status" id="status">
    <div class="status-left" id="statusLeft"></div>
    <div class="status-right" id="statusRight"></div>
  </footer>

  <div id="layer"></div>
  <div class="toasts" id="toasts" aria-live="polite"></div>

  {asset 'pad-mode.js', tag}
  {asset 'php-mode.js', tag}
  {asset 'edit.js', tag}

</div>

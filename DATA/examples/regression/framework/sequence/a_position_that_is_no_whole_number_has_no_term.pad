[{sequence:bell from=2.5, rows=2}{$sequence} {/sequence:bell}][{sequence:range '0.5..3.5', make, bell}{$sequence} {/sequence:range}][{sequence:list 'a;2;b', make, mersenne}{$sequence} {/sequence:list}][{sequence:list 'a;3', make, fibonacci}{$sequence} {/sequence:list}][{sequence:list 'a;4', make, catalan}{$sequence} {/sequence:list}][{sequence:list 'a;5', make, oeis=45}{$sequence} {/sequence:list}][{sequence:list 'a;5', make, prime}{$sequence} {/sequence:list}]

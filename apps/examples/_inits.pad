{padOpen}

  <style>
    .example-search input[type=text] { width: 340px; }
    .example-list td { padding: 2px 10px; text-align: left; }
    .example-view { display: flex; flex-wrap: wrap; gap: 16px; align-items: flex-start; justify-content: center; }
    .example-panel { flex: 0 1 auto; min-width: 0; max-width: 100%; border: 1px solid #999; }
    .example-panel h4 { background-color: #dddddd; margin: 0; padding: 6px 10px; border-bottom: 1px solid #999; }
    .example-panel h4 span { font-weight: normal; font-size: smaller; color: #555; }
    .example-body { padding: 10px; overflow-x: auto; text-align: left; }
  </style>

  @page@

{padClose}
{pad:meta title='A preview on a sheet', about='preview keeps the page a page - the content on a sheet - and &padPdf on the address answers the document.'/}
{pad:pdf preview, file='packing-list', size='A5'}
  <h1>Packing list</h1>
  <ul>
    {array:items}
      <li>{$qty} x {$item}</li>
    {/array:items}
  </ul>
{/pad:pdf}

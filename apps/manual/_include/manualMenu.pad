<div class="manual-contents" style="columns: 4 230px; column-gap: 36px">
  {array:manualContents}
    <section style="break-inside: avoid; margin-bottom: 20px">
      <h3 style="margin: 0 0 6px">{$group}</h3>
      <ul>
        {array:topics}
          <li><a href="{$padGo}pages/{$topic}">{$label}</a></li>
        {/array:topics}
      </ul>
    </section>
  {/array:manualContents}
</div>

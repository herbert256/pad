# The fixture of the regression/env application: every form a line of a .env file takes.
# Not a real secret - the application never connects to a database.

ENVTEST_DB_PASSWORD=s3cret-from-the-file

ENVTEST_BARE=plain value   # a comment after a space
ENVTEST_HASH_INSIDE=abc#def
export ENVTEST_EXPORTED=exported
   ENVTEST_INDENTED = spaces around the equals sign
ENVTEST_DOUBLE="one\ttwo \"quoted\" back\\slash \$literal"
ENVTEST_SINGLE='no ${ENVTEST_BARE} and no \n here'
ENVTEST_EXPANDED="${ENVTEST_EXPORTED} and [${ENVTEST_NOT_SET}]"
ENVTEST_EXPANDED_BARE=${ENVTEST_EXPORTED}-bare
ENVTEST_MULTI="first
second"
ENVTEST_TRUE=true
ENVTEST_TRUE_PAREN=(TRUE)
ENVTEST_FALSE=False
ENVTEST_NULL=null
ENVTEST_EMPTY_WORD=(empty)
ENVTEST_EMPTY=
ENVTEST_QUOTED_FALSE="false"
ENVTEST_ZERO=0
ENVTEST_TWICE=first
ENVTEST_TWICE=second
ENVTEST_UNICODE="héllo wörld ✓"

# The real environment wins over this file, and a request header is never the environment.

REQUEST_METHOD=from-the-file
HTTP_HOST=from-the-file

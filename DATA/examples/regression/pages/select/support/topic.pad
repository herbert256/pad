{pad:content 'who'}
  {select:users}
    <p>@content@ by {$username}
  {/select:users}
  on {$created_at | substr (0, 16)}</p>
{/pad:content}

{select:forum_topics $id=1}

  {select:forum_boards}
    <h1>Board: {$name}</h1>
  {/select:forum_boards}

  <h2>Topic: {$title}</h2>

  {content:who}Started{/content:who}

  {select:forum_posts}

    <hr>

    {content:who}Posted{/content:who}

    <p>{$content}</p>
  
  @else@
  
    <p>No posts yet</p>
  
  {/select:forum_posts}

{/select:forum_topics}

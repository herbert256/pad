{common:lines}
  {array:concepts}
    {pad:if &concepts:key NE $concept}
      <a href="?index&go=index&concept={&concepts:key}">{&concepts:key | ucfirst}</a>
    @else@
      <b> {&concepts:key | ucfirst} </b>
    {/pad:if}
    {property:notLast} | {/property:notLast}
  {/array:concepts}
{/common:lines}

<h2>{$conceptTitle}</h2>

{common:block}
  {pad:page 'concepts/{$concept}', include/}
{/common:block}

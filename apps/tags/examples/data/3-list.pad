{pad:meta title='Ranges, lists and a source parameter', about='A range, an evaluated list, and data given as the second parameter instead of content.'/}
{format:auto 'dataLetters'}a..f{/format:auto}
{format:auto 'dataSums'}(1 + 1, 2 * 3, 10 - 7){/format:auto}
{format:auto 'dataSteps', '1..4'/}
<p>{data:dataLetters}{$dataLetters} {/data:dataLetters}</p>
<p>{data:dataSums}{$dataSums} {/data:dataSums}</p>
<p>{data:dataSteps}step {$dataSteps}{property:notLast@dataSteps}, {/property:notLast@dataSteps}{/data:dataSteps}</p>

{pad:meta title='A reaction bar', about='Each emoji from its shortcode - with or without colons - in a span a screen reader names.'/}
<p>
  {array:reactions}
    <span style="display:inline-block;padding:3px 10px;margin:2px;border:1px solid rgba(128,128,128,.35);border-radius:999px">{image:emoji $code/} {$count}</span>
  {/array:reactions}
</p>

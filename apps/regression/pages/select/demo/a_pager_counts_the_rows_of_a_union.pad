alone: [{select:allNames order="name", page=1, rows=3}{$name} {/select:allNames}] ({pad:pager 'allNames', window=0}{$kind}:{$page} {/pad:pager})
first: [{select:staffSel page=1, rows=3}{$name} {/select:staffSel}] ({pad:pager 'staffSel', window=0}{$kind}:{$page} {/pad:pager})
after: [{select:allNames order="name", page=2, rows=3}{$name} {/select:allNames}] ({pad:pager 'allNames', window=0}{$kind}:{$page} {/pad:pager})

{pad:meta title='A total that outlives the loop', about='A set inside a loop sticks; a variable written on the loop tag itself is unwound when the loop ends.'/}
{pad:set $sum = 0, $note = 'before'/}
{sequence:range '1..4', name='num', $note = 'inside'}
  {pad:set $sum = $sum + $num/}
  <p>{$num}: running total {$sum}, note {$note}</p>
{/sequence:range}
<p>After the loop: total {$sum}, note {$note}</p>

{effect:reveal}
  <p>Scroll down a little: this paragraph slides up into place as it comes into view.</p>
{/effect:reveal}
{effect:reveal motion='left'}
  <p>And this one comes in from the right.</p>
{/effect:reveal}
{effect:reveal motion='zoom'}
  <p>This one grows into place.</p>
{/effect:reveal}

{meta title='A macro of the template', about='Its parameters, declared on the macro, are the fields of the body, rendered once for each use - given in their order or by name.'/}
{macro 'card', title, text='No text.'}<p><b>{$title}</b> - {$text}</p>{/macro}
{macro:card title='One', text='The first card.'/}
{card 'Two'/}

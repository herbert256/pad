[{set $t = 'prime'}{keep $t, '1..10'}{$sequence} {/keep}][{keep '1..10', $t}{$sequence} {/keep}][{sequence 'prime', 5}{$sequence} {/sequence}][{sequence 5, 'prime'}{$sequence} {/sequence}][{sequence 'multiply', 3, rows=3}{$sequence} {/sequence}][{sequence '1..5', push='s'/}{sequence 's', 'reverse'}{$sequence} {/sequence}]
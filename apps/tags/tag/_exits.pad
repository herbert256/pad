</section>

{array:tagExampleRows}
  {property:first@tagExampleRows}
    <section class="block" aria-labelledby="examples">
      <h2 id="examples">Examples</h2>
  {/property:first@tagExampleRows}
  <div class="example" id="example-{$number}">
    <h3>{$title}</h3>
    {pad:if $about}
      <p class="example-about">{$about}</p>
    {/pad:if}
    <div class="example-grid{pad:if not $run} is-static{/pad:if}">
      <div class="cell">
        <div class="cell-head"><span>Template</span><span><span class="cell-file">{$file}</span>{pad:if not $run}{!play}{/pad:if}</span></div>
        <pre class="code"><code>{!padHtml}</code></pre>
        {pad:if $php}
          <div class="cell-head"><span>PHP</span><span class="cell-file">{$php}</span></div>
          <pre class="code"><code>{!phpHtml}</code></pre>
        {/pad:if}
      </div>
      {pad:if $run}
        <div class="cell">
          <div class="cell-head"><span>Result</span><span>{pad:if $open}<a class="cell-file" href="{$open}">open alone</a>{/pad:if}{!play}</span></div>
          <div class="result">{pad:if $page}{pad:page $page, app=$app/}{pad:else}{pad:echo $source | code/}{/pad:if}</div>
        </div>
      {/pad:if}
    </div>
  </div>
  {property:last@tagExampleRows}
    </section>
  {/property:last@tagExampleRows}
{/array:tagExampleRows}

{array:tagSeeRows}
  {property:first@tagSeeRows}
    <section class="block" aria-labelledby="see">
      <h2 id="see">See also</h2>
      <ul class="list">
  {/property:first@tagSeeRows}
  <li><a class="name" href="?{$link}">&#123;{$see}&#125;</a> <span class="about">{$about}</span></li>
  {property:last@tagSeeRows}
    </ul>
    </section>
  {/property:last@tagSeeRows}
{/array:tagSeeRows}

<nav class="prevnext" aria-label="Other tags">
  <a href="?{$tagPrevLink}">&larr; {$tagPrevLabel}</a>
  <a href="?names">All tags A-Z</a>
  <a href="?{$tagNextLink}">{$tagNextLabel} &rarr;</a>
</nav>

</article>

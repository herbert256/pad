[{sequence:prime 5, page=2}{$prime} {/sequence:prime}{pad:pager 'prime'}{$kind}:{$page} {/pad:pager}][{sequence:loop 4, page=3}{$sequence} {/sequence:loop}{pad:pager 'sequence'}{$kind}:{$page} {/pad:pager}]{pad:set $n = 10 ** 30/}[{sequence:range '1..5', page=1, rows=$n}{$sequence} {/sequence:range}][{sequence:range '1..5', page=$n, rows=2}{$sequence} {/sequence:range}{pad:pager 'sequence'}{$kind}:{$page} {/pad:pager}]

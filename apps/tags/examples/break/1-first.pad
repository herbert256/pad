{pad:meta title='Stop at the first match', about='The loop stops at the first score above 90; the rest of that pass and the rows after it are dropped.'/}
<ul>
{array:scores}
  {pad:if $points gt 90}<li>{$player} scored {$points} - found one, stop.</li>{pad:break/}{/pad:if}
  <li>{$player}: {$points}</li>
{/array:scores}
</ul>

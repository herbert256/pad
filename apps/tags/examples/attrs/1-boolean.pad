{pad:meta title='Booleans and escaped values', about='disabled is written bare while busy, a false aria value stays the text false, and the quote in the title is escaped.'/}
{pad:set $busy = TRUE/}
{pad:set $help = 'Saves the "draft" now'/}
<button {pad:attrs disabled=$busy, title=$help, aria-expanded='false', data-step=2/}>Save</button>
<button {pad:attrs disabled=FALSE, title=$help/}>Publish</button>
<pre>{pad:attrs disabled=$busy, title=$help, aria-expanded='false', data-step=2/}</pre>

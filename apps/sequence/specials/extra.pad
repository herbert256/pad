{common:table}
{common:demo} {sequence:range '31..40', push='abc'/} {/common:demo}
{common:demo} {pull:abc add=2} {$abc} {$add} | {/pull:abc} {/common:demo}
{/common:table}

{common:table}
{common:demo} {sequence:loop 10, rows=5, add=10, subtract=1} {$loop} {$add} {$subtract} | {/sequence:loop} {/common:demo}
{/common:table}

{common:table}
{common:demo} {sequence:range '1..3',         push='abc'/} {/common:demo}
{common:demo} {pull:abc add=10, subtract=1, push='klm'/} {/common:demo}
{common:demo} {pull:klm multiply=10,         push='xyz'/} {/common:demo}
{common:demo} {pull:xyz} {$abc} {$add} {$subtract} {$klm} {$multiply} {$xyz} | {/pull:xyz} {/common:demo}
{/common:table} 

{common:table}
{common:demo}{sequence:range '11..15', name='q1'/}{/common:demo}
{common:demo}{pull:q1} {$q1} {/pull:q1} {/common:demo}
{common:demo}{pull:q1 randomize} {$randomize} {/pull:q1} {/common:demo}
{common:demo}{pull:q1 randomize, sort} {$sort} {/pull:q1} {/common:demo}
{common:demo}{pull:q1 randomize, sort, reverse} {$reverse} {/pull:q1} {/common:demo}
{/common:table}

{common:table}
{common:demo}{sequence:loop 5, add=10, subtract=1, randomize, sort, reverse, push='abc'/} {/common:demo}
{common:demo}{pull:abc} {$loop} {$add} {$subtract} {$randomize} {$sort} {$reverse} | {/pull:abc} {/common:demo}
{/common:table}

{effect:countup to=1250, prefix='€', suffix='+' | php:preg_replace('#<style[^>]*>(?![.]pad-effect[.]pe-v|[.]pad-effect-wave [.]pe-wave>)[^<]*</style>#', '', @) | php:str_replace('<svg class="pad-effect-css" width="0" height="0" aria-hidden="true" focusable="false"></svg>', '', @)/} {effect:countup 98, suffix='%', scroll | php:preg_replace('#<style[^>]*>(?![.]pad-effect[.]pe-v|[.]pad-effect-wave [.]pe-wave>)[^<]*</style>#', '', @) | php:str_replace('<svg class="pad-effect-css" width="0" height="0" aria-hidden="true" focusable="false"></svg>', '', @)/} {effect:countup from=10, duration=1}-5{/effect:countup | php:preg_replace('#<style[^>]*>(?![.]pad-effect[.]pe-v|[.]pad-effect-wave [.]pe-wave>)[^<]*</style>#', '', @) | php:str_replace('<svg class="pad-effect-css" width="0" height="0" aria-hidden="true" focusable="false"></svg>', '', @)}

{pad:meta title='Ranges and lists', about='A range, a range with a step and an explicit list, each with its own variable name.'/}
<p>{sequence:range '1..10'}{$sequence} {/sequence:range}</p>
<p>{sequence:range '0..50', increment=10, name='tens'}{$tens} {/sequence:range}</p>
<p>{sequence:list 'red;green;blue', name='colour'}{$colour}{pad:if not last@list}, {/pad:if}{/sequence:list}</p>

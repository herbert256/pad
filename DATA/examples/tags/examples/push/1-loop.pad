{pad:meta title='Pushes from a loop', about='Each row pushes a line to a stack printed above the loop; the stack is filled in after the page rendered.'/}
<p>Cities with a delivery today:</p>
<ul>{pad:stack 'pushDelivery'/}</ul>
{array:deliveries}
  {pad:if $today}{pad:push 'pushDelivery'}<li>{$city}</li>{/pad:push}{/pad:if}
{/array:deliveries}

{search 'kitchen', q='"hot oven"'}{$slug} {/search}|
{search 'kitchen', q='"oven hot"'}{$slug} @else@no phrase{/search}|
{search 'kitchen', q='"a slice of bread"'}{$slug} {/search}|
{search 'kitchen', q='brea*'}{$slug} {/search}|
{search 'kitchen', q='bread -cheese'}{$slug} {/search}|
{search 'kitchen', q='bread -"slice of bread"'}{$slug} {/search}|
{search 'kitchen', q='hot "coffee"'}{$slug} {/search}|
{search 'kitchen', q='the and of'}{$slug} @else@only stop words{/search}

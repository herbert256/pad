<div class="login-page">

  <div class="login-box">

    {pad:if $loginSetup eq 1}
      <p class="login-intro">Nobody can log in yet. Make the first user - more can be added in the editor later.</p>
    {pad:else}
      <p class="login-intro">The editor for the PAD applications on this server.</p>
    {/pad:if}

    {pad:if $loginHint eq 1}
      <p class="login-error" role="alert">The first user can only be made from this machine.</p>
    {/pad:if}

    {pad:if $loginError ne ''}
      <p class="login-error" role="alert">{$loginError}</p>
    {/pad:if}

    {pad:form 'login'}
      <p>{pad:input 'name', label='Name', autocomplete='username', required, autofocus/}</p>
      {pad:if $loginSetup eq 1}
        <p>{pad:input 'password', type='password', label='Password', autocomplete='new-password', required, minlength=8/}</p>
        <p>{pad:input 'again', type='password', label='Password again', autocomplete='new-password', required, minlength=8/}</p>
        <p><button type="submit">Make the user and log in</button></p>
      {pad:else}
        <p>{pad:input 'password', type='password', label='Password', autocomplete='current-password', required/}</p>
        <p><button type="submit">Log in</button></p>
      {/pad:if}
    {/pad:form}

  </div>

</div>

{common:padFrame}

  {pad:slot 'head'}
    <meta name="theme-color" content="#0f766e">
    <meta name="csrf-token" content="{pad:csrf token/}">
    <link rel="icon" href="{pad:asset 'icon.svg'/}" type="image/svg+xml">
    {pad:asset 'ledger.css', tag/}
    <script src="{pad:asset 'ledger.js'/}" defer></script>
  {/pad:slot}

  {pad:slot 'tools'}
    <form class="month" method="get">
      <input type="hidden" name="{$ledgerHere}" value="">
      <label for="month-pick" class="sr-only">Month</label>
      <select id="month-pick" name="month" onchange="this.form.submit()">
        {array:monthList}<option value="{$value}"{pad:if $chosen} selected{/pad:if}>{$label}</option>{/array:monthList}
      </select>
      <noscript><button>Show</button></noscript>
    </form>
    <a class="button primary" href="{$padGo}add{?month}">+ Add</a>
  {/pad:slot}

{/common:padFrame}

{pad:flash}<p class="flash {$type}" role="status">{$message}</p>{/pad:flash}

@page@

<footer class="bottom">Ledger runs {$ledgerWhere}.</footer>

{common:padFrameEnd/}

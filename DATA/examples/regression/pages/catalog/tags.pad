action:   {sequence:range '1..4', push='catAct'/}{action:auto catAct, reverse}{$sequence},{/action:auto}
bool:     {pad:bool 'catB'}1{/pad:bool}{bool:catB}yes{/bool:catB}
break:    {format:auto 'catBr'}[1,2,3,4]{/format:auto}{data:catBr}{$catBr},{pad:if $catBr eq 2}{pad:break 'catBr'/}{/pad:if}{/data:catBr}
case:     {pad:case 'blue'}{pad:when 'red'}stop{pad:when 'blue'}go{/pad:case}
cease:    {format:auto 'catCe'}[1,2,3,4]{/format:auto}{data:catCe}{$catCe},{pad:if $catCe eq 2}{pad:cease 'catCe'/}{/pad:if}{/data:catCe}
continue: {format:auto 'catCo'}[1,2,3]{/format:auto}{data:catCo}{pad:if $catCo eq 2}{pad:continue 'catCo'/}{/pad:if}{$catCo},{/data:catCo}
curl:     {pad:curl 'SELF://regression/pages/?pairing&padInclude'/}
decrement: {pad:set $catI = 5/}{pad:decrement $catI/}{$catI}
dir:      {pad:dir '{$catDir}'}{$dir}{property:notLast} {/property:notLast}{/pad:dir}
exists:   {pad:exists 'hello/index.pad'}y{/pad:exists}{pad:exists 'nope.xyz'}n{/pad:exists}
false:    {pad:false}n{/pad:false}.
files:    {pad:files 'hello', base='app', onlyFiles}{$item}.{$ext}{property:notLast} {/property:notLast}{/pad:files}
flag:     {pad:flag prime, rows=6, from=10}{$sequence},{/pad:flag}
foo:      {pad:foo/}
get:      {pad:get 'pairing'/}
ignore:   {pad:ignore}{a} {b}{/pad:ignore}
keep:     {keep:prime rows=4, from=10}{$sequence},{/keep:prime}
make:     {make:fibonacci rows=3}{$sequence},{/make:fibonacci}
null:     {pad:null}n{/pad:null}.
output:   {pad:output 'web'/}.
pull:     {sequence:range '1..3', push='catPu'/}{pad:pull 'catPu'}{$sequence},{/pad:pull}
remove:   {remove:prime rows=6, from=10}{$sequence},{/remove:prime}
resume:   {sequence:range '1..4', push='catRe'/}{pad:resume add=10/}{pull:catRe}{$sequence},{/pull:catRe}
sandbox:  {pad:sandbox}{pad:echo 'in'/}{/pad:sandbox}
tidy:     {pad:tidy}<p ><b >x</b ></p >{/pad:tidy}
until:    {pad:set $catU = 0/}{pad:until $catU eq 3}{pad:increment $catU/}{$catU},{/pad:until}
marker:   @tidy@

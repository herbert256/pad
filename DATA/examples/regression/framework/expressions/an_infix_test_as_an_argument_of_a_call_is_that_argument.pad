{pad:set $n = 3/}{pad:set $s = 'ab'/}[{pad:echo php:var_export($n in (5), 1)/}][{pad:echo php:strval($n in (3))/}][{pad:echo php:max(1, $n + 1 in (4))/}][{pad:echo php:var_export($n not in (5), 1)/}][{pad:echo php:var_export(php:substr($s, 0, 1) like 'a%', 1)/}][{pad:echo php:str_repeat('x', $n in (3) ? 2 : 1)/}][{pad:echo $s | replace('a', $n in (3))/}][{pad:echo php:max(php:min(4, 9), $n range (1, 5))/}][{pad:echo php:max(1, in (3))/}]

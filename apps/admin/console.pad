{pad:if $enabled eq 0}
  <p class="flash warn">The commands are switched off: $adminCommands in _config/config.php.</p>
{/pad:if}

<section class="card">
  <form method="post" action="?console" class="bar">
    <label>Command
      <select name="command">
        {array:commandRows}<option value="{$key}" {pad:if $selected}selected{/pad:if}>{$label}</option>{/array:commandRows}
      </select>
    </label>
    <label>Application
      <select name="app">
        <option value="">-</option>
        {array:appRows}<option value="{$name}" {pad:if $selected}selected{/pad:if}>{$name}</option>{/array:appRows}
      </select>
    </label>
    <label>Page (render) <input type="text" name="page" value="{$pageName}" placeholder="index"></label>
    <button class="primary" {pad:if $enabled eq 0}disabled{/pad:if}>{icon:play size=16/} Run</button>
  </form>
  <p class="dim">The command runs on this server as the web server's user, at most a few minutes. A * marks a command that changes something.</p>
</section>

{pad:if $runError ne ''}
  <p class="flash error">{$runError}</p>
{/pad:if}

{pad:if $ran}
  <section class="card">
    <h2>{icon:terminal size=18/} <code>{$line}</code></h2>
    <p>
      {pad:if $exitCode eq 0}<span class="status-ok">exit 0</span>{pad:else}<span class="status-bad">exit {$exitCode}</span>{/pad:if}
      <span class="dim">- {$ms} ms</span>
    </p>
    <pre class="console wrap">{$output}</pre>
  </section>
{/pad:if}

<section class="card scroll">
  <h2>{icon:clock size=18/} History</h2>
  {pad:if $histCount}
    <table class="list">
      <thead><tr><th>When</th><th>Who</th><th>Command</th><th class="right">Exit</th><th class="right">ms</th></tr></thead>
      <tbody>
        {array:history}
          <tr>
            <td class="nowrap">{$when}</td>
            <td>{$user}</td>
            <td><code>{$line}</code></td>
            <td class="right">{pad:if $code eq 0}<span class="badge ok">0</span>{pad:else}<span class="badge bad">{$code}</span>{/pad:if}</td>
            <td class="right">{$ms}</td>
          </tr>
        {/array:history}
      </tbody>
    </table>
  {pad:else}
    <p class="dim">Nothing has been run from here yet.</p>
  {/pad:if}
</section>

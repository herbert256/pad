<table border=1>
  {local:staff}
    <tr>
      <td> {$name} </td>
      <td> {$phone} </td>
    </tr>
  {/local:staff}
</table>

<hr>

<table border=1>
  {local:staff}
    {pad:if $name eq 'jack'}
      {pad:continue/}
    {/pad:if}
    <tr>
      <td> {$name} </td>
      <td> {$phone} </td>
    </tr>
  {/local:staff}
</table>

<hr>

<table border=1>
  {local:staff}
    {pad:if $name eq 'jack'}
      {pad:continue 'staff'/}
    {/pad:if}
    <tr>
      <td> {$name} </td>
      <td> {$phone} </td>
    </tr>
  {/local:staff}
</table>

<hr>

<table border=1>
  {local:staff}
    {pad:if $name eq 'jack'}
      {pad:continue -2/}
    {/pad:if}
    <tr>
      <td> {$name} </td>
      <td> {$phone} </td>
    </tr>
  {/local:staff}
</table>

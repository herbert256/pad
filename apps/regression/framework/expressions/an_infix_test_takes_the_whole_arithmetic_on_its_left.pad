{set $n = 3}{set $p = 10}{set $q = 3}{set $s = 'ab'}[{if $n + 1 range (9, 9)}T{else}F{/if}][{echo $n + 1 range (4, 4)}][{if $p * $q in (30)}T{else}F{/if}][{if $s . 'c' like 'abc'}T{else}F{/if}][{if -$n in (-3)}T{else}F{/if}][{if $n + 1 not in (4)}T{else}F{/if}][{if upper($s) in ('AB')}T{else}F{/if}][{echo $n | * 2 in (6)}][{if $n eq 3 and $n + 1 in (4)}T{else}F{/if}][{if not $n + 1 in (4)}T{else}F{/if}]

<table border='1'>
  {pad:set $row = 10/}
  {pad:while $row <= 30}
    <tr>
      {pad:set $column = 1/}
      {pad:while $column <= 5}
        <td>{pad:echo $row + $column/}</td>  
        {pad:increment $column/}
      {/pad:while}
    </tr>
    {pad:set $row = $row + 10/}
  {/pad:while}
</table>

{pad:meta title='Other items are attributes', about='Every item the tag does not take itself goes on the input, a bare word as a bare attribute.'/}
{pad:set $busy = FALSE/}
{pad:input 'qty', type='number', label='Quantity', value=1, min=1, max=10, required, disabled=$busy/}
{pad:input 'user[email]', type='email', label='E-mail', placeholder='you@example.org', autocomplete='email'/}

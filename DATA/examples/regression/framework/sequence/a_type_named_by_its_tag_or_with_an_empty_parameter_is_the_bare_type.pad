[{sequence:add rows=3}{$add} {/sequence:add}][{sequence:add rows=3}{$sequence} {/sequence:add}][{pad:set $x = ''/}{sequence:add $x, rows=3}{$sequence} {/sequence:add}][{sequence:range '1..3', multiply=$x}{$sequence} {/sequence:range}][{pad:echo sequence:add(3, '')/}][{sequence:divide rows=3}{$divide} {/sequence:divide}][{sequence:and rows=3}{$and} {/sequence:and}][{keep:multiply from=1, to=3}{$sequence} {/keep:multiply}]

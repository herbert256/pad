{common:table}
{common:demo}{pad:echo 4 | @ * @/}{/common:demo}
{common:demo}{pad:echo 4 | @ + @ * 2/}{/common:demo}
{common:demo}{pad:echo 'pad' | '"' . @ . '"'/}{/common:demo}
{common:demo}{pad:echo 'pad' | @ . ' ' . upper(@)/}{/common:demo}
{common:demo}{pad:echo 5 | @ gt 3 ? 'big' : 'small'/}{/common:demo}
{/common:table}

{meta title='The content is the mail', about='As a pair without template= the rendered content is the HTML part - inside a loop with the fields of the row.'}
{customers}
  {mail to=$email, subject='Your invoice', bcc='archive@example.com'}
    <p>Dear {$name},</p>
    <p>Invoice {$invoice} of {$amount | currency('EUR')} is ready.</p>
  {/mail}
{/customers}

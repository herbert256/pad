{meta title='From a value', about='Without content the second parameter\'s own truth is the flag: blank and 0 are FALSE.'}
{bool 'boolName', 'Ann'}
{bool 'boolZero', 0}
{bool 'boolBlank', ''}
<ul>
  <li>'Ann': {boolName}TRUE@else@FALSE{/boolName}</li>
  <li>0: {boolZero}TRUE@else@FALSE{/boolZero}</li>
  <li>blank: {boolBlank}TRUE@else@FALSE{/boolBlank}</li>
</ul>

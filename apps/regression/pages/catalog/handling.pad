dedup:   {pad:data 'hN'}[1,1,2,2,3]{/pad:data}{data:hN dedup}{$hN},{/data:hN}
reverse: {pad:data 'hR'}[1,2,3]{/pad:data}{data:hR reverse}{$hR},{/data:hR}
shuffle: {pad:data 'hS'}[5]{/pad:data}{data:hS shuffle}{$hS},{/data:hS}
slice:   {pad:data 'hL'}[1,2,3,4,5,6]{/pad:data}{data:hL slice=2}{$hL},{/data:hL}
sort:    {pad:data 'hO'}[3,1,2]{/pad:data}{data:hO sort}{$hO},{/data:hO}
splice:  {pad:data 'hP'}[1,2,3,4,5,6]{/pad:data}{data:hP splice=2}{$hP},{/data:hP}
trim:    {pad:data 'hT'}[1,2,3,4]{/pad:data}{data:hT trim=1}[{$hT}]{/data:hT}

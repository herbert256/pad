<p>action: {$action}</p><p>the boom page behaved as this action promises: <b>{$verdict}</b></p><?php // Fetches the boom page - an undefined variable its .php reads - and asserts what the // 'stop' error action is supposed to do with it: a 500 with nothing in it. $r = padCurl ( $padHost . 'regression_error_stop/?boom&padInclude' ); $code = $r ['result']; $body = $r ['data']; $verdict = ( $code == 500 and trim ( $body ) == "" ) ? "yes" : "NO"; $action = $padErrorAction;?>
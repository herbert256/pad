{pad:meta title='Search results', about='Each result cut to 24 words around the first match of the query, every match marked.'/}
<div>
  <p>Results for <strong>{$q}</strong></p>
  {array:results}
    <article>
      <h3><a href="{$url}">{$title}</a></h3>
      <p>{widget:excerpt $body, words=24, highlight=$q/}</p>
    </article>
  {/array:results}
</div>

{# The four isolation forms of a nested pass, run from a real page: sandbox and clean unset
   what the pass created, plain and reset leave it standing. #}

sandbox: [{pad:code sandbox}{pad:set $zq = 'q'/}{/pad:code}{$zq | optional}]
clean: [{pad:code clean}{pad:set $zc = 'q'/}{/pad:code}{$zc | optional}]
plain: [{pad:code}{pad:set $zp = 'q'/}{/pad:code}{$zp | optional}]
reset: [{pad:code reset}{pad:set $zr = 'q'/}{/pad:code}{$zr | optional}]

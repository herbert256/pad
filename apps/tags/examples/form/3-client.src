{pad:meta title='Checked in the browser too', about='client checks the same rules with the same messages before the form leaves; the server still checks every post.'/}
{pad:form 'signup', client, error}
  {pad:input 'name',  label='Name',   rules='required|max:40'/}
  {pad:input 'email', type='email', label='E-mail', rules='required|email'/}
  {pad:input 'age',   type='number', label='Age', rules='required|integer|min:18'/}
  <button>Sign up</button>
{/pad:form}

{common:padFrame fill}

  {slot 'head'}{asset 'live.css', tag/}{/slot}

  {slot 'tools'}
    <span class="liveTools">
      <button type="submit" form="liveForm" class="liveRun">Run</button>
      <a id="toOther" class="toOther" href="{$padRoot}playground/" title="The same template, data and PHP in the playground, which renders them inside its own request">{icon 'play', size=14/}Open in the playground</a>
    </span>
  {/slot}

{/common:padFrame}

<form method="post" action="?save" target="liveOut" id="liveForm" class="live" data-monaco="{$editorMonaco}" data-names="{^editorNames}">
  <div class="pane">
    <label for="source">Template</label>
    <textarea id="source" name="source" spellcheck="false" rows="14">{$sampleSource}</textarea>
    <div class="dataHead">
      <label for="data" data-mode="data">Data - JSON, YAML, XML or CSV, recognised on sight: each key a variable, a list the variable rows</label>
      <label for="php" data-mode="php" hidden>Data - PHP code, as a page's .php: the variables it sets are the template's</label>
      <button type="button" id="dataSwitch" hidden>Switch to PHP</button>
    </div>
    <input type="hidden" id="mode" name="mode" value="data">
    <textarea id="data" name="data" data-mode="data" spellcheck="false" rows="10" placeholder="No data - the template has only what it sets itself">{$sampleData}</textarea>
    <textarea id="php" name="php" data-mode="php" spellcheck="false" rows="10" placeholder="No PHP - the template has only what it sets itself" hidden>{$samplePhp}</textarea>
    <p class="hint">Ctrl+Enter runs; the address bar always links to what is typed here.</p>
  </div>
  <div class="pane">
    <div class="outHead"><span class="caption">The page</span><a id="liveOpen" href="#" target="_blank" hidden>open alone</a></div>
    <iframe id="liveOut" name="liveOut" title="The page" sandbox="allow-scripts allow-same-origin allow-forms allow-popups allow-modals allow-downloads"></iframe>
  </div>
  <p class="limits">This machine only. Run saves the template with its data or PHP as a page of
  this server, kept a day, and shows it as the server answers it: its PHP runs as written,
  with all of PHP's reach, and the page has what any page has - PHP functions, request values,
  sessions, the database, forms that post back, scripts. It is a page of this site: it is
  not kept apart from this one. Errors show as PAD reports them.</p>
</form>

{if $editorPadMode}<script src="{$editorPadMode}"></script>{/if}
<script src="{asset 'live.js'/}"></script>

{common:padFrameEnd/}

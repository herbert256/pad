/DATA/*
!/DATA/examples/
!/DATA/regression/
!/DATA/reference/
www/DATA
www/wasm/pad-bundle.json
# The thumbnails {img} makes (lib/img.php) - made again from the pictures on the first view.
www/**/_thumbs/
.DS_Store
# A new application's .env stays out of git. The .env files of the PAD home and of the
# repository's own applications are tracked: they hold the logins of the local test
# databases the suites run on, the values _config/config.php held before.
/apps/**/.env
!/apps/_common/.env
!/apps/manual/.env
!/apps/playground/.env
!/apps/react/.env
!/apps/structure/.env
!/apps/regression/*/.env
!/apps/regression/env/_config/.env

# The Vite project of the islands application installs its packages beside it; its build in
# www/islands/build/ is tracked, so the application runs without node. The dev server's
# address file goes with the dev server.
/apps/islands/_frontend/node_modules/
/www/islands/build/hot

{table}
{demo}[{echo 3 eq 3}] [{echo 3 == '3'}] [{echo 3 = 4}]{/demo}
{demo}[{echo 3 ne 4}] [{echo 3 != 4}] [{echo 3 <> 3}]{/demo}
{demo}[{echo 2 lt 10}] [{echo 2 < 10}] [{echo 9 le 9}]{/demo}
{demo}[{echo 5 gt 9}] [{echo 5 >= 5}]{/demo}
{demo}[{echo '2' lt '10'}] [{echo 'apple' lt 'banana'}]{/demo}
{demo}[{echo 'abc' eq 'ABC'}] [{echo 'abc' eq 0}]{/demo}
{/table}

{meta title='Rich fields', about='The input: type - a slider, a row of stars, a day with a month to choose from - named, refilled and checked as an input is.'/}
{form 'trip', method='get'}
  {input:slider 'volume', label='Volume', unit='%'/}
  {input:stars 'score', label='Your rating'/}
  {input:datepicker 'day', label='Day'/}
{/form}

sudoku {game:sudoku '53..7....6..195....98....6.8...6...34..8.3..17...2...6.6....28....419..5....8..79', title='{$t}', paper | php:substr_count(@, 'Q&amp;A Å')/};
chess {notation:chess 'rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1', title='{$t}' | php:substr_count(@, 'Q&amp;A Å')/};
crossword {game:crossword title='{$t}', paper}
  ECHO: Writes a value
  HELLO: The first page
{/game:crossword | php:substr_count(@, 'Q&amp;A Å')};
emoji {pad:emoji 'rocket', label='{$t}' | php:substr_count(@, 'Q&amp;A Å')/};
copy {widget:copy 'abc', label='{$t}' | php:substr_count(@, 'Q&amp;A Å')/};
modal {widget:modal 'fw-esc-once', title='{$t}', button='{$t}'}x{/widget:modal | php:substr_count(@, 'Q&amp;A Å')};
video {pad:video 'https://youtu.be/dQw4w9WgXcQ', title='{$t}' | php:substr_count(@, 'Q&amp;A Å')/};
countdown {pad:countdown '2000-01-01', past='{$t}' | php:substr_count(@, 'Q&amp;A Å')/};
tabs {widget:tabs active='{$t}'}{pad:tab 'B'}b{/pad:tab}{pad:tab '{$t}'}a{/pad:tab}{/widget:tabs | php:substr_count(@, 'Q&amp;A Å')} {widget:tabs active='{$t}'}{pad:tab 'B'}b{/pad:tab}{pad:tab '{$t}'}a{/pad:tab}{/widget:tabs | php:preg_match('/-2-panel. checked/u', @)};
accordion {widget:accordion open='{$t}'}{pad:tab 'B'}b{/pad:tab}{pad:tab '{$t}'}a{/pad:tab}{/widget:accordion | php:preg_match('/open><summary class..pad-accordion-summary.>Q&amp;A Å/u', @)};
carousel {widget:carousel label='{$t}'}{pad:tab '{$t}'}a{/pad:tab}{/widget:carousel | php:substr_count(@, 'Q&amp;A Å')};
poll {widget:poll 'fw-esc-once', title='{$t}', button='{$t}', options='{$t}, B' | php:substr_count(@, 'Q&amp;A Å')/};
img {pad:img 'assets/photo.jpg', width=40, alt='{$t}' | php:substr_count(@, 'Q&amp;A Å')/}

{meta title='The states and provinces of four countries', about='The views of a country\'s regions, each from outlines of its own in the projection that suits it, one value each - keyed by the ISO 3166-2 code with or without the country, or by a name in the country\'s own language.'/}
<div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(250px, 1fr)); gap:16px; align-items:end">
  <figure style="margin:0">{map 'us-states', data='{"TX": 1}', width=250, title='Texas'/}<figcaption><code>us-states</code></figcaption></figure>
  <figure style="margin:0">{map 'au-states', data='{"AU-WA": 1}', width=250, title='Western Australia'/}<figcaption><code>au-states</code></figcaption></figure>
  <figure style="margin:0">{map 'de-states', data='{"Bayern": 1}', width=250, title='Bavaria'/}<figcaption><code>de-states</code></figcaption></figure>
  <figure style="margin:0">{map 'nl-provinces', data='{"Fryslân": 1}', width=250, title='Friesland'/}<figcaption><code>nl-provinces</code></figcaption></figure>
</div>

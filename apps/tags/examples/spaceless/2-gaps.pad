{meta title='No gaps between blocks', about='Inline blocks touch each other once the newlines between them are gone.'}
<div>
  <span style="display:inline-block;padding:4px 10px;background:#2a78d6;color:#fff">one</span>
  <span style="display:inline-block;padding:4px 10px;background:#1baf7a;color:#fff">two</span>
</div>
{spaceless}
<div>
  <span style="display:inline-block;padding:4px 10px;background:#2a78d6;color:#fff">one</span>
  <span style="display:inline-block;padding:4px 10px;background:#1baf7a;color:#fff">two</span>
</div>
{/spaceless}

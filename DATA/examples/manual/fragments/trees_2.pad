{pad:tree 'menu', children='items', sort='title'}
  <p style="margin: 0 0 0 {pad:echo depth@tree | * 20/}px">
    {pad:branch}&#9662;@else@&middot;{/pad:branch}
    {$title} <small>({property:current@tree/} of {property:count@tree/})</small>
  </p>
  {pad:branch}{pad:recurse/}{/pad:branch}
{/pad:tree}

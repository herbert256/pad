<p>
  {pad:if $fruit eq 'banana'}
    {pad:if $color eq 'pink'}
      <b> A pink banana </b>
    @else@
      <b> Not a pink banana </b>
    {/pad:if}
  @else@
    {pad:if $color eq 'green'}
      <b> An {$fruit} is {$color}</b>
    @else@
      <b> Not a green fruit </b>
    {/pad:if}
  {/pad:if}
</p>

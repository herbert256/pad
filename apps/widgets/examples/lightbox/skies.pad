{pad:meta title='Skies of a day', about='A gallery of four pictures - each opens large, with the one before and after it; Escape closes it.'/}
<div style="width:100%; max-width:600px">
  {widget:lightbox label='Skies of a day'}
    {widget:tab 'Dawn'}
      <svg viewBox="0 0 400 300" role="img" aria-label="A pink sky at dawn over the sea">
        <rect width="400" height="300" fill="#fed7e2"/>
        <rect y="200" width="400" height="100" fill="#90cdf4"/>
        <circle cx="200" cy="200" r="36" fill="#fbb6ce"/>
      </svg>
    {/widget:tab}
    {widget:tab 'Noon'}
      <svg viewBox="0 0 400 300" role="img" aria-label="A blue sky with a high sun">
        <rect width="400" height="300" fill="#90cdf4"/>
        <rect y="220" width="400" height="80" fill="#68d391"/>
        <circle cx="200" cy="70" r="34" fill="#fefcbf"/>
      </svg>
    {/widget:tab}
    {widget:tab 'Dusk'}
      <svg viewBox="0 0 400 300" role="img" aria-label="An orange sky at dusk over the hills">
        <rect width="400" height="300" fill="#fbd38d"/>
        <path d="M0 240 Q100 190 200 230 T400 220 V300 H0Z" fill="#9c4221"/>
        <circle cx="280" cy="190" r="30" fill="#ed8936"/>
      </svg>
    {/widget:tab}
    {widget:tab 'Night'}
      <svg viewBox="0 0 400 300" role="img" aria-label="A violet night sky with the moon">
        <rect width="400" height="300" fill="#322659"/>
        <circle cx="300" cy="70" r="26" fill="#e9d8fd"/>
        <circle cx="80" cy="60" r="2" fill="#fff"/>
        <circle cx="150" cy="110" r="2" fill="#fff"/>
        <circle cx="220" cy="40" r="2" fill="#fff"/>
      </svg>
    {/widget:tab}
  {/widget:lightbox}
</div>

; PAD templates - highlights, in the nvim-treesitter capture names (Zed reads the same;
; helix/highlights.scm is this file in Helix's names, written by editors/generate.php).
; The lists of built-in names between the two generated markers are written from pad/ by
; editors/generate.php, like the editors' completion lists: edit pad/, then run it.

(comment) @comment

(construct) @keyword.directive

[
  "{"
  "}"
  "~"
] @punctuation.special

(close_tag
  "/" @punctuation.special)

(variable) @variable

(placeholder) @variable.builtin

(string) @string

(number) @number

(format) @string.special

(operator) @operator

[
  "|"
  "="
] @operator

[
  "("
  ")"
  "["
  "]"
] @punctuation.bracket

[
  ","
  ":"
] @punctuation.delimiter

(prefix) @module

(property) @property

(option_name) @attribute

(tag_name
  target: (identifier) @tag)

(property_reference
  target: (identifier) @tag)

(prefixed_name
  name: (identifier) @function.call)


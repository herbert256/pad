{pad:meta title='Fixed and conditional names', about='panel is always in; active and invalid only when their condition holds - a repeated name is written once.'/}
{pad:set $isActive = TRUE/}
{pad:set $hasErrors = FALSE/}
<div class="{pad:classes 'panel panel-large', active=$isActive, invalid=$hasErrors, 'panel'/}">The panel</div>
<pre>class="{pad:classes 'panel panel-large', active=$isActive, invalid=$hasErrors, 'panel'/}"</pre>

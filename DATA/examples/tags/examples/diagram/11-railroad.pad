{pad:meta title='A railroad diagram', about='Rules in W3C EBNF as syntax diagrams: a choice, an optional part, a repetition, a character class and a rule linked by its name.'/}
{diagram:railroad}
  list   ::= '[' ( item ( ',' item )* )? ']'
  item   ::= number | 'null'
  number ::= '-'? [0-9]+
{/diagram:railroad}

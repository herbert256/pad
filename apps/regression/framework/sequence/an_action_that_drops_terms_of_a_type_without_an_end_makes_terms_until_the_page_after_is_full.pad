[{sequence:golomb dedup, page=2, rows=3}{$sequence} {/sequence:golomb}{pad:pager 'sequence'}{$kind}:{$page} {/pad:pager}]
[{sequence:fibonacci dedup, page=1, rows=3}{$sequence} {/sequence:fibonacci}{pad:pager 'sequence'}{$kind}:{$page} {/pad:pager}]
[{sequence:prime first=3, negative, page=1, rows=3}{$sequence} {/sequence:prime}{pad:pager 'sequence'}{$kind}:{$page} {/pad:pager}]
{sequence:list '2;3;5;7;11;13;17;19', push='s'/}[{sequence:prime onlyNow='s', page=1, rows=3}{$sequence} {/sequence:prime}{pad:pager 'sequence'}{$kind}:{$page} {/pad:pager}]
[{sequence:digitSum dedup, page=2, rows=5}{$sequence} {/sequence:digitSum}]
[{sequence:golomb from=5, dedup, page=2, rows=3}{$sequence}:{$dedup} {/sequence:golomb}]
[{sequence:kolakoski dedup, page=1, rows=3}{$sequence} {/sequence:kolakoski}{pad:pager 'sequence'}{$kind}:{$page} {/pad:pager}]
{sequence:list '2;3;5;7', push='t'/}[{sequence:prime intersection='t', page=1, rows=3}{$sequence} {/sequence:prime}{pad:pager 'sequence'}{$kind}:{$page} {/pad:pager}]
{sequence:list '100;200', push='u'/}[{sequence:prime dedup='u', page=3, rows=3}{$sequence} {/sequence:prime}]
{sequence:prime rows=100, push='v'/}[{sequence:prime onlyNow='v', page=1, rows=3}{$sequence} {/sequence:prime}]

<table>
  <tr>
    <th>Album</th>
    <th class="n">#</th>
    <th>Track</th>
  </tr>
  {select:tracks rows=6, page=$pg ?? 1}
    <tr>
      <td>{select:albums}{$title}{/select:albums}</td>
      <td class="n">{$track_no}</td>
      <td>{$title}</td>
    </tr>
  {/select:tracks}
</table>

{widget:pager 'tracks'/}

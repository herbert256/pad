{pad:meta title='A form in a region', about='pad-submit posts the form\'s fields with the event; the answer replaces the region.'/}
{pad:live 'liveGreet'}
  <form pad-submit="greet">
    <label>Name <input name="visitor" value="{$visitor}"></label>
    <button>Greet</button>
  </form>
  {pad:if $visitor ne ''}
    <p>Hello, {$visitor}!</p>
  {/pad:if}
{/pad:live}

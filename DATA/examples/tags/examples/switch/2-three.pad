{pad:meta title='A longer rotation, shared', about='Three values cycle; a second switch written alike continues the same rotation.'/}
<p>{sequence:loop 4}{pad:switch 'red', 'green', 'blue'/} {/sequence:loop}</p>
<p>{sequence:loop 4}{pad:switch 'red', 'green', 'blue'/} {/sequence:loop}</p>
<p>{sequence:loop 4}{pad:switch 'red','green','blue'/} {/sequence:loop}</p>

[{sequence 'golomb', dedup, page=2, rows=3}{$sequence} {/sequence}{pager 'sequence'}{$kind}:{$page} {/pager}]
[{sequence fibonacci, dedup, page=1, rows=3}{$sequence} {/sequence}{pager 'sequence'}{$kind}:{$page} {/pager}]
[{sequence 'prime', first=3, negative, page=1, rows=3}{$sequence} {/sequence}{pager 'sequence'}{$kind}:{$page} {/pager}]
{sequence '2;3;5;7;11;13;17;19', push='s'/}[{sequence 'prime', onlyNow='s', page=1, rows=3}{$sequence} {/sequence}{pager 'sequence'}{$kind}:{$page} {/pager}]

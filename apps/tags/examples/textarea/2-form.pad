{meta title='In a form', about='Inside a {form} the text area refills from what that form sent; other items are attributes.'}
{form 'feedback', method='get'}
  {input 'subject', label='Subject', value='Hello'}
  {textarea 'body', label='Your message', rows=5, maxlength=500, placeholder='Write here', required}
  <button>Send</button>
{/form}

{common:table}

{common:demo}{sequence:loop 25, push='mySequence'/} {/common:demo}

{common:demo}{pad:pull mySequence, make,   repeat=4} {$sequence} {/pad:pull}{/common:demo}

{common:demo}{pad:pull mySequence, keep,   repeat=4} {$sequence} {/pad:pull}{/common:demo}

{common:demo}{pad:pull mySequence, remove, repeat=4} {$sequence} {/pad:pull}{/common:demo}

{common:demo}{pad:pull mySequence, flag,   repeat=4} {$sequence} {/pad:pull}{/common:demo}

{/common:table}

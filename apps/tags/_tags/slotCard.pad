<div style="border:1px solid #ccc; border-radius:6px; padding:.5em 1em; margin:.5em 0">
  <h4 style="margin:.2em 0">{pad:slot 'title'}Untitled{/pad:slot}</h4>
  @content@
  {pad:slot 'footer'}<footer style="border-top:1px solid #ccc; margin-top:.5em"><small>@content@</small></footer>{/pad:slot}
</div>

{pad:meta title='Counting matches', about='A counter that did not exist starts at 1 and keeps its value after the loop.'/}
{sequence:range '1..20', name='number'}
  {pad:if $number % 3 eq 0}{pad:increment $threes/}{/pad:if}
{/sequence:range}
<p>Between 1 and 20, {$threes} numbers are divisible by 3.</p>

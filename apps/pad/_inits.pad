{common:padFrame}
  {pad:slot 'head'}{pad:asset 'home.css', tag/}{/pad:slot}
  {pad:slot 'side'}
    <nav class="frame-nav home-apps" aria-label="Applications">
      {array:homeMenu}
        <div class="frame-head">{$head}</div>
        {array:homeApps}<a href="{$href}"{pad:if $current} aria-current="page"{/pad:if}>{icon:$icon size=16/}<span><b>{$name}</b><small>{$about}</small></span></a>{/array:homeApps}
      {/array:homeMenu}
    </nav>
  {/pad:slot}
{/common:padFrame}
@page@
{common:padFrameEnd/}

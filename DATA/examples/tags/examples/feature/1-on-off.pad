{pad:meta title='A flag on and a flag off', about='TRUE and FALSE in $padFeatures switch a part for everybody - normally set in _config/config.php.'/}
{pad:feature 'newSearch'}
  <p>The new search, with suggestions.</p>
{pad:else}
  <p>The old search.</p>
{/pad:feature}
{pad:feature 'darkMode'}
  <p>Dark mode is on.</p>
@else@
  <p>Dark mode is not released yet.</p>
{/pad:feature}

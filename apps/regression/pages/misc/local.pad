{pad:content 'myContent'}

  <h3>{&departments:option:data}</h3>

  <table border=1>

    <tr>
      <th> department </th>
      <th> manager </th>
      <th> phone </th>
    </tr>

    @start@
      <tr>
        <td> {$department} </td>
        <td> {$manager} </td>
        <td> {$phone} </td>
      </tr>
    @end@

  </table>

{/pad:content}

{pad:pad data='departments/departments',      content='myContent'/}
{pad:pad data='departments/departments.php',  content='myContent'/}
{pad:pad data='departments/departments.csv',  content='myContent'/}
{pad:pad data='departments/departments.xml',  content='myContent'/}
{pad:pad data='departments/departments.json', content='myContent'/}
{pad:pad data='departments/departments.yaml', content='myContent'/}

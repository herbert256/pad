{pad:meta title='Types by name'/}
<h1>Types by name</h1>
<p class="lead">All {$typesCount} tag types and kind families from A to Z.</p>

<ul class="list">
  {array:types}
  <li><a class="name" href="?{$link}">{$key}</a> <span class="about">{$about} <a class="meta" href="?groups#{$group}">{$groupLabel}</a></span></li>
  {/array:types}
</ul>

{common:table}
{common:demo}{pad:echo 'abcdef' | left(2)/}{/common:demo}
{common:demo}{pad:echo left('abcdef', 2)/}{/common:demo}
{common:demo}{pad:echo 'Hello ' . upper('world')/}{/common:demo}
{common:demo}{pad:echo upper(left('abcdef', 3))/}{/common:demo}
{common:demo}{pad:echo 'a-b' | replace('-', upper(' and '))/}{/common:demo}
{common:demo}{pad:if left('NL1234', 2) eq 'NL'}Dutch{/pad:if}{/common:demo}
{/common:table}

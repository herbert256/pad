{pad:data 'rows'}[{"t":""}]{/pad:data}
{data:rows}
[{notation:morse $t, plain}@else@-{/notation:morse}]
[{notation:math $t, display='block'}@else@-{/notation:math}]
[{notation:signals $t, size=20}@else@-{/notation:signals}]
[{notation:piano $t, size=60}@else@-{/notation:piano}]
[{notation:chord $t, size=80}@else@-{/notation:chord}]
[{notation:go $t, numbers}@else@-{/notation:go}]
[{notation:abc $t, width=300}@else@-{/notation:abc}]
[{notation:draughts $t, board=8}@else@-{/notation:draughts}]
[{notation:chess $t, size=100}@else@-{/notation:chess}]
[{notation:braille $t, cells}@else@-{/notation:braille}]
{/data:rows}

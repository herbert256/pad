{pad:meta title='An action over a store', about='Reverse, the first two and the sum of a stored list - the store keeps its order.'/}
{sequence:range '1..6', push='six'/}
<p>reverse: {action:auto six, reverse}{$sequence} {/action:auto}</p>
<p>first=2: {action:auto six, first=2}{$sequence} {/action:auto}</p>
<p>sum:     {action:sum six}{$sum}{/action:sum}</p>
<p>store:   {pad:pull six}{$sequence} {/pad:pull}</p>

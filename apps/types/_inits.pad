{common:padFrame}
  {pad:slot 'head'}
    {pad:asset 'types.css', tag/}
  {/pad:slot}

  {pad:slot 'title'}
    <form class="search" action="" method="get" role="search">
      <input type="hidden" name="search" value="">
      <label class="sr-only" for="q">Search types</label>
      <input type="search" id="q" name="q" value="{$typesSearch}" placeholder="Search {$typesCount} types" autocomplete="off">
    </form>
  {/pad:slot}
{/common:padFrame}

@page@

<footer class="foot">
  <p>{$typesCount} core tag types, with their syntax, descriptions and examples. Subsystems have their own <a href="{$padRoot}subsystems/">application</a>. Individual tags are in the <a href="{$padRoot}tags/">tags application</a>.</p>
</footer>

{common:padFrameEnd/}

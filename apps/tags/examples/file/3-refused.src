{meta title='Names that are refused', about='A name the web server would run or read as configuration is a PAD error, and nothing is written.'}
{file dir='uploads', name='shell', ext='php'}...{/file}        {# .php - refused #}
{file dir='uploads', name='.htaccess', ext='txt'}...{/file}    {# a part starting with a dot - refused #}

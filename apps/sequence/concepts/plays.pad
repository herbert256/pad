A play is a sequence, but not used to build a list, it is used to exucute on a sequence list.
<p>
  There are 4 play operators
  <table border=1>
    {array:play}
      <tr>
        <td> {&play:key} </td>
        <td> {$play}     </td>
      </tr>
    {/array:play}
  </table>

  {common:block}
    {common:table}
      {common:demo}{sequence:range '20..30', push='mySequence'/} {/common:demo}

      {common:demo}{pad:pull mySequence, make,   prime} {$sequence} {/pad:pull}{/common:demo}

      {common:demo}{pad:pull mySequence, keep,   prime} {$sequence} {/pad:pull}{/common:demo}

      {common:demo}{pad:pull mySequence, remove, prime} {$sequence} {/pad:pull}{/common:demo}

      {common:demo}{pad:pull mySequence, flag,   prime} {$sequence} {/pad:pull}{/common:demo}
    {/common:table}
  {/common:block}

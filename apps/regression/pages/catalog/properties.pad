current:  {format:auto 'cXs'}[7,8]{/format:auto}{data:cXs}{property:current@cXs/},{/data:cXs}
done:     {data:cXs}{property:done@cXs/},{/data:cXs}
key:      {data:cXs}{property:key@cXs/},{/data:cXs}
remaining: {data:cXs}{property:remaining@cXs/},{/data:cXs}
count:    {data:cXs}{property:count@cXs/},{/data:cXs}
nameProp: {data:cXs}{property:name@cXs/},{/data:cXs}
first:    {data:cXs}{property:first@cXs}[{/property:first@cXs}{$cXs},{/data:cXs}
last:     {data:cXs}{$cXs},{property:last@cXs}]{/property:last@cXs}{/data:cXs}
notFirst: {data:cXs}{property:notFirst@cXs}-{/property:notFirst@cXs}{$cXs}{/data:cXs}
notLast:  {data:cXs}{$cXs}{property:notLast@cXs},{/property:notLast@cXs}{/data:cXs}
even:     {data:cXs}{property:even@cXs}E{/property:even@cXs}{/data:cXs}
odd:      {data:cXs}{property:odd@cXs}O{/property:odd@cXs}{/data:cXs}
border:   {data:cXs}{property:border@cXs}|{/property:border@cXs}{$cXs}{/data:cXs}
middle:   {format:auto 'cYs'}[1,2,3]{/format:auto}{data:cYs}{property:middle@cYs}M{/property:middle@cYs}{/data:cYs}
fields:   {format:auto 'cU'}[{"a":1,"b":2}]{/format:auto}{data:cU}{property:fields@cU}{$name}={$value},{/property:fields@cU}{/data:cU}
firstFieldName:  {data:cU}{property:firstFieldName@cU/},{/data:cU}
firstFieldValue: {data:cU}{property:firstFieldValue@cU/},{/data:cU}
keys:     {format:auto 'cKv' ignore}{"a":1,"b":2}{/format:auto}{data:cKv}{property:first@cKv}{property:keys@cKv}[{$name}]{/property:keys@cKv}{/property:first@cKv}{/data:cKv}
parameter: {pad:true 'p1', 'p2'}{property:parameter.1@true/}/{pad:echo $parameter.2@true/}{/pad:true}
variable:  {pad:true $t='9'}{property:variable.t@true/}/{pad:echo $variable.t@true/}{/pad:true}
option:    {pad:true opt='v'}{pad:echo $option.opt@true/}{/pad:true}
any:       {pad:true $cAny='9'}{pad:echo $cAny@any/}{/pad:true}
options:   {pad:true opt='w'}{pad:echo $opt@options/}{/pad:true}
parameters: {pad:true 'q1', 'q2'}{pad:echo $2@parameters/}{/pad:true}
saved:     {format:auto 'cSv'}["x"]{/format:auto}{data:cSv %catSaved='inner'}{$catSaved}/{pad:echo $catSaved@saved/}{/data:cSv}
variables: {pad:true $cV='n'}{pad:echo $cV@variables/}{/pad:true}
all:       {pad:echo $catAll@all/}
sequences: {sequence:range '1..5', push='cSeq'/}{pad:echo $cSeq.3@sequences/}
tags:      {pad:true $cT='7'}{pad:echo $cT@tags/}{/pad:true}
level:     {format:auto 'cLv'}["x","y"]{/format:auto}{data:cLv}{pad:echo $0.cLv@level/}{pad:echo $1.cLv@level/},{/data:cLv}
dataAt:    {format:auto 'cAd'}{"cKey":9}{/format:auto}{pad:echo $cKey.cAd@data/}
function:  {format:auto 'cFn'}[1,2]{/format:auto}{data:cFn callback='catsum.php', before}{property:last@cFn}{pad:echo $t@function/}{/property:last@cFn}{/data:cFn}
dataProp:  {data:cLv}{property:first@cLv}[{property:data@cLv}{$cLv},{/property:data@cLv}]{/property:first@cLv}{/data:cLv}
condition: {data:cLv}{pad:if first@cLv}F{/pad:if}{$cLv}{pad:if notLast@cLv}-{/pad:if}{/data:cLv}

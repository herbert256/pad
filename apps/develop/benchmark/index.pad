<p>{$benchShown} of {$benchCount} pages answered with their timings, in ms.</p>

<table border=1>

  <tr>
    <td>page</td>
    <td align="right">curl</td>
    <td align="right">total</td>
    <td align="right">boot</td>
    <td align="right">engine</td>
    <td align="right">app</td>
  </tr>

  {list}
    <tr>
      <td>{$page}</td>
      <td align="right">{$curl}</td>
      <td align="right">{$total}</td>
      <td align="right">{$boot}</td>
      <td align="right">{$engine}</td>
      <td align="right">{$app}</td>
    </tr>
  {/list}

</table>

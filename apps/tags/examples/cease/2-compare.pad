{pad:meta title='cease, break and continue', about='The same loop with each of the three: what happens to the rest of the pass and to the rows after it.'/}
<p>cease: {sequence:range '1..5', name='ceaseN'}[{$ceaseN}{pad:if $ceaseN eq 3}{pad:cease/}{/pad:if}.]{/sequence:range}</p>
<p>break: {sequence:range '1..5', name='breakN'}[{$breakN}{pad:if $breakN eq 3}{pad:break/}{/pad:if}.]{/sequence:range}</p>
<p>continue: {sequence:range '1..5', name='contN'}[{$contN}{pad:if $contN eq 3}{pad:continue/}{/pad:if}.]{/sequence:range}</p>

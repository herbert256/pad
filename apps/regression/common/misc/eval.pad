{common:table}

{common:demo pre}{pad:echo 50 * 4 * 2/}
{pad:echo 50 | * 4 | * 2/}
{pad:echo 50 | @ * 4 | @ * 2/}
{/common:demo}

{common:demo pre}{pad:echo 50 | '"' . /}
{pad:echo 50 | . '"' /}
{pad:echo 50 | '"' . @ . '"' /}
{pad:echo 50 | '"' . $$ . '"' /}
{/common:demo}

{common:demo pre}{pad:echo 50 | '"' . '"' /}
{pad:echo 50 | '"' . . '"' /}
{pad:echo 50 | . @ . /}
{pad:echo 50 | . /}
{pad:echo 50 | . . /}
{/common:demo}

{common:demo}{pad:set $abc = 50/}{/common:demo}

{common:demo pre}{$abc | * 4}
{$abc | 4 * 4}
{$abc | * / 4}
{$abc | * 4 / 2 + 10 }
{$abc | * 4 | / 2 | + 10 }
{/common:demo}

{common:demo}{pad:set $abc = 'abc'/}{/common:demo}

{common:demo pre}{$abc | crc32 }
{$abc | pad:substr (1, 1) }
{$abc | php:substr (@, 1, 1) }
{/common:demo}

{common:demo}{pad:set $line = 'a <test> LiNe'/}{/common:demo}

{common:demo pre}{$line} 
{!line} 
{$line | capitalize} 
{$line | upper} 
{$line | lower} 
{$line | url} 
{/common:demo}

{common:demo}{pad:set $nbr = 12345.678/}{/common:demo}

{common:demo pre}{$nbr | %.2f} 
{$nbr | %.5f} 
{$nbr | %'.09d} 
{$nbr | %d} 
{$nbr | %e} 
{$nbr | %f} 
{$nbr | %g} 
{$nbr | %o} 
{/common:demo}

{/common:table}

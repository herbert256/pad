{pad:meta title='Tags by name'/}
<h1>Tags by name</h1>
<p class="lead">All {$tagsCount} tags and subsystem kinds from A to Z, by their name after the type prefix.</p>

<nav class="jump" aria-label="Letters">{array:letters}<a href="#letter-{$letter}">{$letter}</a>{/array:letters}</nav>

{array:letters}
<section class="section" id="letter-{$letter}">
  <div class="section-head"><h2>{$letter}</h2><span>{$count} {pad:echo $count eq 1 ? 'entry' : 'entries'/}</span></div>
  <ul class="list">
    {array:tags}
    <li><a class="name" href="?{$link}">{$label}</a> <span class="about">{$about} <a class="meta" href="?groups#{$group}">{$groupLabel}</a></span></li>
    {/array:tags}
  </ul>
</section>
{/array:letters}

{pad:meta title='A search form', about='A form sent by GET carries no token and no name field - its fields refill from the query string.'/}
{pad:form 'search', method='get', class='search', role='search'}
  {pad:input 'q', type='search', label='Find a tag', placeholder='if, form, chart ...'/}
  {pad:input 'go', type='submit', value='Search'/}
{/pad:form}

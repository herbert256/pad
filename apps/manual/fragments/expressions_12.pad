{format:auto 'colors'}["red", "green", "blue"]{/format:auto}
{pad:set $nums = [4, 8, 15]/}
{pad:set $title = 'Prefixes'/}
<p>{pad:echo constant:PHP_INT_SIZE/}</p>
<p>{pad:echo php:count(data:colors)/}</p>
<p>{pad:echo php:count(array:nums)/} numbers, together {pad:echo array:nums + 0/}</p>
<p>{pad:echo php:str_repeat('=', 5)/}</p>
<p>{pad:echo field:title | upper/}</p>

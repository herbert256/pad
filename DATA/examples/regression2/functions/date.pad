{# this page prints the clock, so its answer is different every second - the crawl reads the word random here and stops comparing it. The pages suite asserts its shape instead. #} {echo date}<br>{echo 772345654 | date }<br>{echo date ('Y-m-d H:i:s')}<br>{echo 772345654 | date ('Y-m-d H:i:s')}<br>{echo date ('Y-m-d', 'tomorrow')}<br>{echo date ('Y-m-d', 'yesterday')}<br>
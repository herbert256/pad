{block}

  <p>
    The tests whose source names <b>{$item}</b> - {$casesCount} of them, from the last run of
    each suite: sandbox cases rendered inside a request, and pages tests fetched over HTTP.
    Every one states the output the engine is supposed to produce; the
    <a href="{$padHost}regression/">regression application</a> is where they run.
  </p>

  <table border="1" cellpadding="4" cellspacing="0" align="center">
    <tr><th>group</th><th>case</th><th>template</th><th>expected</th><th>status</th></tr>
    {caseRows}
      <tr>
        <td><a href="{$padHost}{$link}">{$suite}</a> / {$group}</td>
        <td>{$name}</td>
        <td>{!code}</td>
        <td><code>{!want}</code></td>
        <td>{$status}</td>
      </tr>
    {/caseRows}
  </table>

{/block}

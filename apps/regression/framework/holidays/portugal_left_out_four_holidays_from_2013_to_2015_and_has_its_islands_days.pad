{holidays 'pt', year=2026}{$date} {$local} {$type}|{/holidays}
{holidays 'pt', year=2014, where='$type eq "public"'}{$date} {$name}|{/holidays}
{holidays 'pt-30', from='2024-01-01', to='2025-12-31', where='$region'}{$date} {$name}|{/holidays}
{holidays 'pt-20', year=2026, where='$region'}{$date} {$local}|{/holidays}

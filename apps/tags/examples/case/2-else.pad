{pad:meta title='The else branch', about='{pad:else} renders when no {pad:when} matched - here inside a loop, once per row.'/}
<ul>
  {sequence:range '1..5', name='day'}
    <li>
      Day {$day}:
      {pad:case $day}
      {pad:when 1}
        Monday
      {pad:when 2}
        Tuesday
      {pad:when 3}
        Wednesday
      {pad:else}
        later in the week
      {/pad:case}
    </li>
  {/sequence:range}
</ul>

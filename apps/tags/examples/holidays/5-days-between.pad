{pad:meta title='A substitute day and a day between', about='Japan makes up for a holiday on a Sunday on the next free day and holds a day between two holidays as one too.'/}
<ul>
  {pad:holidays 'jp', from='2026-05-01', to='2026-09-30'}
    <li>{$date} {$name} - <i>{$local}</i></li>
  {/pad:holidays}
</ul>

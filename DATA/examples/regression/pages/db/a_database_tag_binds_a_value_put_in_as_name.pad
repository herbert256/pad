field:  [{pad:field "phone from staff where name = $who"/}]
array:  [{pad:array "name from staff where name in ($names) order by name"}{$name} {/pad:array}]
check:  [{pad:check "staff where name = $who"}yes@else@no{/pad:check}]
record: [{pad:record "name, phone from staff where name = $who"}{$name} {$phone}{/pad:record}]
odd:    [{pad:field "concat($odd, '|')"/}]
quoted: [{pad:field "count(*) from staff where name = '$who'"/}]
loop:   [{pad:array "name from staff where salary > 2000 order by name"}{$name} {pad:field "phone from staff where name = $name"/} {/pad:array}]

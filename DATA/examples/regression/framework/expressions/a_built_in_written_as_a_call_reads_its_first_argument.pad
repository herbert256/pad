{pad:set $s = 'hello'/}[{pad:echo trim('  a  ')/}][{pad:echo upper($s)/}][{pad:echo left($s, 2)/}][{pad:if upper($s) eq 'HELLO'}T{pad:else}F{/pad:if}][{pad:echo 'x' . upper($s)/}][{pad:echo date('Y', 0)/}][{pad:echo $s | replace('l', upper('x'))/}][{pad:echo substr($s, 0, 3)/}][{pad:echo $s | left(2)/}][{$s | left(3)}]

{common:table}

{common:demo}{sequence:range '11..14', push='one'/}{/common:demo}

{common:demo}{sequence:range '5..2',   push='two'/}{/common:demo}

{common:demo}{sequence:auto one}
  {$sequence}
{/sequence:auto}{/common:demo}

{common:demo}{sequence:auto two}
  {$sequence}
{/sequence:auto}{/common:demo}

{common:demo}{sequence:auto one, subtract='two'}
  {$sequence}
{/sequence:auto}{/common:demo}

{/common:table}

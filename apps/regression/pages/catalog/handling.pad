dedup:   {format:auto 'hN'}[1,1,2,2,3]{/format:auto}{data:hN dedup}{$hN},{/data:hN}
reverse: {format:auto 'hR'}[1,2,3]{/format:auto}{data:hR reverse}{$hR},{/data:hR}
shuffle: {format:auto 'hS'}[5]{/format:auto}{data:hS shuffle}{$hS},{/data:hS}
slice:   {format:auto 'hL'}[1,2,3,4,5,6]{/format:auto}{data:hL slice=2}{$hL},{/data:hL}
sort:    {format:auto 'hO'}[3,1,2]{/format:auto}{data:hO sort}{$hO},{/data:hO}
splice:  {format:auto 'hP'}[1,2,3,4,5,6]{/format:auto}{data:hP splice=2}{$hP},{/data:hP}
trim:    {format:auto 'hT'}[1,2,3,4]{/format:auto}{data:hT trim=1}[{$hT}]{/data:hT}

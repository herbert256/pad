{content 'c'}yes{else}no{/content}{content 'w'}{when 1}one{when 3}three{else}other{/content}{content 'e'}Y@else@N{/content}1[{if $x eq 3, content='c'}<b>@content@</b>{/if}] 2[{if $x eq 2, content='c'}<b>@content@</b>{/if}] 3[{case $x, content='w'}<i>@content@</i>{/case}] 4[{case 7, content='w'}<i>@content@</i>{/case}] 5[{if $x eq 3, content='e'}<b>@content@</b>{/if}] 6[{if $x eq 2, content='e'}<b>@content@</b>{/if}]

[{sequence 'golomb', dedup, page=2, rows=3}{$sequence} {/sequence}{pager 'sequence'}{$kind}:{$page} {/pager}]
[{sequence fibonacci, dedup, page=1, rows=3}{$sequence} {/sequence}{pager 'sequence'}{$kind}:{$page} {/pager}]
[{sequence 'prime', first=3, negative, page=1, rows=3}{$sequence} {/sequence}{pager 'sequence'}{$kind}:{$page} {/pager}]
{sequence '2;3;5;7;11;13;17;19', push='s'/}[{sequence 'prime', onlyNow='s', page=1, rows=3}{$sequence} {/sequence}{pager 'sequence'}{$kind}:{$page} {/pager}]
[{sequence 'digitSum', dedup, page=2, rows=5}{$sequence} {/sequence}]
[{sequence 'golomb', from=5, dedup, page=2, rows=3}{$sequence}:{$dedup} {/sequence}]
[{sequence 'kolakoski', dedup, page=1, rows=3}{$sequence} {/sequence}{pager 'sequence'}{$kind}:{$page} {/pager}]
{sequence '2;3;5;7', push='t'/}[{sequence 'prime', intersection='t', page=1, rows=3}{$sequence} {/sequence}{pager 'sequence'}{$kind}:{$page} {/pager}]
{sequence '100;200', push='u'/}[{sequence 'prime', dedup='u', page=3, rows=3}{$sequence} {/sequence}]
{sequence 'prime', rows=100, push='v'/}[{sequence 'prime', onlyNow='v', page=1, rows=3}{$sequence} {/sequence}]

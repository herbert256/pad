[{local:plan}{$title} {$start} {array:stops}{$name}={$hours};{/array:stops}{/local:plan}]
[{local:settings}{$name} {$database.host}:{$database.port} {$mail.from}{/local:settings}]
[{local:contacts}{$name} {$email} {$org}|{/local:contacts}]
[{local:agenda}{$summary} {$start} {$end}|{/local:agenda}]
[{local:ride}{$type} {$name}{$track} {$lat},{$lon} {$ele}|{/local:ride}]
[{local:places}{$name} {$lat},{$lon}|{/local:places}]
[{local:visits}{$page}={$hits};{/local:visits}]
[{local:scores}{$player}={$points};{/local:scores}]
[{local:stock}{$item}={$count};{/local:stock}]
[{local:sales}{$region}|{$sold}|{$day}|{$paid}|{$total}|{$F};{/local:sales}]
[{local:plan.toml}{$title}{/local:plan.toml}][{local:sales.xlsx sheet='Notes'}{$note}{/local:sales.xlsx}]

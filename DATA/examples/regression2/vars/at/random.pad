{# The * wildcard picks a random element, so this page answers differently every run and the crawl marks it random rather than comparing it. The values are meant to match the shapes noted beside them - 11? is any of 111, 112, 113 and so on. The last three lines once asked for a single variable, option or parameter of a named level through the dotted group form. That resolves to nothing; only the loop form used here works. #}<br>{sequence '25..100', name='myRange'/} {$myRange.*}<br>{$*@myRange}<br>{$myRange.*@sequence}<br><hr>{pad name='cool', abc=123, 'fiets', $abc='banaan', $go='nuts', xyz=789, 12*15, 34} {variables@cool}{$name}={$value} {/variables@cool}<br>{options@cool}{$name}={$value} {/options@cool}<br>{parameters@cool}{$value} {/parameters@cool}<br>{/pad}<hr>11?<br>{$a.b.1.c.1.*}<br><br>11?<br>{$a.b.&lt;.c.&lt;.*}<br><br>??1 ??? ??3<br>{$a.b.*.c.*.&lt;} {$a.b.*.c.*.*} {$a.b.*.c.*.&gt;}<br><br>33?<br>{$a.b.&gt;.c.&gt;.*}<?php $a ['b'] [1] ['c'] [1] [1] = 111; $a ['b'] [1] ['c'] [1] [2] = 112; $a ['b'] [1] ['c'] [1] [3] = 113; $a ['b'] [1] ['c'] [2] [1] = 121; $a ['b'] [1] ['c'] [2] [2] = 122; $a ['b'] [1] ['c'] [2] [3] = 123; $a ['b'] [1] ['c'] [3] [1] = 131; $a ['b'] [1] ['c'] [3] [2] = 132; $a ['b'] [1] ['c'] [3] [3] = 133; $a ['b'] [2] ['c'] [1] [1] = 211; $a ['b'] [2] ['c'] [1] [2] = 212; $a ['b'] [2] ['c'] [1] [3] = 213; $a ['b'] [2] ['c'] [2] [1] = 221; $a ['b'] [2] ['c'] [2] [2] = 222; $a ['b'] [2] ['c'] [2] [3] = 223; $a ['b'] [2] ['c'] [3] [1] = 231; $a ['b'] [2] ['c'] [3] [2] = 232; $a ['b'] [2] ['c'] [3] [3] = 233; $a ['b'] [3] ['c'] [1] [1] = 311; $a ['b'] [3] ['c'] [1] [2] = 312; $a ['b'] [3] ['c'] [1] [3] = 313; $a ['b'] [3] ['c'] [2] [1] = 321; $a ['b'] [3] ['c'] [2] [2] = 322; $a ['b'] [3] ['c'] [2] [3] = 323; $a ['b'] [3] ['c'] [3] [1] = 331; $a ['b'] [3] ['c'] [3] [2] = 332; $a ['b'] [3] ['c'] [3] [3] = 333;?>
{common:table}{common:demo}

{pad:data 'myJson'}
  [ { "name": "bob",   "phone": "555-5555" },
    { "name": "jim",   "phone": "555-6666" },
    { "name": "joe",   "phone": "555-7777" },      
    { "name": "jerry", "phone": "555-8888" } ]
{/pad:data}

{pad:data}
  name,phone
  {data:myJson}
    {$name}, {$phone}
  {/data:myJson}
{/pad:data 'myCsv'}

{pad:data}
  <records>
    {data:myCsv}
      <record name="{$name}" phone="{$phone}"/>
    {/data:myCsv}
  </records>
{/pad:data 'myXml'}

{pad:data}
  ---
    {data:myXml} 
    - name: {$name}
      phone: {$phone}
    {/data:myXml}
{/pad:data 'myYaml'}

{/common:demo}{common:demo}

<table border="1">
  {data:myYaml}
    <tr>
      <td>{$name}</td> 
      <td>{$phone}</td>
    </tr>
  {/data:myYaml}
</table>

{/common:demo}{/common:table}

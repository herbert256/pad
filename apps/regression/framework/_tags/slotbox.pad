{# Fixture for the slot cases: a tag whose template uses slotpanel and passes its own title
   slot on to the panel's head slot, with its own label parameter beside it. #}
{pad:parms label/}{app:slotpanel}{pad:slot 'head'}{#label}: {pad:slot 'title'}no title{/pad:slot}{/pad:slot}@content@{/app:slotpanel}

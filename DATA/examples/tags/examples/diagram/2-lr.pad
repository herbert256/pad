{meta title='Left to right, curved', about='direction=LR and edges=curved; & fans one node out to several.'}
{diagram direction='LR', edges='curved', title='Deploy pipeline'}
  code([Commit]) --> build[Build]
  build --> unit[Tests] & lint[Lint]
  unit & lint --> gate{Green?}
  gate -->|yes| live((Live))
  gate -.->|no| code
{/diagram}

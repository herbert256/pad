{common:table}

{common:demo}{sequence:loop 25, push='mySequence'/} {/common:demo}

{common:demo}{pad:pull mySequence, make,   xor=4} {$sequence} {/pad:pull}{/common:demo}

{common:demo}{pad:pull mySequence, keep,   xor=4} {$sequence} {/pad:pull}{/common:demo}

{common:demo}{pad:pull mySequence, remove, xor=4} {$sequence} {/pad:pull}{/common:demo}

{common:demo}{pad:pull mySequence, flag,   xor=4} {$sequence} {/pad:pull}{/common:demo}

{/common:table}

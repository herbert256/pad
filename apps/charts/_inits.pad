<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{$pageTitle} · PAD Charts</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap">
  <link rel="stylesheet" href="charts.css">
  <script src="charts.js"></script>
</head>
<body{if $isExample} class="is-example"{/if}>

<div class="aurora" aria-hidden="true"><span></span><span></span><span></span></div>

<header class="topbar">
  <div class="topbar-inner">

    <a class="brand" href="?index">
      <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true">
        <rect x="3" y="17" width="6" height="12" rx="2"/>
        <rect x="13" y="9" width="6" height="20" rx="2"/>
        <rect x="23" y="3" width="6" height="26" rx="2"/>
      </svg>
      <span>PAD <b>Charts</b></span>
    </a>

    <nav class="menu" aria-label="Chart types">
      <ul>
        {families}
        <li class="menu-item{if $active} is-active{/if}">
          <button type="button" class="menu-button" aria-haspopup="true" aria-expanded="false">
            {$label}
            <svg class="chev" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 4.5l3 3 3-3"/></svg>
          </button>
          <div class="drop">
            <div class="drop-head"><span class="drop-kicker">{$tagline}</span><span class="drop-count">{$count} {echo $count eq 1 ? 'example' : 'examples'}</span></div>
            {examples}
            <a class="drop-link{if $active} is-active{/if}" href="?{$page}">
              <span class="drop-title">{$title}</span>
              <span class="drop-text">{$text}</span>
            </a>
            {/examples}
          </div>
        </li>
        {/families}
      </ul>
    </nav>

    <button type="button" class="theme" id="theme" aria-label="Switch between light and dark">
      <svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.5"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg>
    </button>

  </div>
</header>

{if $isExample}
<main class="page example">

  <div class="intro">
    <a class="crumb" href="?index">All charts</a><span class="crumb-sep">/</span><span class="crumb-here">{$familyLabel}</span>
    <h1>{$exampleTitle}</h1>
    <p class="lead">{$exampleText}</p>
  </div>

  <div class="stage{if $tagPair} is-pair{/if}">

    {if not $tagPair}
    <section class="cell cell-data" aria-label="The data">
      <header class="cell-head">
        <span class="cell-num">1</span>
        <span class="cell-name">The data</span>
        <span class="cell-file">{$dataFile}</span>
        <span class="badge badge-{$dataLang}">{$dataLang}</span>
        <button type="button" class="copy" data-copy="data-src" aria-label="Copy the data">Copy</button>
      </header>
      <pre class="code" id="data-src"><code>{!dataHtml}</code></pre>
    </section>
    {/if}

    <section class="cell cell-tag" aria-label="The chart tag">
      <header class="cell-head">
        <span class="cell-num">{if $tagPair}1{else}2{/if}</span>
        <span class="cell-name">{if $tagPair}The chart tag and its data{elseif $tagOnly}The chart tag{else}The template{/if}</span>
        <span class="cell-file">{$tagFile}</span>
        <span class="badge badge-pad">pad</span>
        <button type="button" class="copy" data-copy="tag-src" aria-label="Copy the tag">Copy</button>
      </header>
      <pre class="code" id="tag-src"><code>{!tagHtml}</code></pre>
    </section>

    <section class="cell cell-chart" aria-label="The chart">
      <header class="cell-head">
        <span class="cell-num">{if $tagPair}2{else}3{/if}</span>
        <span class="cell-name">The result</span>
        <span class="cell-file">inline SVG · no JavaScript</span>
      </header>
      <div class="canvas">
{/if}
@page@
{if $isExample}
      </div>
    </section>

  </div>

  <nav class="pager" aria-label="More examples">
    <a class="pager-link prev" href="?{$prevPage}"><span class="pager-dir">← Previous</span><span class="pager-title">{$prevTitle}</span></a>
    <a class="pager-link next" href="?{$nextPage}"><span class="pager-dir">Next →</span><span class="pager-title">{$nextTitle}</span></a>
  </nav>

</main>
{/if}

</body>
</html>

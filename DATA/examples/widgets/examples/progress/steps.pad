{pad:meta title='Steps and sizes', about='With steps a dot per step, the ones done filled and the current one ringed; size= makes a bar thin or thick.'/}
<div style="display:grid; gap:22px; width:min(100%, 460px); margin:0 auto">
  {widget:progress 3, max=5, steps, label='Checkout'/}
  {widget:progress 2, max=4, steps, label='Onboarding', size='large', color='success'/}
  {widget:progress 45, label='Disk space', size='small', color='neutral'/}
  {widget:progress 7.5, max=10, label='Quota', size='large', color='warning'/}
</div>

{pad:set $abc = 1/} {$abc}
{pad:code reset}
  {pad:set $abc = 2/} {$abc}
  {pad:code reset}
    {pad:set $abc = 3/} {$abc}
    {pad:code reset}
      {pad:set $abc = 4/} {$abc}
      {pad:code reset}
        {pad:set $abc = 5/} {$abc}
        {pad:code reset}
          {pad:set $abc = 6/} {$abc}
          {pad:code reset}
            {pad:set $abc = 7/} {$abc}
            {pad:code reset}
              {pad:set $abc = 8/} {$abc}
              {pad:code reset}
                {pad:set $abc = 9/} {$abc}
              {/pad:code} {$abc}
            {/pad:code} {$abc}
          {/pad:code} {$abc}
        {/pad:code}{$abc}
      {/pad:code} {$abc}
    {/pad:code} {$abc}
  {/pad:code} {$abc}
{/pad:code}{$abc}

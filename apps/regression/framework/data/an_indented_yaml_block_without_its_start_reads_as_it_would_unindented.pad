{format:auto 'y'}
  city: Paris
  country: FR
{/format:auto}[{data:y}{property:key@y/}={$y};{/data:y}]
{format:auto 'l'}
  - name: a
  - name: b
{/format:auto}[{data:l}{$name};{/data:l}]
{format:auto 'n'}
    rows:
      - name: c
        age: 3
      - name: d
        age: 4
{/format:auto}[{data:n}{$name}{$age};{/data:n}]

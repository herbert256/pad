{pad:meta title='Taking values out', about='shift=2 shows the first two values and removes them from the store; the next pull starts at 3.'/}
{sequence:range '1..6', push='queue'/}
<p>Taken: {pad:pull 'queue', shift=2}{$sequence} {/pad:pull}</p>
<p>Left:  {pad:pull 'queue'}{$sequence} {/pad:pull}</p>

{pad:meta title='Combobox'/}
{include:about/}

{input:form 'try', class='inputs-try', error}
  {input:combobox 'city', label='City', rules='required|in:Amsterdam,Antwerp,Athens,Berlin,Bern,Brussels,Lisbon,London,Madrid,Paris,Prague,Rome,Vienna'}
    Amsterdam
    Antwerp
    Athens
    Berlin

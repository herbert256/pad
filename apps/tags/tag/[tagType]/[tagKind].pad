{!tagKindHtml}
</section>

<section class="block" aria-labelledby="examples"><h2 id="examples">Example</h2>
  {tagKindExample}
  <div class="example" id="example-1">
    <h3>{$title}</h3>
    {if $about}<p class="example-about">{$about}</p>{/if}
    <div class="example-grid{if not $run} is-static{/if}">
      <div class="cell">
        <div class="cell-head"><span>Template</span><span class="cell-file">{$file}</span></div>
        <pre class="code"><code>{!padHtml}</code></pre>
        {if $php}
        <div class="cell-head"><span>PHP</span><span class="cell-file">{$php}</span></div>
        <pre class="code"><code>{!phpHtml}</code></pre>
        {/if}
      </div>
      {if $run}
      <div class="cell">
        <div class="cell-head"><span>Result</span><span>{if $open}<a class="cell-file" href="{$open}">open alone</a>{/if}{!play}</span></div>
        <div class="result">{if $app}{page $page, app=$app, ajax=0/}{elseif $page}{page $page/}{else}{echo $source | code/}{/if}</div>
      </div>
      {/if}
    </div>
  </div>
  {/tagKindExample}

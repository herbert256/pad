{pad:meta title='Look at the state mid-page', about='The request stops at the dump; the rows above it were processed, the paragraph below never is.'/}
{array:orders}
  <p>{$number}: {$total}</p>
  {pad:if $total gt 1000}{pad:dump/}{/pad:if}
{/array:orders}
<p>This paragraph is never rendered when an order above 1000 is there.</p>

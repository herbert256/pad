<article class="tag">

  <nav class="crumbs" aria-label="Where you are">
    <a href="?index">Tags</a><span>/</span><a href="?groups#{$tagGroupKey}">{$tagGroupLabel}</a><span>/</span><span aria-current="page">{$tagName}</span>
  </nav>

  <header class="tag-head">
    <h1><span class="brace">&#123;</span>{$tagName}<span class="brace">&#125;</span></h1>
    <p class="tag-about">{$tagAbout}</p>
    <p class="chips"><a class="chip" href="?groups#{$tagGroupKey}">{$tagGroupLabel}</a> <a class="chip chip-form" href="?forms#{$tagForm}">{$tagFormLabel}</a></p>
  </header>

  <section class="block" aria-labelledby="syntax">
    <h2 id="syntax">Syntax</h2>
    <pre class="code"><code>{!tagSyntaxHtml}</code></pre>

    {tagParmRows}
    {first@tagParmRows}<h3>Parameters</h3><dl class="defs">{/first@tagParmRows}
      <dt><code>{$parm}</code></dt><dd>{!meaning}</dd>
    {last@tagParmRows}</dl>{/last@tagParmRows}
    {/tagParmRows}

    {tagOptionRows}
    {first@tagOptionRows}<h3>Options</h3><dl class="defs">{/first@tagOptionRows}
      <dt><code>{$option}</code></dt><dd>{!meaning}</dd>
    {last@tagOptionRows}</dl>{/last@tagOptionRows}
    {/tagOptionRows}
  </section>

  <section class="block prose" aria-labelledby="description">
    <h2 id="description">Description</h2>

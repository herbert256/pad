<div class="shared-top">
  <span class="muted small">The badge is Svelte:</span>
  <div data-island="CartBadge" data-props="{^badge}"><span class="cart-badge">🛒 <strong>{$cart.count}</strong></span></div>
</div>

<div class="shop">
  <div data-island="Shelf" data-props="{^shelf}"></div>
  <aside data-island="CartSummary" data-props="{^badge}"></aside>
</div>

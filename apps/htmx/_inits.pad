<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{$title}</title>
  <link rel="stylesheet" href="{$padRoot}htmx/htmx.css?v={$htmxVersion}">
  <script src="{$padRoot}htmx/htmx-app.js?v={$htmxVersion}"></script>
  <script src="https://unpkg.com/htmx.org@2.0.11/dist/htmx.min.js"></script>
  <script src="https://unpkg.com/htmx-ext-sse@2.2.4/sse.js"></script>
</head>
<body hx-headers="{^htmxHeaders}">

<header class="topbar">
  <div class="wrap topbar-inner">

    <a class="brand" href="?index" aria-label="PAD + htmx home">
      <span class="brand-mark" aria-hidden="true">&lt;/&gt;</span>
      <span>PAD <em>+</em> htmx</span>
    </a>

    <nav class="menu" aria-label="Sections">
      {local:nav.json}
        <a href="?{$page}"{if $navSection eq $section} class="is-active" aria-current="page"{/if}>{$label}</a>
      {/local:nav.json}
    </nav>

    <a class="cart-badge" href="?examples/cart" aria-label="The cart">
      🛒 <span id="cart-count">{$cartCount}</span>
    </a>

    <button type="button" class="theme" data-theme-toggle aria-label="Switch between light and dark">
      <svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.5"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg>
    </button>

  </div>
</header>

<main class="wrap main">
@page@
</main>

<footer class="footer">
  <div class="wrap">
    <p><strong>PAD</strong> renders every part of the page &middot; <strong>htmx</strong> asks for the part that changes and swaps it in</p>
    <p class="footer-small">htmx comes from unpkg.com &middot; the pages are in <code>apps/htmx/</code> - there is no JavaScript of the application's own but a request log</p>
  </div>
</footer>

</body>
</html>

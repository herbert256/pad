[{sequence:prime 5}{$prime} {/sequence:prime}][{sequence:fibonacci 5}{$fibonacci} {/sequence:fibonacci}][{keep:prime '1..10'}{$sequence} {/keep:prime}][{flag:even '1;2;3'}{$sequence}{/flag:even}][{sequence:multiply 3, rows=3}{$multiply} {/sequence:multiply}][{sequence:repeat 'x', rows=2}{$repeat}{/sequence:repeat}]

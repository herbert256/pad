{pad:meta title='Teasers from HTML', about='The first 25 words of each post body - its tags dropped with html, an ellipsis where it goes on.'/}
<div>
  {array:posts}
    <article>
      <h3>{$title}</h3>
      <p><small>{$date}</small> {widget:excerpt $body, words=25, html/}</p>
    </article>
  {/array:posts}
</div>

{pad:set $i = 0/}A[{pad:while $i lt 5}{pad:increment $i/}{property:notFirst@while},{pad:if $i eq 3}{pad:break/}{/pad:if}{/property:notFirst@while}{$i}{/pad:while}]
{pad:set $i = 0/}B[{pad:while $i lt 5}{pad:increment $i/}{pad:ifchanged $i}{pad:if $i eq 3}{pad:cease/}{/pad:if}{/pad:ifchanged}{$i}{/pad:while}]
{pad:set $i = 0/}C[{pad:while $i lt 5}{pad:increment $i/}{pad:ifchanged $i}{pad:if $i eq 3}{pad:continue/}{/pad:if}{/pad:ifchanged}{$i}{/pad:while}]
D[{array:rows}{pad:ifchanged $a}{pad:if $a eq 2}{pad:break/}{/pad:if}{/pad:ifchanged}{$a}{/array:rows}]
E[{array:rows}{property:notFirst@rows}{pad:break/}{/property:notFirst@rows}{$a}{/array:rows}]
F[{array:rows}{pad:guest}{pad:if $a eq 2}{pad:continue/}{/pad:if}{/pad:guest}{$a}{/array:rows}]
G[{array:rows}{pad:true}{pad:cease/}{/pad:true}{$a}{/array:rows}]
H[{array:rows}{pad:spaceless}{pad:if $a eq 2}{pad:break/}{/pad:if}{/pad:spaceless}{$a}{/array:rows}]

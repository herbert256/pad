{# This page reports the crawl's own stored results - its own status among them - so it
   differs from one run to the next whatever the framework does. getRegressionGo() looks in
   a page's source for the word random to mark one that cannot be compared, and the status
   names used to reach it by accident, through the colour chain that stood here. Saying it
   on purpose keeps the page out of the warning count where it would mean nothing. #}

<table border="0" cellpadding="4" cellspacing="0" align="center">
  <tr>
    {statuses}
      <td align="center" style="{$style}">{$status}</td>
    {/statuses}
  </tr>
  <tr>
    {statuses}
      <td align="center">{$count}</td>
    {/statuses}
  </tr>
</table>

<p>
  {$total} pages
</p>

{list}

  <h3>{$app}</h3>

  {items}
    <a style="{$style}" href="{$link}">{$item}</a>
    &nbsp; &nbsp;
  {/items}

{/list}
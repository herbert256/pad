{pad:meta title='A search form', about='A form sent by GET carries no token and no name field - its fields refill from the query string.'/}
{input:form 'search', method='get', class='search', role='search'}
  {input:field 'q', type='search', label='Find a tag', placeholder='if, form, chart ...'/}
  {input:field 'go', type='submit', value='Search'/}
{/input:form}

{sequence:range '1..9', push='s'/}[{action:reverse '1..5', 'sum'}{$sequence} {/action:reverse}][{action:reverse '1..5', 'first'}{$sequence} {/action:reverse}][{action:reverse '1..5', 'first', 2}{$sequence} {/action:reverse}][{sequence:prime 3, 'reverse'}{$sequence} {/sequence:prime}][{action:sum 'prime', 3}{$sequence} {/action:sum}][{pad:set $a = 'sum'/}{action:reverse s, $a}{$sequence} {/action:reverse}][{sequence:range '1..5', sort, 'reverse'}{$sequence} {/sequence:range}][{pad:pull 's', 'shift', 2}{$sequence} {/pad:pull}]

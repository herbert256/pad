<div class="login">

  {pad:if $loginSetup eq 1}
    <p class="dim">Nobody can log in yet. Make the first user - more can be added in the console later.</p>
  {pad:else}
    <p class="dim">The console of the PAD installation on this server.</p>
  {/pad:if}

  {pad:if $loginHint eq 1}
    <p class="flash error" role="alert">The first user can only be made from this machine.</p>
  {/pad:if}

  {pad:if $loginError ne ''}
    <p class="flash error" role="alert">{$loginError}</p>
  {/pad:if}

  {input:form 'login'}
    <p>{input:field 'name', label='Name', autocomplete='username', required, autofocus/}</p>
    {pad:if $loginSetup eq 1}
      <p>{input:field 'password', type='password', label='Password', autocomplete='new-password', required, minlength=8/}</p>
      <p>{input:field 'again', type='password', label='Password again', autocomplete='new-password', required, minlength=8/}</p>
      <p><button type="submit" class="primary">Make the user and log in</button></p>
    {pad:else}
      <p>{input:field 'password', type='password', label='Password', autocomplete='current-password', required/}</p>
      <p><button type="submit" class="primary">Log in</button></p>
    {/pad:if}
  {/input:form}

</div>

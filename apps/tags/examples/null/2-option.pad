{pad:meta title='null= and else=', about='A NULL fires the null= option and leaves else= alone.'/}
{pad:content 'nullMissing'}<em>no such thing</em>{/pad:content}
{pad:content 'nullEmpty'}<em>empty</em>{/pad:content}
<p>null with null=: {pad:null null='nullMissing'}x{/pad:null}</p>
<p>null with else=: {pad:null else='nullEmpty'}x{/pad:null}</p>
<p>false with else=: {pad:false else='nullEmpty'}x{/pad:false}</p>

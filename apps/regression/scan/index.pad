{# This page reports the crawl's own stored results - its own status among them - so it
   differs from one run to the next whatever the framework does. getRegressionGo() looks in
   a page's source for the word random to mark one that cannot be compared, and this comment
   says it on purpose, which keeps the page out of the warning count where it would mean
   nothing. #}

<table border="0" cellpadding="4" cellspacing="0" align="center">
  <tr>
    {statuses}
      <td align="center" style="{$style}">{$status}</td>
    {/statuses}
  </tr>
  <tr>
    {statuses}
      <td align="center">{$count}</td>
    {/statuses}
  </tr>
</table>

<p>
  Listed below is everything that is not <b>ok</b> or <b>expected</b> - the counts above are
  of all of them.
  {if $warningCount gt 0}
    &nbsp; <a href="?scan/index&acceptWarnings">Accept all {$warningCount} warnings</a> as the
    new baselines - read them first, a page that keeps coming back is telling you something.
  {/if}
</p>

{list}

  <h3>{$app}</h3>

  {items}
    <a style="{$style}" href="{$link}">{$item}</a>
    &nbsp; &nbsp;
  {/items}

{/list}
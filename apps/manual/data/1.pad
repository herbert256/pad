{common:table}
  {common:demo}
    {format:auto 'myData'}
  [
    { "name": "joe",   "phone": "555-3425" },
    { "name": "jim",   "phone": "555-2364" },
    { "name": "jack",  "phone": "555-3422" },
    { "name": "jerry", "phone": "555-4973" }
  ]
{/format:auto}

    <table border="1">
      {data:myData}
        <tr>
          <td>{$name}</td>
          <td>{$phone}</td>
        </tr>
      {/data:myData}
    </table>
  {/common:demo}
{/common:table}

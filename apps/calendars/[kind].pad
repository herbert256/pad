<p class="cal-lead">{$calendarAbout}</p>
<section class="cal-result" aria-label="Rendered calendar">{pad:echo $calendarSource | code/}</section>
<section class="cal-source pad-play-box" aria-label="Calendar template">
  <h2>Template and events</h2>
  {!calendarPlay}<pre><code>{!calendarCode}</code></pre>
</section>
<p class="cal-note">Use <code>sunday</code> to start weeks on Sunday, <code>holidays='nl'</code> to mark public holidays,
or <code>query='schedule'</code> to give this calendar its own navigation parameter.
Omit the date parameter to browse periods with the previous and next links.</p>

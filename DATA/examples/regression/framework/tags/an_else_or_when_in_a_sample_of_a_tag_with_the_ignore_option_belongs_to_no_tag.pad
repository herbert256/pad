{pad:set $a = 1/}
[{pad:if $a eq 1}{pad:markdown ignore}Write `{pad:else}` for the other branch.{/pad:markdown}{/pad:if}]
[{pad:case $a}{pad:when 1}one: {pad:markdown ignore}Write `{pad:when 2}` for two.{/pad:markdown}{pad:when 2}two{/pad:case}]
[{pad:if $a eq 1}{pad:data 'el' ignore}["a {pad:else} b"]{/pad:data}{data:el}{$el}{/data:el}{/pad:if}]

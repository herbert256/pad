{pad:meta title='A property of the tag around it', about='property:count and {&count} read how many rows the loop has; current@ the one it is at.'/}
{pad:data 'fruit'}["apple", "pear", "plum"]{/pad:data}
<ul>
  {data:fruit}<li>{$fruit} - {property:current@fruit/} of {property:count/}</li>{/data:fruit}
</ul>

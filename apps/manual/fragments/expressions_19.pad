{table}
{demo}{echo 3 gt 1 ? 'many' : 'one'}{/demo}
{demo}{echo 15 gt 10 ? (15 gt 20 ? 'L' : 'M') : 'S'}{/demo}
{demo}{echo 15 gt 20 ? 'L' : 15 gt 10 ? 'M' : 'S'}{/demo}
{demo}{echo '' ?: 'Untitled'}{/demo}
{demo}{echo 'Draft' ?: 'Untitled'}{/demo}
{demo}{echo 0 | ? 'some' : 'none'}{/demo}
{demo}{echo 0 ? 'yes' : 'no' . '!'}{/demo}
{/table}

{meta title='A longer rotation, shared', about='Three values cycle; a second switch written alike continues the same rotation.'}
<p>{sequence 4}{switch 'red', 'green', 'blue'} {/sequence}</p>
<p>{sequence 4}{switch 'red', 'green', 'blue'} {/sequence}</p>
<p>{sequence 4}{switch 'red','green','blue'} {/sequence}</p>

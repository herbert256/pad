{pad:meta title='A checkout in steps', about='Address, delivery and payment one at a time - the steps above, Back and Next under each.'/}
<div style="width:100%; max-width:560px">
  {widget:wizard label='Checkout'}
    {widget:tab 'Address'}
      <p><label>Name <input name="name" value="Ann de Vries"></label></p>
      <p><label>Street <input name="street" value="Harbour Lane 12"></label></p>
    {/widget:tab}
    {widget:tab 'Delivery'}
      <p><label><input type="radio" name="when" checked> Tomorrow, € 4.95</label></p>
      <p><label><input type="radio" name="when"> Saturday, free</label></p>
    {/widget:tab}
    {widget:tab 'Payment'}
      <p>1 × Aurora electric kettle, <strong>€ 79.00</strong></p>
      <p><button type="button">Pay € 79.00</button></p>
    {/widget:tab}
  {/widget:wizard}
</div>

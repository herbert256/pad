{pad:data 'pagine'}
[ { "t": "Le università italiane" }, { "t": "Studiare all'università di Bologna" }, { "t": "Un viaggio in treno" }, { "t": "Viaggiare con gli amici" } ]
{/pad:data}
{!stems}|

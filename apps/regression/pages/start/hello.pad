<h4> code </h4>

{pad:code          $color='pink'}             <h3><font color="{$color}">Hello world !</font></h3>  {/pad:code}
{pad:code reset,   $color='orange'}           <h3><font color="{$color}">Hello world !</font></h3>  {/pad:code}
{pad:code clean,   $color='brown'}            <h3><font color="{$color}">Hello world !</font></h3>  {/pad:code}
{pad:code sandbox, $color='purple'}           <h3><font color="{$color}">Hello world !</font></h3>  {/pad:code}

{pad:code          function, $color='green'}  <h3><font color="{$color}">Hello world !</font></h3>  {/pad:code}
{pad:code reset,   function, $color='blue'}   <h3><font color="{$color}">Hello world !</font></h3>  {/pad:code}
{pad:code clean,   function, $color='yellow'} <h3><font color="{$color}">Hello world !</font></h3>  {/pad:code}
{pad:code sandbox, function, $color='red'}    <h3><font color="{$color}">Hello world !</font></h3>  {/pad:code}

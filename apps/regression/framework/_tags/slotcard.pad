{# Fixture for the slot and parms cases: a card with a header slot that has a default, the
   caller's content in main, and a footer slot framed by a footer tag only when filled. #}
{pad:parms title, tone='info'/}<div class="{#tone}"><h2>{#title}</h2>[{pad:slot 'header'}no header{/pad:slot}]<main>@content@</main>{pad:slot 'footer'}<footer>@content@</footer>@else@<footer>-</footer>{/pad:slot}</div>

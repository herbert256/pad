[{add rows=3}{$add} {/add}][{sequence:add rows=3}{$sequence} {/sequence:add}][{set $x = ''}{sequence add=$x, rows=3}{$sequence} {/sequence}][{sequence '1..3', multiply=$x}{$sequence} {/sequence}][{echo sequence:add(3, '')}][{divide rows=3}{$divide} {/divide}][{and rows=3}{$and} {/and}][{keep:multiply from=1, to=3}{$sequence} {/keep:multiply}]
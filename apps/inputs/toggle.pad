{pad:meta title='Toggle'/}
{include:about/}

{pad:form 'try', class='inputs-try', error}
  {input:toggle 'news', label='Send me the newsletter', checked/}
  {input:toggle 'dark', label='Dark mode', on='dark', off='light'/}
  {input:toggle 'terms', label='I accept the terms', rules='accepted'/}
  <button class="inputs-send">Send</button>
{/pad:form}

{include:received/}

{include:template/}

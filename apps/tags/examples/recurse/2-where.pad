{pad:meta title='Filtered at every depth', about='A where option on the tree is carried along by recurse - hidden rows are left out at every level.'/}
{format:auto 'recurseSite'}
[
  { "page": "About", "hidden": 0, "children": [
      { "page": "Team", "hidden": 0 },
      { "page": "Drafts", "hidden": 1 } ] },
  { "page": "Admin", "hidden": 1, "children": [ { "page": "Users", "hidden": 0 } ] },
  { "page": "Blog", "hidden": 0 }
]
{/format:auto}
<ul>
  {pad:tree 'recurseSite', where='$hidden eq 0'}
    <li>
      {$page}
      {pad:branch}
        <ul>{pad:recurse/}</ul>
      {/pad:branch}
    </li>
  {/pad:tree}
</ul>

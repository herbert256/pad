<h3>array, found</h3>{array_1} @else@ {/array_1}<table border="1"><tr><td>{$name}</td><td>{$phone}</td></tr><tr><td>Nothing</td><td>Found</td></tr></table><h3>array, no records found</h3>{array_2} @else@ {/array_2}<table border="1"><tr><td>{$name}</td><td>{$phone}</td></tr><tr><td>Nothing</td><td>Found</td></tr></table><?php $array_1 = db ("array name, phone from staff where phone like '%4%'"); $array_2 = db ("array * from staff where name like '%x%'");?>
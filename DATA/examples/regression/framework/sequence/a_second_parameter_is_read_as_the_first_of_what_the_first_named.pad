[{pad:set $t = 'prime'/}{keep:auto $t, '1..10'}{$sequence} {/keep:auto}][{keep:range '1..10', $t}{$sequence} {/keep:range}][{sequence:prime 5}{$sequence} {/sequence:prime}][{sequence:loop 5, 'prime'}{$sequence} {/sequence:loop}][{sequence:multiply 3, rows=3}{$sequence} {/sequence:multiply}][{sequence:range '1..5', push='s'/}{sequence:auto 's', 'reverse'}{$sequence} {/sequence:auto}]

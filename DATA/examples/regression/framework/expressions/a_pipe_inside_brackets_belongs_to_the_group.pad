{pad:set $n = 3/}{pad:set $s = 'ab'/}[{pad:echo ($n | + 1) * 2/}][{pad:echo upper(' hi ' | trim)/}][{pad:if ($n | + 1) eq 4}y{/pad:if}][{pad:echo php:max(1, $n | + 1)/}][{pad:echo php:implode(',', [$n | + 1, $n])/}][{$s | php:str_pad(@ | upper, 4, '*')}][{pad:echo $s | (@ | upper) . @/}][{pad:echo ($n | (@ | * 2))/}]

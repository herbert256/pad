{pad:meta title='Used inside a loop', about='The macro\'s own parameters are its fields, and the row round the use stays visible behind them.'/}
{pad:macro 'macroPrice', amount}
  <li>{$product}: € {$amount | number_format(@, 2)}</li>
{/pad:macro}

<ul>
{array:macroProducts}
  {macro:macroPrice $price/}
{/array:macroProducts}
</ul>

{pad:set $n = 3/}{pad:set $p = 10/}{pad:set $q = 3/}{pad:set $s = 'ab'/}[{pad:if $n + 1 range (9, 9)}T{pad:else}F{/pad:if}][{pad:echo $n + 1 range (4, 4)/}][{pad:if $p * $q in (30)}T{pad:else}F{/pad:if}][{pad:if $s . 'c' like 'abc'}T{pad:else}F{/pad:if}][{pad:if -$n in (-3)}T{pad:else}F{/pad:if}][{pad:if $n + 1 not in (4)}T{pad:else}F{/pad:if}][{pad:if upper($s) in ('AB')}T{pad:else}F{/pad:if}][{pad:echo $n | * 2 in (6)/}][{pad:if $n eq 3 and $n + 1 in (4)}T{pad:else}F{/pad:if}][{pad:if not $n + 1 in (4)}T{pad:else}F{/pad:if}]

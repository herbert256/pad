[{sequence:fibonacci from=-2000000000, rows=3}{$sequence} {/sequence:fibonacci}][{sequence:lucas from=-1e20, rows=2}{$sequence} {/sequence:lucas}][{sequence:tribonacci from=-9223372036854775808, rows=2}{$sequence} {/sequence:tribonacci}][{sequence:fibonacci from=-5, increment=3, rows=3}{$sequence} {/sequence:fibonacci}][{sequence:fibonacci increment=2.5, rows=4}{$sequence} {/sequence:fibonacci}][{sequence:golomb from=2.5, rows=3}{$sequence} @else@none{/sequence:golomb}][{sequence:fibonacci increment=0, rows=3}{$sequence} @else@none{/sequence:fibonacci}][{sequence:fibonacci from=4, increment=2, rows=4}{$sequence} {/sequence:fibonacci}]

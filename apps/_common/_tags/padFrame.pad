<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{pad:if $frameTitle ne ''}{$frameTitle} · {/pad:if}PAD {$frameName}</title>
  {pad:if $frameOffline}
  {!frameStyle}
  {pad:else}
  <link rel="stylesheet" href="{$frameCss}">
  <link rel="stylesheet" href="{$frameBrandCss}">
  <script src="{$frameJs}"></script>
  <script src="{$frameBrandJs}" defer></script>
  {/pad:if}
  {pad:slot 'head'}{/pad:slot}
</head>
<body class="frame {$frameClass}{pad:if $frameFill} frame-fill{/pad:if}">

  <aside class="frame-side">

    <div class="frame-brand">{common:padBrand frame/}</div>

    {pad:if $frameNav}
      <nav class="frame-nav" aria-label="{$frameName}">
        {array:frameMenu}
          {pad:if $head ne ''}
            <div class="frame-head">{$head}</div>
          {pad:else}
            <a href="{$link}"{pad:if $current} aria-current="page"{/pad:if}>{pad:if $icon ne ''}{icon:$icon size=16/} {/pad:if}{$label}</a>
          {/pad:if}
        {/array:frameMenu}
      </nav>
    {/pad:if}

    {pad:slot 'side'}{/pad:slot}

    {pad:slot 'foot'}{/pad:slot}

  </aside>

  <main class="frame-main">

    <header class="frame-top">
      {pad:slot 'title'}{pad:if $frameTitle ne ''}<h1>{$frameTitle}</h1>{/pad:if}{/pad:slot}
      <div class="frame-tools">
        {pad:slot 'tools'}{/pad:slot}
        {pad:if $frameThemes}{pad:themes/}{/pad:if}
      </div>
    </header>

    <div class="frame-body">

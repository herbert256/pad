# The database of this application - the music catalogue of _install/padSelect.sql, which
# pad/install/db.sh loads - read with padEnv. A local test database: the Other suite reads
# these pages, so the login is kept in git as the other test databases' are.

padSqlHost=127.0.0.1
padSqlDatabase=padSelect
padSqlUser=padSelect
padSqlPassword=padSelect

{common:padFrame}

  {pad:slot 'head'}
    <meta name="theme-color" content="#4f46e5">
    <meta name="csrf-token" content="{pad:csrf token/}">
    <link rel="icon" href="{pad:asset 'icon.svg'/}" type="image/svg+xml">
    {pad:asset 'kanban.css', tag/}
    <script src="{pad:asset 'kanban.js'/}" defer></script>
  {/pad:slot}

  {pad:slot 'tools'}
    {pad:if $padPage eq 'index'}<span class="board-count">{$cardTotal} cards</span>{/pad:if}
    <span class="live" id="live" hidden><i></i> <span>Live</span></span>
    <a class="button primary" href="{$padGo}card" data-new-card>+ New card</a>
  {/pad:slot}

{/common:padFrame}

{pad:flash}<p class="flash {$type}" role="status">{$message}</p>{/pad:flash}

@page@

<footer class="bottom">Kanban runs {$kanbanWhere}. Open it in two windows: a card moved in one moves in the other.</footer>

{common:padFrameEnd/}

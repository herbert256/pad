rollup: [{select:staffSel fields="floor(salary / 2000) as band, sum(salary) as pay", group="band", rollup}{$pay} {/select:staffSel}]
key rollup: [{select:staffKey fields="floor(salary / 2000) as band, sum(salary) as pay", group="band", rollup}{$pay} {/select:staffKey}]
count: [{select:staffSel fields="count(*) as n"}{$n}{/select:staffSel}]
field: [{select:staffKey type='field', fields="max(salary)"/}]
view: [{select:perBand}{$bonus} {/select:perBand}]
view order: [{select:bandDesc}{$band}:{$n} {/select:bandDesc}]
tag order: [{select:staffSel fields="floor(salary / 2000) as band, count(*) as n", group="band", order="n desc, band"}{$band}:{$n} {/select:staffSel}]
rows: [{select:staffSel order="salary desc", rows=2}{$name} {/select:staffSel}]

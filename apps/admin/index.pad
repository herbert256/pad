<section class="tiles">
  {array:tiles}
    <a class="tile {pad:echo $warn ? 'warn' : ''/}" href="?{$page}"><strong>{$value}</strong><span>{$label}</span></a>
  {/array:tiles}
</section>

{pad:if $downCount}
  <section class="card warn">
    <h2>{icon:power size=18/} Down for maintenance</h2>
    <ul>
      {array:downList}
        <li><a href="?application&amp;app={$app}">{$app}</a> - since {$since}{pad:if $message ne ''}: {$message}{/pad:if}</li>
      {/array:downList}
    </ul>
  </section>
{/pad:if}

<div class="grid2">
  <section class="card">
    <h2>{icon:info size=18/} System</h2>
    <table class="facts">
      {array:facts}
        <tr>
          <th>{$label}</th>
          <td>{$value}</td>
        </tr>
      {/array:facts}
    </table>
  </section>

  <section class="card">
    <h2>{icon:database size=18/} Disk</h2>
    {chart:gauge value=$diskUsed, unit='%', bands='70, 90', title='Disk used'/}
    <p class="center dim">{$diskText}</p>
  </section>

  <section class="card">
    <h2>{icon:clock size=18/} Changed last</h2>
    <table class="list">
      {array:recent}
        <tr>
          <td><a href="?application&amp;app={$app}">{$app}</a></td>
          <td><a href="?files&amp;app={$app}&amp;file={$file | url}">{$file}</a></td>
          <td class="dim nowrap">{$ago}</td>
        </tr>
      {/array:recent}
    </table>
  </section>

  <section class="card">
    <h2>{icon:bar-chart size=18/} DATA/ in MB</h2>
    {pad:if $dataChart}
      {chart:hbar data='dataSizes', label='dir', value='mb'/}
    {pad:else}
      <p class="dim">DATA/ is empty.</p>
    {/pad:if}
    <p><a href="?storage">Storage</a></p>
  </section>
</div>

{pad:meta title='Search'/}
<h1>Search</h1>

{pad:if $tagsSearch eq ''}
  <p class="lead">Search for a tag, a subsystem kind, or a word of what it does.</p>
{pad:elseif $hits eq 0}
  <p class="lead">No entry matches <strong>{$tagsSearch}</strong>. Try the <a href="?names">list by name</a>.</p>
{pad:else}
  <p class="lead">{$hits} {pad:echo $hits eq 1 ? 'entry matches' : 'entries match'/} <strong>{$tagsSearch}</strong>.</p>
  <ul class="list">
    {array:found}
      <li><a class="name" href="?{$link}">{$label}</a> <span class="about">{$about} <a class="meta" href="?groups#{$group}">{$groupLabel}</a></span></li>
    {/array:found}
  </ul>
{/pad:if}

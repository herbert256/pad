{pad:meta title='Colour picker'/}
{include:about/}

{input:form 'try', class='inputs-try', error}
  {input:colorpicker 'tint', label='Theme colour', value='#2a78d6', rules='required|color'/}
  {input:colorpicker 'mark', label='Marker', swatches='#fff1b8, #ffd6a5, #caffbf, #9bf6ff, #bdb2ff, #ffc6ff'/}
  <button class="inputs-send">Send</button>
{/input:form}

{include:received/}

{include:template/}

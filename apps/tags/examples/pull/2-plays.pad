{pad:meta title='Plays over a store', about='The same twelve numbers kept, removed and flagged against the type even.'/}
{sequence:range '1..12', push='dozen'/}
<p>keep:   {pad:pull 'dozen', keep, even}{$sequence} {/pad:pull}</p>
<p>remove: {pad:pull 'dozen', remove, even}{$sequence} {/pad:pull}</p>
<p>flag:   {pad:pull 'dozen', flag, even}{$sequence}{/pad:pull}</p>

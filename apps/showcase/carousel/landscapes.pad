{meta title='Four landscapes', about='Slides that snap sideways - swipe, scroll, or use the arrows and the dots, which are plain links.'}
<div style="width:100%; max-width:640px">
  {carousel label='Landscapes'}
    {tab 'Sunrise over the hills'}
      <svg viewBox="0 0 800 400" role="img" aria-label="Hills under a rising sun">
        <rect width="800" height="400" fill="#fbd38d"/>
        <circle cx="560" cy="250" r="80" fill="#f6ad55"/>
        <path d="M0 290 Q200 190 400 280 T800 250 V400 H0Z" fill="#c05621"/>
        <path d="M0 340 Q250 270 500 330 T800 320 V400 H0Z" fill="#7b341e"/>
      </svg>
    {/tab}
    {tab 'The open sea'}
      <svg viewBox="0 0 800 400" role="img" aria-label="Waves under a pale sky">
        <rect width="800" height="400" fill="#bee3f8"/>
        <rect y="220" width="800" height="180" fill="#3182ce"/>
        <path d="M0 260 q50 -20 100 0 t100 0 t100 0 t100 0 t100 0 t100 0 t100 0 t100 0" stroke="#90cdf4" stroke-width="6" fill="none"/>
        <path d="M0 320 q50 -20 100 0 t100 0 t100 0 t100 0 t100 0 t100 0 t100 0 t100 0" stroke="#63b3ed" stroke-width="6" fill="none"/>
        <path d="M520 220 l40 -80 l40 80z" fill="#fff"/>
      </svg>
    {/tab}
    {tab 'A forest at dusk'}
      <svg viewBox="0 0 800 400" role="img" aria-label="Pine trees against a violet sky">
        <rect width="800" height="400" fill="#553c9a"/>
        <circle cx="160" cy="90" r="34" fill="#faf089"/>
        <path d="M80 400 l60 -220 l60 220z M240 400 l70 -260 l70 260z M420 400 l55 -200 l55 200z M560 400 l75 -280 l75 280z" fill="#22543d"/>
        <rect y="370" width="800" height="30" fill="#1c4532"/>
      </svg>
    {/tab}
    {tab 'Snow on the peaks'}
      <svg viewBox="0 0 800 400" role="img" aria-label="Mountains with snow caps under a blue sky">
        <rect width="800" height="400" fill="#90cdf4"/>
        <path d="M0 400 L230 120 L460 400Z" fill="#4a5568"/>
        <path d="M300 400 L560 80 L800 400Z" fill="#2d3748"/>
        <path d="M230 120 L280 181 L250 170 L215 190 L185 175Z M560 80 L620 154 L585 140 L550 165 L515 140Z" fill="#fff"/>
      </svg>
    {/tab}
  {/carousel}
</div>

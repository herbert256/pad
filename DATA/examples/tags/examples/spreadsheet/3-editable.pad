{pad:meta title='Cells to edit', about='editable makes the numbers fields; outside a form or a live region the sheet is a form of its own and Recalculate computes it again on the server.'/}
{pad:spreadsheet 'loan', editable, formats='B4:€ #,##0.00'}
  Amount,10000
  Interest,5%
  Years,3
  Monthly,=PMT(B2/12,B3*12,-B1)
{/pad:spreadsheet}

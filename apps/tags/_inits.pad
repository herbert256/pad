<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{$title} · PAD tags</title>
  <link rel="stylesheet" href="tags.css">
  <script src="tags.js"></script>
</head>
<body>

<header class="topbar">
  <div class="topbar-inner">

    <a class="brand" href="?index">
      <span class="brand-mark" aria-hidden="true">&#123;&#125;</span>
      <span>PAD <b>tags</b></span>
    </a>

    <nav class="menu" aria-label="Indexes">
      {tagsMenu}<a class="menu-link{if $active} is-active{/if}" href="?{$page}"{if $active} aria-current="page"{/if}>{$label}</a>{/tagsMenu}
    </nav>

    <form class="search" action="" method="get" role="search">
      <input type="hidden" name="search" value="">
      <label class="sr-only" for="q">Search the tags</label>
      <input type="search" id="q" name="q" value="{$tagsSearch}" placeholder="Search {$tagsCount} tags" autocomplete="off">
    </form>

    <button type="button" class="theme" id="theme" aria-label="Switch between light and dark">
      <svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.5"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg>
    </button>

  </div>
</header>

<main class="page">
@page@
</main>

<footer class="foot">
  <p>{$tagsCount} built-in tags of PAD, each with its syntax, its own options and live examples - every result on this site rendered by the tag it documents.</p>
</footer>

</body>
</html>

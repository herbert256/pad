{table}
{demo}{echo 'abcdef' | mid(2, 3)}{/demo}
{demo}{echo 'abcdef' | right(2)}{/demo}
{demo}{echo 'user@example.com' | after('@') | before('.')}{/demo}
{demo}{echo 'Crème Brûlée & Co.' | slug}{/demo}
{demo}{echo 1536 | bytes}{/demo}
{demo}{echo 'a long sentence that goes on' | truncate(17)}{/demo}
{demo}{echo 1234567 | abbreviate(1)}{/demo}
{demo}{echo 22 | ordinal}{/demo}
{/table}

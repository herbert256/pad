{pad:meta title='Log in with ...', about='A button per provider; href= sends this one nowhere, the default is the page oauth/<provider>.'/}
<p>
  {pad:oauth 'github', href='#github'/}
  {pad:oauth 'gitlab', href='#gitlab'/}
  {pad:oauth 'bitbucket', href='#bitbucket'/}
  {pad:oauth 'google', href='#google'/}

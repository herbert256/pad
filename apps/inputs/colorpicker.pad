{meta title='Colour picker'/}
{about/}

{form 'try', class='inputs-try', error}
  {colorpicker 'tint', label='Theme colour', value='#2a78d6', rules='required|color'/}
  {colorpicker 'mark', label='Marker', swatches='#fff1b8, #ffd6a5, #caffbf, #9bf6ff, #bdb2ff, #ffc6ff'/}
  <button class="inputs-send">Send</button>
{/form}

{received/}

{template/}

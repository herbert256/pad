[{array:items}{pad:guest}{pad:ifchanged $g}<{$g}>{/pad:ifchanged}{/pad:guest}{$n} {/array:items}]
[{array:items}{pad:true}{pad:ifchanged $g}<{$g}>{/pad:ifchanged}{/pad:true}{$n} {/array:items}]
[{array:items}{property:notFirst@items}{pad:ifchanged $g}|{/pad:ifchanged}{/property:notFirst@items}{$n} {/array:items}]
[{pad:define 'heading'}{pad:ifchanged $g}<{$g}>{/pad:ifchanged}{/pad:define}{array:items}{define:heading/}{$n} {/array:items}]
[{pad:set $i = 0/}{pad:while $i lt 5}{pad:increment $i/}{pad:guest}{pad:ifchanged php:intdiv($i,2)}<h>{/pad:ifchanged}{/pad:guest}{$i}{/pad:while}]

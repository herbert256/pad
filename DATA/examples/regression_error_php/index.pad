<p>action: {$action}</p>{if $tested eq 1}<p>the boom page behaved as this action promises: <b>{$verdict}</b></p>{else}<p><a href="?index&amp;test">Test</a> the boom page</p>{/if}<?php // Test fetches the boom page - an undefined variable its .php reads - and asserts what // the 'php' error action is supposed to do with it: PHP reports the warning itself and // the page finishes. A plain load only offers the link, so a crawl raises nothing. $tested = isset ( $test ) ? 1 : 0; if ( $tested ) { $r = padCurl ( $padHost . 'regression_error_php/?boom&padInclude' ); $code = $r ['result']; $body = $r ['data']; $verdict = ( $code == 200 and str_contains ( $body, "Warning" ) and str_contains ( $body, "after" ) ) ? "yes" : "NO"; } $action = $padErrorAction;?>
{select:genres}
  <h3>{$genre}</h3>
  <ul>
    {select:artists where="artist_id in (select artist_id from albums where genre_code = $genre_code)"}
      <li>{$name}: {select:albums}{$title}{property:notLast@albums}, {/property:notLast@albums}{/select:albums}</li>
    @else@
      <li class="dim">no album of its own</li>
    {/select:artists}
  </ul>
{/select:genres}

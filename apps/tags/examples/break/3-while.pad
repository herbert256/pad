{pad:meta title='Breaking a while', about='A loop with a generous condition, left as soon as the sum passes 20.'/}
{pad:set $sum = 0/}
{pad:set $add = 0/}
<p>
  {pad:while $add lt 100}
    {pad:increment $add/}
    {pad:set $sum = $sum + $add/}
    {pad:if $sum gt 20}{pad:break/}{/pad:if}
    {$sum}
  {/pad:while}
</p>
<p>Stopped when adding {$add} made {$sum}.</p>

{pad:meta title='Continuing an outer loop', about='Named, continue leaves the inner loop and the rest of the outer pass, and goes on with the next outer row.'/}
{sequence:range '1..3', name='table'}
  <br>Table {$table}:
  {sequence:range '1..4', name='seat'}
    {pad:if $seat gt $table}{pad:continue 'table'/}{/pad:if}
    seat {$seat}
  {/sequence:range}
  - never reached
{/sequence:range}

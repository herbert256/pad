{pad:set $d = php:date_create('2020-01-02 03:04:05+00:00')/}{pad:set $e = php:date_create('2020-01-02 08:04:05+05:00')/}{pad:set $f = php:date_create('2020-01-03 00:00:00+00:00')/}a[{pad:if $d eq $e}eq{pad:else}ne{/pad:if}] b[{pad:if $d in ($e)}in{pad:else}notin{/pad:if}] c[{pad:if $d range ($e, $f)}r{pad:else}nr{/pad:if}] d[{pad:if $f in ($d, 'x')}in{pad:else}notin{/pad:if}]

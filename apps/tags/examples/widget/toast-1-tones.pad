{meta title='Notices', about='A toast of each tone, closed by its button through a form of method dialog - no script.'/}
{toast 'Saved', tone='success'}Your changes are kept.{/toast}
{toast 'Heads up'}The shop closes at six today.{/toast}
{toast tone='warning'}Your session ends in five minutes.{/toast}
{toast 'Payment failed', tone='error'}The card was declined - try another one.{/toast}

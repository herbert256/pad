[{sequence '1..8'}{echo sequence:prime(9 - $sequence)} {/sequence}][{echo sequence:prime(3)} {echo sequence:prime(20)} {echo sequence:prime(2)}][{echo sequence:add(3, 10)} {echo sequence:add(3, 20)} {echo sequence:add(2)}][{sequence '1..3', push='s'}{/sequence}{echo sequence:add(2, 's')} {resume multiply=10}{echo sequence:add(2, 's')}][{echo sequence:fibonacci(10)} {echo sequence:fibonacci(5)} {echo sequence:lucas(5)}]
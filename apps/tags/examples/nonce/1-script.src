{pad:meta title='A script the policy lets run', about='The nonce on the script tag is the one in this response\'s Content-Security-Policy header - a script without it is blocked.'/}
{# _config/config.php: $padCsp = "default-src 'self'; script-src 'self' 'nonce'"; #}
<script nonce="{pad:nonce/}">{pad:ignore}
  document.documentElement.classList.add('js');
{/pad:ignore}</script>

{# renders: <script nonce="kq3Z0d9wQ1m2bH8sVf7aXyPc"> - a new value every request #}

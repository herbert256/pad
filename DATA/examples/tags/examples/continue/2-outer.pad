{meta title='Continuing an outer loop', about='Named, continue leaves the inner loop and the rest of the outer pass, and goes on with the next outer row.'}
{sequence '1..3', name='table'}
  <br>Table {$table}:
  {sequence '1..4', name='seat'}
    {if $seat gt $table}{continue 'table'}{/if}
    seat {$seat}
  {/sequence}
  - never reached
{/sequence}

{pad:data 'xs'}[{"n":1},{"n":2},{"n":3},{"n":4}]{/pad:data}{pad:data 'ks'}{"a":{"v":1},"b":{"v":2},"c":{"v":3}}{/pad:data}
even:[{data:xs where='even@xs'}{$n}{/data:xs}] first:[{data:xs where='first@xs'}{$n}{/data:xs}] last:[{data:xs where='last@xs'}{$n}{/data:xs}] current:[{data:xs where='current@xs gt 2'}{$n}{/data:xs}] count:[{data:xs where='$n gt 2 and count@xs eq 4'}{$n}{/data:xs}] key:[{data:ks where='key@ks ne "b"'}{$v}{/data:ks}] negative:[{data:ks where='key@ks eq "b"', negative}{$v}{/data:ks}] after:[{data:xs where='even@xs'}{property:current@xs/}:{$n},{/data:xs}]

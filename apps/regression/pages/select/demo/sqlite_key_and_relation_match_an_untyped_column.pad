key:      [{select:boards $id=2}{$name}@else@none{/select:boards}]
request:  [{select:boards $id=$wanted}{$name}@else@none{/select:boards}]
relation: [{select:boards}{$name}={select:topics}{$title}{/select:topics} {/select:boards}]
text:     [{select:codes $code=$code}{$label}@else@none{/select:codes}]

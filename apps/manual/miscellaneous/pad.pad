{common:table}
  {common:demo}
    {pad:pad $myColor='red'}
      <b>
        <font color="{$myColor}"> Hallo Wereld </font>
      </b>
      <br>
    {/pad:pad}
  {/common:demo}
{/common:table}

{common:block}
  <p>
    Below example gives a sneak preview of {app:manual 'the_content_tag'/} and {app:manual 'the_data_tag'/}, 
     2 powerfull PAD tags.
{/common:block}

{common:table}
  {common:demo}
    {format:auto 'myData'}
  ( "red", "green", "blue" ) 
{/format:auto}
  {/common:demo}
  {common:demo}
    {pad:content 'myContent'}
  <b> <font color="{$myData}"> Hello World </font> </b> <br>
{/pad:content}
  {/common:demo}
  {common:demo}
    {pad:pad data='myData', content='myContent'/}
  {/common:demo}
{/common:table}

action:   {sequence '1..4', push='catAct'/}{action catAct, reverse}{$sequence},{/action}
bool:     {bool 'catB'}1{/bool}{bool:catB}yes{/bool:catB}
break:    {data 'catBr'}[1,2,3,4]{/data}{catBr}{$catBr},{if $catBr eq 2}{break 'catBr'/}{/if}{/catBr}
case:     {case 'blue'}{when 'red'}stop{when 'blue'}go{/case}
cease:    {data 'catCe'}[1,2,3,4]{/data}{catCe}{$catCe},{if $catCe eq 2}{cease 'catCe'/}{/if}{/catCe}
continue: {data 'catCo'}[1,2,3]{/data}{catCo}{if $catCo eq 2}{continue 'catCo'/}{/if}{$catCo},{/catCo}
curl:     {curl 'SELF://regression2/?pairing&padInclude'}
decrement: {set $catI = 5/}{decrement $catI/}{$catI}
dir:      {dir '{$catDir}'}{$dir}{notLast} {/notLast}{/dir}
exists:   {exists 'hello/index.pad'}y{/exists}{exists 'nope.xyz'}n{/exists}
false:    {false}n{/false}.
files:    {files 'hello', base='app', onlyFiles}{$item}.{$ext}{notLast} {/notLast}{/files}
flag:     {flag prime, rows=6, from=10}{$sequence},{/flag}
foo:      {foo}
get:      {get 'pairing'}
ignore:   {ignore}{a} {b}{/ignore}
keep:     {keep prime, rows=4, from=10}{$sequence},{/keep}
make:     {make:fibonacci rows=3}{$sequence},{/make:fibonacci}
null:     {null}n{/null}.
output:   {output 'web'}.
pull:     {sequence '1..3', push='catPu'/}{pull 'catPu'}{$sequence},{/pull}
remove:   {remove prime, rows=6, from=10}{$sequence},{/remove}
resume:   {sequence '1..4', push='catRe'/}{resume add=10}{pull:catRe}{$sequence},{/pull:catRe}
sandbox:  {sandbox}{echo 'in'}{/sandbox}
tidy:     {tidy}<p ><b >x</b ></p >{/tidy}
until:    {set $catU = 0/}{until $catU eq 3}{increment $catU/}{$catU},{/until}
marker:   @tidy@
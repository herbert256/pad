{pad:meta title='Counted and joined', about='The entries are data like any other: a property of the loop, a separator between them.'/}
{pad:set $folder = APP . '_data/filesDemo/archive'/}
<p>{pad:dir $folder}{property:first@dir}{property:count@dir/} reports: {/property:first@dir}{property:notFirst@dir}, {/property:notFirst@dir}{$dir}{/pad:dir}</p>

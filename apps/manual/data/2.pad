{common:table}{common:demo}

{pad:data 'myXML'}
  <data>
    <row name="bob"   phone="555-1111" />
    <row name="jim"   phone="555-2222" />
    <row name="joe"   phone="555-3333" />
    <row name="jerry" phone="555-4444" />
  </data>
{/pad:data}

{pad:data 'myJSON'}
  [ { "name": "bob",   "phone": "555-5555" },
    { "name": "jim",   "phone": "555-6666" },
    { "name": "joe",   "phone": "555-7777" },      
    { "name": "jerry", "phone": "555-8888" } ]
{/pad:data}

{pad:data 'myYAML'}
  ---
  - name: bob
    phone: 555-3425
  - name: jim
    phone: 555-4364
  - name: joe
    phone: 555-3422
  - name: jerry
    phone: 555-4973
{/pad:data}

{pad:data 'myCSV'}
  name,phone
  bob,555-3425
  jim,555-4364
  joe,555-3422
  jerry,555-4973
{/pad:data}

{pad:data 'myList'}
  ( 'myXML', 'myJSON', 'myYAML', 'myCSV' )
{/pad:data}

{/common:demo}{common:demo}

{data:myList}
  <p>
    <table border=1>
      <tr>
        <th colspan="2">
          {$myList}
        </th>
      </tr>
      {pad:pad data='{$myList}'}
        <tr>
          <td>{$name}</td> 
          <td>{$phone}</td>
        </tr>
      {/pad:pad}
    </table>
  </p>
{/data:myList}

{/common:demo}{/common:table}

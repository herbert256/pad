{pad:meta title='A named section', about='The squares are computed on the first request and served from the cache for the next ten minutes.'/}
{pad:cache 'cacheSquares', ttl=600}
  <p>{sequence:range '1..8', name='n'}{$n | * @}{property:notLast@n}, {/property:notLast@n}{/sequence:range}</p>
{/pad:cache}

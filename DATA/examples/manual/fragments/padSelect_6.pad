{customers fields="country, count(*) as n", group="country", having="count(*) >= 10", order="n desc"}
  <p>{$country}: {$n} customers</p>
{/customers}

{payments fields="year(paymentDate) as year, sum(amount) as total", group="year", rollup}
  <p>{if $year}{$year}{else}All years{/if}: {$total}</p>
{/payments}

{pad:meta title='Types by group'/}
<h1>Types by group</h1>
<p class="lead">Core tag types by what they reach, in {$groupCount} groups.</p>

<nav class="jump" aria-label="Groups">{array:groups}<a href="#{$key}">{$label}</a>{/array:groups}</nav>

{array:groups}
<section class="section" id="{$key}">
  <div class="section-head"><h2>{$label}</h2><span>{$tagline} - {$count} {pad:echo $count eq 1 ? 'type' : 'types'/}</span></div>
  <ul class="list">
    {array:types}
    <li><a class="name" href="?{$link}">{$key}</a> <span class="about">{$about}</span></li>
    {/array:types}
  </ul>
</section>
{/array:groups}

{pad:content 'c'}yes{pad:else}no{/pad:content}{pad:content 'w'}{pad:when 1}one{pad:when 3}three{pad:else}other{/pad:content}{pad:content 'e'}Y@else@N{/pad:content}1[{pad:if $x eq 3, content='c'}<b>@content@</b>{/pad:if}] 2[{pad:if $x eq 2, content='c'}<b>@content@</b>{/pad:if}] 3[{pad:case $x, content='w'}<i>@content@</i>{/pad:case}] 4[{pad:case 7, content='w'}<i>@content@</i>{/pad:case}] 5[{pad:if $x eq 3, content='e'}<b>@content@</b>{/pad:if}] 6[{pad:if $x eq 2, content='e'}<b>@content@</b>{/pad:if}]

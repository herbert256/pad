{pad:meta title='Per row of a cached loop', about='Each part gets the fields of its row back, so the stock is looked up live for every cached product.'/}
{pad:cache 'top-products', ttl=300}
  <ul>
  {app:topProducts}
    <li>{$name} {pad:nocache}- {app:stock $id/} left{/pad:nocache}</li>
  {/app:topProducts}
  </ul>
{/pad:cache}

{sequence '1..5', push='nums'}
a[{fibonacci rows=6, reverse}{$fibonacci}/{$sequence} {/fibonacci}]
b[{fibonacci rows=6, last=2}{$fibonacci}/{$sequence} {/fibonacci}]
c[{fibonacci rows=6, sum}{$fibonacci}/{$sequence} {/fibonacci}]
d[{fibonacci rows=5, make, multiply=2, reverse}{$fibonacci}/{$multiply}/{$sequence} {/fibonacci}]
e[{fibonacci rows=6, name='f', reverse}{$fibonacci}/{$f} {/fibonacci}]
f[{nums reverse}{$nums} {/nums}]
g[{pull:nums reverse}{$nums}/{$sequence} {/pull:nums}]
h[{nums sum}{$nums}{/nums}]

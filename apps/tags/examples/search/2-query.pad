{meta title='Phrases, prefixes, words left out', about='A phrase must be there, a prefix stands for every word that begins so, a minus leaves a row out.'/}
<ul>
  <li>"a dragon": {search 'collectionBooks', q='"a dragon"'}{$title} {/search}</li>
  <li>adv*: {search 'collectionBooks', q='adv*'}{$title} {/search}</li>
  <li>planet -spice: {search 'collectionBooks', q='planet -spice'}{$title} {/search}</li>
</ul>

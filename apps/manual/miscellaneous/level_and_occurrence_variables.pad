{common:table}{common:demo}

{pad:set $range = 10/}

<table border=1>

  <tr>
    <th>Level</th>
    <th>Occurence</th>
  </tr>

  {sequence:auto range='1..5', $abc=$range, %xyz=$range} 
        <tr>
          <td>{$abc}</td>
          <td>{$xyz}</td>
        </tr>
  {/sequence:auto}

</table>

{/common:demo}{common:demo}
<table border=1>

  <tr>
    <th>Name</th>
    <th>Salary</th>
    <th>Bonus</th>
    <th>Total</th>
  </tr>
  
  {local:staff %total = $salary + $bonus}

    <tr align="right">
      <td align="left">{$name}</td>
      <td>{$salary | %.2f}</td>
      <td>{$bonus  | %.2f}</td>
      <td>{$total  | %.2f}</td>
    </tr>

  {/local:staff}
 
</table>

{/common:demo}{/common:table}

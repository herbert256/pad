{pad:meta title='In front of a pipe', about='A literal or an expression goes through pipe functions; arithmetic pipes need a space after the operator.'/}
<p>{pad:echo '  hello world  ' | trim | upper/}</p>
<p>{pad:echo 20 | + 1 | * 2/}</p>
<p>{pad:echo 'herbert@example.com' | after('@') | before('.')/}</p>

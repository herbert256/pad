a[{sequence '1..10', keep='even', multiply=3}{$sequence} {/sequence}]
b[{sequence '1..10', multiply=3, keep='even'}{$sequence} {/sequence}]
c[{sequence '1..10', remove='odd', add=100}{$sequence} {/sequence}]
d[{sequence '1..10', flag='prime', add=1}{$sequence} {/sequence}]
e[{sequence '1..10', keep, odd, remove='square', prime}{$sequence} {/sequence}]

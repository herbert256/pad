{sequence:list '5;10;15;20',  name='q1'/}
{sequence:list '15;20;25;30', name='q2'/}
{sequence:list '15;20',       name='q3'/}

{pad:if q3 eq sequence:intersection ( q1,           q2            )} ok @else@ nok {/pad:if}
{pad:if q3 eq sequence:intersection ( q1,           [15,20,25,30] )} ok @else@ nok {/pad:if}
{pad:if q3 eq sequence:intersection ( [5,10,15,20], q2            )} ok @else@ nok {/pad:if}
{pad:if q3 eq sequence:intersection ( [5,10,15,20], [15,20,25,30] )} ok @else@ nok {/pad:if}

{pad:if q3 ne sequence:intersection ( q1,           q2            )} nok @else@ ok {/pad:if}
{pad:if q3 ne sequence:intersection ( q1,           [15,20,25,30] )} nok @else@ ok {/pad:if}
{pad:if q3 ne sequence:intersection ( [5,10,15,20], q2            )} nok @else@ ok {/pad:if}
{pad:if q3 ne sequence:intersection ( [5,10,15,20], [15,20,25,30] )} nok @else@ ok {/pad:if}

<hr>

{sequence:range '3..5', name='abc'/}

{pad:if 4 in abc }  ok @else@ nok {/pad:if}
{pad:if 6 in abc } nok @else@  ok {/pad:if}

<hr>

{pad:if 3 eq sequence:count(abc)}  ok @else@ nok {/pad:if}
{pad:if sequence:count(abc) eq 4} nok @else@  ok {/pad:if}

<hr>

{pad:if 3 in sequence:count(abc)}  ok @else@ nok {/pad:if}
{pad:if 4 in sequence:count(abc)} nok @else@  ok {/pad:if}

{sequence:range '8..10', name='q1'/}
{sequence:range '1..10', name='q2'/}

<hr>

{pad:if q1 eq sequence:last(q2,3)}  ok @else@ nok {/pad:if}
{pad:if q1 ne sequence:last(q2,3)} nok @else@  ok {/pad:if}

<hr>

{pad:if [9,10] ne sequence:last ( q2,      2) } nok @else@  ok {/pad:if}
{pad:if [8,9]  eq sequence:last ( [7,8,9], 2) }  ok @else@ nok {/pad:if}

{pad:meta title='With an else', about='{pad:cannot} owns its {pad:else} too: the part after it renders when the gate says yes.'/}
{pad:set $note = [ 'title' => 'Minutes', 'published' => TRUE, 'author' => 7 ]/}
{pad:cannot 'edit-post', $note}
  <p>You cannot change these minutes.</p>
{pad:else}
  <p><a href="#edit">Change the minutes</a></p>
{/pad:cannot}

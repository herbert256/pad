{demo}{echo '2026-10-18' | date('l')}{/demo}
{demo}{echo '2026-10-18' | date('Y-m-d', '+1 week')}{/demo}
{demo}{echo '2026-10-18 14:30' | date('H:i')}{/demo}
{demo}{echo date('Y', 1000000000)}{/demo}

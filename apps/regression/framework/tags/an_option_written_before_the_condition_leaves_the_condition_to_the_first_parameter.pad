{pad:set $i = 0/}A[{pad:while name='w', $i lt 3}{pad:increment $i/}{$i}{/pad:while}]
{pad:set $i = 0/}B[{pad:until name='u', $i ge 3}{pad:increment $i/}{$i}{/pad:until}]
{pad:set $i = 5/}C[{pad:if name='f', $i lt 3}yes{pad:else}no{/pad:if}]
D[{pad:case name='c', $i}{pad:when 5}five{pad:else}other{/pad:case}]

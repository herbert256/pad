<article class="tag">

  <nav class="crumbs" aria-label="Where you are">
    <a href="?index">Types</a><span>/</span><a href="?groups#{$typeGroupKey}">{$typeGroupLabel}</a><span>/</span><span aria-current="page">{$typeKey}</span>
  </nav>

  <header class="tag-head">
    <h1>{$typeKey}</h1>
    <p class="tag-about">{$typeAbout}</p>
    <p class="chips"><a class="chip" href="?groups#{$typeGroupKey}">{$typeGroupLabel}</a>
    {if $typeBare}<a class="chip chip-form" href="?order#bare">Tried {$typeOrder} of {$typeOrderCount} for a bare name</a>{else}<a class="chip chip-form" href="?order#prefixed">Only with its prefix</a>{/if}</p>
  </header>

  <section class="block" aria-labelledby="syntax">
    <h2 id="syntax">Syntax</h2>
    <pre class="code"><code>{!typeSyntaxHtml}</code></pre>
  </section>

  <section class="block prose" aria-labelledby="description">
    <h2 id="description">Description</h2>
    {!typeDocHtml}
    {if $typeComment}<h3>The handler</h3><p><code>pad/types/{$typeName}.php</code>: {$typeComment}</p>{/if}
  </section>

  {typeMembers}
  {first@typeMembers}<section class="block" aria-labelledby="members"><h2 id="members">What it reaches by name</h2><p>{$typeMemberCount} of them{if $typeName in ('pad', 'chart', 'game', 'toy', 'diagram', 'widget', 'barcode', 'embed', 'input', 'icon', 'fake', 'sequence', 'flag', 'make', 'keep', 'remove')}, each with its page in the tags application{/if}.</p><div class="tagcloud">{/first@typeMembers}
    {if $link}<a href="{$link}">{$key}</a>{else}<span>{$key}</span>{/if}
  {last@typeMembers}</div></section>{/last@typeMembers}
  {/typeMembers}

  {typeExamples}
  {first@typeExamples}<section class="block" aria-labelledby="examples"><h2 id="examples">Examples</h2>{/first@typeExamples}
    <div class="example" id="example-{$number}">
      <h3>{$title}</h3>
      {if $about}<p class="example-about">{$about}</p>{/if}
      <div class="example-grid{if not $run} is-static{/if}">
        <div class="cell">
          <div class="cell-head"><span>Template</span><span class="cell-file">{$file}</span></div>
          <pre class="code"><code>{!padHtml}</code></pre>
          {if $php}
          <div class="cell-head"><span>PHP</span><span class="cell-file">{$php}</span></div>
          <pre class="code"><code>{!phpHtml}</code></pre>
          {/if}
        </div>
        {if $run}
        <div class="cell">
          <div class="cell-head"><span>Result</span><span><a class="cell-file" href="?{$page}">open alone</a>{!play}</span></div>
          <div class="result">{page $page/}</div>
        </div>
        {/if}
      </div>
    </div>
  {last@typeExamples}</section>{/last@typeExamples}
  {/typeExamples}

  <nav class="prevnext" aria-label="Other types">
    <a href="?type/{$typePrev}">&larr; {$typePrev}:</a>
    <a href="?names">All types A-Z</a>
    <a href="?type/{$typeNext}">{$typeNext}: &rarr;</a>
  </nav>

</article>

<style>
  .apps-list { border-collapse: collapse; margin: 0 auto; }
  .apps-list th { text-align: left; padding: 8px 16px; border-bottom: 2px solid #999; }
  .apps-list td { padding: 6px 16px; border-bottom: 1px solid #ccc; vertical-align: top; }
  .apps-list a { text-decoration: none; }
  .apps-list a:hover { text-decoration: underline; }
</style>

<p>{$appCount} applications</p>

<table class="apps-list">
  <tr>
    <th>Application</th>
    <th>Description</th>
    <th>Code</th>
  </tr>
  {array:apps}
  <tr>
    <td>
      {pad:if $link ne ''}<a href="{$link}">{$name}</a>{/pad:if}
      {pad:if $link eq ''}{$name}{/pad:if}
    </td>
    <td>
      {pad:if $description ne ''}{$description}{/pad:if}
      {pad:if $description eq ''}<i>No description available</i>{/pad:if}
    </td>
    <td>{pad:if $name ne 'wasm'}<a href="{$padRoot}edit/?index&app={$name}">edit</a>{/pad:if}</td>
  </tr>
  {/array:apps}
</table>

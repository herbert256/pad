{common:table}
{common:demo}[{pad:echo 10 | gt 5/}]{/common:demo}
{common:demo}[{pad:echo 'abc' | eq 'abc'/}]{/common:demo}
{common:demo}[{pad:echo 7 | in (1, 7)/}]{/common:demo}
{common:demo}[{pad:echo 5 | * 2 gt 9/}]{/common:demo}
{common:demo}{pad:echo '' | ?? 'empty'/}{/common:demo}
{common:demo}{pad:echo 3 | - 1 . ' left'/}{/common:demo}
{/common:table}

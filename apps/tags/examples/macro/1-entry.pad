{meta title='Values in order or by name', about='The macro declares a required label and an optional type; the uses give them either way.'}
{macro 'macroEntry', label, type='text'}<p><label>{$label} <input type="{$type}" name="{$label}"></label></p>{/macro}
{macroEntry 'E-mail', 'email'}
{macroEntry label='Name'}

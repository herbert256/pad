# The demo database this application's pages query - read with padEnv.

padSqlHost=127.0.0.1
padSqlDatabase=demo
padSqlUser=demo
padSqlPassword=demo

# The support database, for the pages under select/support/ - their _lib/database.php
# reads these four, beside the demo database of the rest of the application.

padSqlSupportHost=127.0.0.1
padSqlSupportDatabase=support
padSqlSupportUser=support
padSqlSupportPassword=support

{common:padFrame}

  {slot 'head'}
    <meta name="robots" content="noindex">
    {asset 'admin.css', tag}
    {asset 'admin.js', tag}
  {/slot}

  {slot 'foot'}
    {if $adminIn}
      <div class="frame-foot">
        {icon 'user', size=16} {$adminWho} <span class="dim">on {$adminHost}</span>
        <form method="post" action="?logout"><button>{icon 'log-out', size=16} Log out</button></form>
      </div>
    {/if}
  {/slot}

{/common:padFrame}

{if $adminIn}
  {flash}<p class="flash {$type}" role="status">{$message}</p>{/flash}
{/if}

@page@

{common:padFrameEnd}

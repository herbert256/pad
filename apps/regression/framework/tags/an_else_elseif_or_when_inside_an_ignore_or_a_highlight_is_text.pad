1[{pad:if $a}{pad:ignore}x{pad:else}y{/pad:ignore}A{pad:else}B{/pad:if}]
2[{pad:if 0}A{pad:ignore}{pad:else}{/pad:ignore}B{pad:else}C{/pad:if}]
3[{pad:if $a}Write {pad:ignore}{pad:elseif $x}{/pad:ignore} for another branch{/pad:if}]
4[{pad:if 0}A{pad:ignore}x {pad:elseif 1} y{/pad:ignore}B{/pad:if}]
5[{pad:case $a}{pad:when 1}Write {pad:ignore}{pad:when 2}{/pad:ignore} for a branch{pad:else}other{/pad:case}]
6[{pad:case 2}{pad:when 1}one {pad:ignore}{pad:when 2}{/pad:ignore} done{pad:when 3}three{/pad:case}]
7[{pad:guest}Write {pad:ignore}{pad:else}{/pad:ignore} for the default{/pad:guest}]
8[{pad:if 1}A{pad:highlight 'pad'}{pad:else}{/pad:highlight}B{/pad:if}]

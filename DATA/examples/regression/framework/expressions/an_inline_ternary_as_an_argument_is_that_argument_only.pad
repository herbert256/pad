{set $n = 5}{set $s = 'banana'}{set $z = 0}[{echo $s | replace('a', $n gt 1 ? 'x' : 'y')}][{echo php:str_repeat('-', $n gt 0 ? $n : 1)}][{echo php:str_repeat($n gt 0 ? '+' : '-', 3)}][{echo php:max($n gt 3 ? 1 : 9, $z ? 4 : 2)}][{echo php:max($z ? 1 : php:min(8, 7), 3)}][{echo php:implode('-', [1, $n gt 3 ? 2 : 0, 3])}][{echo $s | replace('a', $n gt 9 ? 'x' : $n gt 4 ? 'm' : 's')}]

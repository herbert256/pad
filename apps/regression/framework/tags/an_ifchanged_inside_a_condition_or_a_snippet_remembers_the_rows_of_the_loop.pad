[{items}{guest}{ifchanged $g}<{$g}>{/ifchanged}{/guest}{$n} {/items}]
[{items}{true}{ifchanged $g}<{$g}>{/ifchanged}{/true}{$n} {/items}]
[{items}{notFirst@items}{ifchanged $g}|{/ifchanged}{/notFirst@items}{$n} {/items}]

{pad:meta title='A directory counts too', about='file_exists answers TRUE for a directory as well, so the tag cannot tell a file from a folder.'/}
{pad:set $archive = APP . '_data/filesDemo/archive'/}
{pad:set $old     = APP . '_data/filesDemo/old'/}
<p>archive: {pad:exists $archive}there@else@missing{/pad:exists}</p>
<p>old: {pad:exists $old}there@else@missing{/pad:exists}</p>

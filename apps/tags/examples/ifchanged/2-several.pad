{pad:meta title='Several values and @else@', about='A change in either value renders the heading; an unchanged row renders the @else@ part.'/}
{format:auto 'ifchangedPosts'}
year,month,post
2026,September,Launch
2026,September,First fix
2026,October,Autumn release
2027,October,Next year
{/format:auto}
<ul>
  {data:ifchangedPosts}
    <li>{pad:ifchanged $year, $month}<strong>{$month} {$year}</strong>@else@&mdash; same month{/pad:ifchanged}: {$post}</li>
  {/data:ifchangedPosts}
</ul>

<p>Have a question or feedback? Send us a message!</p>

{flash}
  <div class="message">{$message}</div>
{/flash}

{form 'contact', error='Please correct the errors below.'}

  <p>{input 'name', label='Your Name: *', rules='required|max:100'}</p>

  <p>{input 'email', type='email', label='Your Email: *', rules='required|email'}</p>

  <p>{input 'subject', label='Subject: *', rules='required|max:200'}</p>

  <p>{textarea 'message', label='Message: *', rows=6, rules='required|max:2000'}</p>

  <p>
    <input type="submit" value="Send Message">
  </p>

{/form}

<p style="color: #999; font-size: 12px;">* Required fields</p>

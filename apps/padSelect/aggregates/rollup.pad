<table>
  <tr>
    <th>Genre</th>
    <th class="n">Albums</th>
    <th class="n">Price of them all</th>
  </tr>
  {select:albums fields="genre_code, count(*) as n, sum(price) as total", group="genre_code", rollup}
    <tr>
      <td>{select:genres}{$genre}@else@<b>All genres</b>{/select:genres}</td>
      <td class="n">{$n}</td>
      <td class="n">{$total}</td>
    </tr>
  {/select:albums}
</table>

{common:table}
{common:demo}[{pad:echo 'NL1234' matches '/^[A-Z][A-Z][0-9]+$/'/}]{/common:demo}
{common:demo}[{pad:echo 'a.b' matches '/a\\.b/'/}] [{pad:echo 'axb' matches '/a\\.b/'/}]{/common:demo}
{common:demo}[{pad:echo 'Hello' matches '/^h/i'/}] [{pad:echo 'Hello' matches '/^h/'/}]{/common:demo}
{common:demo}[{pad:echo 'Hello' not matches '/^h/'/}]{/common:demo}
{/common:table}

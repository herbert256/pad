{meta title='Search'/}
<h1>Search</h1>

{if $typesSearch eq ''}
  <p class="lead">Type a word in the search box - a type's name, a word of what it reaches, or a tag it has.</p>
{elseif $hits eq 0}
  <p class="lead">No type matches <strong>{$typesSearch}</strong>. Try the <a href="?names">list by name</a>.</p>
{else}
  <p class="lead">{$hits} {echo $hits eq 1 ? 'type matches' : 'types match'/} <strong>{$typesSearch}</strong>.</p>
  <ul class="list">
    {found}
    <li><a class="name" href="?{$link}">{$key}</a> <span class="about">{$about} <a class="meta" href="?groups#{$group}">{$groupLabel}</a></span></li>
    {/found}
  </ul>
{/if}

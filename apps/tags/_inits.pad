{common:padFrame}
  {pad:slot 'head'}
    {pad:asset 'tags.css', tag/}
  {/pad:slot}

  {pad:slot 'title'}
    <form class="search" action="" method="get" role="search">
      <input type="hidden" name="search" value="">
      <label class="sr-only" for="q">Search the tags and kinds</label>
      <input type="search" id="q" name="q" value="{$tagsSearch}" placeholder="Search {$tagsCount} entries" autocomplete="off">
    </form>
  {/pad:slot}
{/common:padFrame}

@page@

<footer class="foot">
  <p>{$tagsCount} tags and kinds of PAD, with syntax and usage examples. Safe, self-contained examples run here; examples requiring credentials, delivery or application files are shown as source.</p>
</footer>

{common:padFrameEnd/}

{block}
  <center>

    {if $casesCount gt 0}
      <p>
        <a href="?cases{?xref}{?type}{?item}">Covered by {$casesCount} tests</a>
        in {$casesGroups}
      </p>
    {/if}

    {go}
      <hr>
      App: {$app} - Page: {$page}
      <br> {example '{$page}', app='{$app}'} <br>
    {/go}

  </center>
{/block}
[{sequence:prime 5, page=2}{$prime} {/sequence:prime}{widget:pager 'prime'}{$kind}:{$page} {/widget:pager}][{sequence:loop 4, page=3}{$sequence} {/sequence:loop}{widget:pager 'sequence'}{$kind}:{$page} {/widget:pager}]{pad:set $n = 10 ** 30/}[{sequence:range '1..5', page=1, rows=$n}{$sequence} {/sequence:range}][{sequence:range '1..5', page=$n, rows=2}{$sequence} {/sequence:range}{widget:pager 'sequence'}{$kind}:{$page} {/widget:pager}]

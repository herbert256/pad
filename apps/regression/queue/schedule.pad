<table>
{entries}  <tr><td>{$name}</td><td>{$cron}</td><td>{$queue}</td><td>{$next}</td></tr>
{/entries}</table>
<ul>
{faults}  <li>fault: {$name} ({$job}): {$error}</li>
{/faults}</ul>
<ul>
{due}  <li>{$at}: {$names}</li>
{/due}</ul>
<ul>
{ran}  <li>round {$round}: {$name} {$status}</li>
{/ran}</ul>
<p>heard: {$heard}</p>
<p>again: ran {$againRuns} time, the asker inside it found it {$againInner}</p>

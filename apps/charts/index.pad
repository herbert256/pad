<div class="page home">
  <section class="hero">
    <div class="hero-text">
      <span class="kicker">PAD · {pad:ignore}{chart:bar}{/pad:ignore}</span>
      <p class="lead">One tag turns rows of JSON, YAML, CSV or PHP into an accessible SVG chart -
      lines, areas, streams, bars, funnels, pyramids, waterfalls, pies, waffles, marimekkos,
      parliaments, venns, gauges, radars, roses, bullets, histograms, violins, error bars, ecdfs, ridgelines, likert scales, scatters, hexbins, heatmaps,
      candlesticks, dumbbells, spirals, sankeys, chords, networks, treemaps, packs, org charts and gantt
      charts. No JavaScript, so it prints, caches and shows up in an e-mail.</p>
      <ul class="stats">
        <li><b>{$kindCount}</b> kinds</li>
        <li><b>{$exampleCount}</b> examples</li>
        <li><b>0</b> lines of JavaScript</li>
      </ul>
    </div>
    <a class="hero-card" href="?sankey/energy" aria-label="Open the energy sankey">
      {pad:page 'sankey/energy'/}
    </a>
  </section>

  {array:families}
    <section class="family" id="{$family}">
      <header class="family-head">
        <h2>{$label}</h2>
        <span class="family-line">{$tagline}</span>
      </header>
      <div class="cards">
        {array:examples}
          <a class="card" href="?{$page}">
            <span class="card-chart">{pad:page $page/}</span>
            <span class="card-body">
              <span class="card-title">{$title}</span>
              <span class="card-text">{$text}</span>
            </span>
          </a>
        {/array:examples}
      </div>
    </section>
  {/array:families}
</div>

{common:showcaseExamples/}

# The PAD home's environment values, read with padEnv - see pad/lib/env.php. Every
# application reads this file last, after its own .env (and _common's when it runs with
# _common); a value in the real environment of the server wins over all of them.

# The engine's own database

padSqlPadHost=127.0.0.1
padSqlPadDatabase=pad
padSqlPadUser=pad
padSqlPadPassword=pad

# The application database - 'mysql' on the four values, or 'sqlite' on the file
# padSqlDatabase names, built from padSqlSetup the first time

padSqlHost=127.0.0.1
padSqlDatabase=app
padSqlUser=app
padSqlPassword=app

padSqlDriver=mysql
padSqlSetup=

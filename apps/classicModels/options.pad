<p>where: {select:offices where="country = 'USA'", order='officeCode'}{$officeCode},{/select:offices}</p>
<p>distinct: {select:offices distinct, fields='country', order='country'}{$country},{/select:offices}</p>
<p>distinctrow: {select:offices distinctrow, fields='country', order='country'}{$country},{/select:offices}</p>
<p>group: {select:payments fields='customerNumber, count(*) as cnt', group='customerNumber', having='cnt > 9', order='customerNumber'}{$customerNumber}={$cnt},{/select:payments}</p>
<p>rollup: {select:offices key='', fields='count(*) as cnt', group='country', rollup}{property:last@offices}{$cnt}{/property:last@offices}{/select:offices}</p>
<p>db: {select:sales db='employees', where="jobTitle = 'President'"}{$lastName}{/select:sales}</p>
<p>key: {select:offices key='city', where="country = 'USA'"}{$city},{/select:offices}</p>
<p>union: {select:offices where="officeCode = 1", union='offices'}{$officeCode},{/select:offices}</p>
<p>join: {select:employees join='offices on employees.officeCode = offices.officeCode', where="offices.city = 'Boston'", order='lastName'}{$lastName},{/select:employees}</p>
<p>htmlAttrJson: {select:offices htmlAttrJson='record', fields='officeCode', where="officeCode = 1"/}</p>

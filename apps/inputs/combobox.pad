    Brussels
    Lisbon
    London
    Madrid
    Paris
    Prague
    Rome
    Vienna
  {/input:combobox}
  {input:combobox 'fruit', label='Fruit', options='Apple, Apricot, Banana, Cherry, Grape, Lemon, Mango, Orange, Pear'/}
  <button class="inputs-send">Send</button>
{/input:form}


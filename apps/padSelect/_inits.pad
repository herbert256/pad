{common:padFrame}
  {slot 'head'}{asset 'padSelect.css', tag/}{/slot}
{/common:padFrame}
{if $isExample}
<div class="ps-example">

  <p class="ps-crumb"><a href="?index">PAD Select</a> <span>/</span> {$exampleGroup}</p>
  <p class="ps-lead">{$exampleText}</p>

  <div class="ps-cells">

    <section class="ps-cell ps-cell-decl" aria-label="The declarations">
      <header class="ps-head"><span class="ps-num">1</span> The declarations</header>
      {if $modelHtml ne ''}
      <p class="ps-file">_lib/select.php &mdash; the part this example reaches, <a href="?model">the whole model</a></p>
      <pre class="ps-code"><code>{!modelHtml}</code></pre>
      {/if}
      {if $phpHtml ne ''}
      <p class="ps-file">{$padPage}.php</p>
      <pre class="ps-code"><code>{!phpHtml}</code></pre>
      {/if}
    </section>

    <section class="ps-cell ps-cell-tpl" aria-label="The template">
      <header class="ps-head"><span class="ps-num">2</span> The template <span class="ps-file">{$padPage}.pad</span></header>
      <pre class="ps-code"><code>{!tagHtml}</code></pre>
    </section>

    <section class="ps-cell ps-cell-result" aria-label="The result">
      <header class="ps-head"><span class="ps-num">3</span> The result</header>
      <div class="ps-canvas">
{/if}
@page@
{if $isExample}
      </div>
    </section>

    <section class="ps-cell ps-cell-sql" aria-label="The SQL">
      <header class="ps-head"><span class="ps-num">4</span> The SQL PAD sent</header>
      {statements/}
    </section>

  </div>

  <nav class="ps-pager" aria-label="More examples">
    <a href="?{$prevPage}"><small>&larr; Previous</small>{$prevTitle}</a>
    <a href="?{$nextPage}" class="ps-next"><small>Next &rarr;</small>{$nextTitle}</a>
  </nav>

</div>
{/if}
{common:padFrameEnd/}

{pad:live 'note'}
<article class="sheet color-{$note.color}">

  <div class="crumbs"><a href="{$padGo}index">← All notes</a></div>

  <div class="meta">
    <span>Changed {$note.day}</span>
    <span>Written {$note.born}</span>
    {array:noteTags}<a class="tag" href="{$padGo}index{?tag}">#{$tag}</a>{/array:noteTags}
  </div>

  <div class="controls">
    <button type="button" class="toggle" pad-click="pin" aria-pressed="{pad:if $note.pinned}true{pad:else}false{/pad:if}">★ {pad:if $note.pinned}Pinned{pad:else}Pin{/pad:if}</button>
    <div class="swatches" role="group" aria-label="Colour">
      {array:swatches}<button type="button" class="swatch color-{$key}" pad-click="color" pad-value="{$key}" aria-pressed="{$on}" title="{$label}" aria-label="{$label}"></button>{/array:swatches}
    </div>
  </div>

  <div class="body">{$note.body | markdown}</div>

  {pad:if $fileCount gt 0}
  <section class="files">
    <h2>Files</h2>
    <ul>
      {array:noteFiles}
      <li>
        {pad:if $picture}<a href="{$padGo}file&id={$id}"><img src="{$padGo}file&id={$id}" alt="{$name}" loading="lazy"></a>{pad:else}<a class="doc" href="{$padGo}file&id={$id}" aria-label="Open {$name}">📄</a>{/pad:if}
        <div class="about">
          <a href="{$padGo}file&id={$id}&download" download="{$name}" title="Download {$name}">{$name}</a>
          <span>{$bytes}</span>
          {input:form 'detach'}<input type="hidden" name="attachment" value="{$id}"><button class="remove" title="Remove {$name}" aria-label="Remove {$name}">×</button>{/input:form}
        </div>
      </li>
      {/array:noteFiles}
    </ul>
  </section>
  {/pad:if}

  <div class="actions">
    <a class="button primary" href="{$padGo}edit&id={$note.id}">Edit</a>
    <details>
      <summary class="button danger">Delete…</summary>
      {input:form 'delete'}<span>Delete this note and its files?</span><button class="button danger">Delete</button>{/input:form}
    </details>
  </div>

</article>
{/pad:live}

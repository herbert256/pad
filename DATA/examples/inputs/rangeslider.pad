{pad:meta title='Range slider'/}
{include:about/}

{pad:form 'try', class='inputs-try', error}
  {input:rangeslider 'price', label='Price', min=0, max=500, step=10, unit=' EUR', value='100, 400'/}
  {input:rangeslider 'age', label='Age', min=18, max=99, names='age_min, age_max', labels='Youngest, Oldest'/}
  <button class="inputs-send">Send</button>
{/pad:form}

{include:received/}

{include:template/}

{pad:meta title='A new name every time', about='date, stamp and id add the date, a time stamp or a unique id to the name, so one run does not overwrite the last.'/}
{pad:file dir='reports', name='daily', ext='html', date, stamp}
  <h1>Report</h1>
  {array:sales}<p>{$region}: {$amount}</p>{/array:sales}
{/pad:file}

{holidays:auto 'pt', year=2026}{$date} {$local} {$type}|{/holidays:auto}
{holidays:auto 'pt', year=2014, where='$type eq "public"'}{$date} {$name}|{/holidays:auto}
{holidays:auto 'pt-30', from='2024-01-01', to='2025-12-31', where='$region'}{$date} {$name}|{/holidays:auto}
{holidays:auto 'pt-20', year=2026, where='$region'}{$date} {$local}|{/holidays:auto}

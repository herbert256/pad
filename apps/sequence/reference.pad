<blockquote>

{common:block}

  {pad:pad data='reference'}

    {sequence:range '1..{$lvl}'}
      <blockquote>
    {/sequence:range}

    <h3>{$type}</h3>

    <blockquote>

      {php:getXref '{$dir}'}

        <a href="?reference2{?dir}{?type}{?item}">{$item}</a>

        &nbsp; 
        
      {/php:getXref}
            
    </blockquote>

    {sequence:range '1..{$lvl}'}
      </blockquote>
    {/sequence:range}

  {/pad:pad}

{/common:block}

</blockquote>

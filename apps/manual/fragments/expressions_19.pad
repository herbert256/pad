{common:table}
{common:demo}{pad:echo 3 gt 1 ? 'many' : 'one'/}{/common:demo}
{common:demo}{pad:echo 15 gt 10 ? (15 gt 20 ? 'L' : 'M') : 'S'/}{/common:demo}
{common:demo}{pad:echo 15 gt 20 ? 'L' : 15 gt 10 ? 'M' : 'S'/}{/common:demo}
{common:demo}{pad:echo '' ?: 'Untitled'/}{/common:demo}
{common:demo}{pad:echo 'Draft' ?: 'Untitled'/}{/common:demo}
{common:demo}{pad:echo 0 | ? 'some' : 'none'/}{/common:demo}
{common:demo}{pad:echo 0 ? 'yes' : 'no' . '!'/}{/common:demo}
{/common:table}

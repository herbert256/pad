after:      {pad:echo 'a/b' | after('/')/}
afterLast:  {pad:echo 'a/b/c' | afterLast('/')/}
before:     {pad:echo 'a/b' | before('/')/}
beforeLast: {pad:echo 'a.b.c' | beforeLast('.')/}
between:    {pad:echo 17 | between(10, 66)/}.
bold:       {pad:echo 'important' | bold/}
close:      {pad:echo 'array:items' | close | ignore/}
contains:   {pad:echo 12345 | contains('34')/}.
cut:        {pad:echo 'banana' | cut('an')/}
encodeHigh: {pad:echo 'café' | encodeHigh/}
exists:     {pad:echo 'hello/index.pad' | exists/}.
html:       {pad:echo '<b>' | html/}
in:         {pad:echo 'a' | in('a')/}.
left:       {pad:echo 'abcdef' | left(2)/}
like:       {pad:echo 'abc' | like('a%')/}.
max_len:    {pad:echo 'abcdef' | max_len(4)/}
mid:        {pad:echo 'abcdef' | mid(2, 3)/}
nbsp:       {pad:echo 'hello world' | nbsp/}
open:       {pad:echo 'array:items' | open | ignore/}
optional:   {$catNoSuch | optional}ok
range:      {pad:echo 50 | range(0, 100)/}.
replace:    {pad:echo 'abc' | replace('b', 'x')/}
right:      {pad:echo 'abcdef' | right(2)/}
sanitize:   {pad:echo '<b>x</b>' | sanitize/}
slashes:    {pad:echo "it's" | slashes/}
stripLow:   {pad:echo $catLow | stripLow/}
stripslashes: {pad:echo "it's" | slashes | stripslashes/}
tag:        {pad:echo 'array:items' | tag | ignore/}
time:       {pad:echo 1702483200 | time('Y')/}
timestamp:  {pad:echo 1702483200 | timestamp('Y')/}
trim:       {pad:echo '  a b  ' | trim/}
ucwords:    {pad:echo 'hello world' | ucwords/}
white:      {pad:echo 'a       b' | white/}

{local:bakery}
  
  <h2> {$name@current} / {$type@current} </h2>

  {property:batter@current optional} 
    <p> Batter: 
      @start@
        {$batter@batter} 
        {property:notLast} / {/property:notLast} 
      @end@
    </p>
  {/property:batter@current}

  {property:topping@current optional} 
    <p> Topping: 
      @start@
        {$topping@topping} 
        {property:notLast} / {/property:notLast} 
      @end@
    </p>
  {/property:topping@current}
  
  {property:filling@current optional} 
    <p>Filling:
      @start@
        {$name@*}
        {property:notLast} / {/property:notLast} 
      @end@
    </p>
  {/property:filling@current}

{/local:bakery}

{meta title='A copy per visitor, and the option form', about='vary= keeps one rendering per user; cache= on any tag caches that tag the same way.'}
{cache 'basket', ttl=60, vary=$userId}
  {basket}<li>{$product}: {$quantity}</li>{/basket}
{/cache}

{topProducts cache=3600, vary=$country}
  <li>{$name}</li>
{/topProducts}

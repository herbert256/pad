{pad:meta title='After the head of the wrapper', about='In _inits.pad: the head goes out at once, and the browser loads site.css while the page renders.'/}
<!DOCTYPE html>
<html>
<head>
  <title>{$title}</title>
  <link rel="stylesheet" href="{pad:asset 'site.css'/}">
</head>
{pad:flush/}
<body>
  @page@
</body>
</html>

{format:auto 'xs'}
  [1,2,3,4,5]
{/format:auto}
{data:xs first=3}
  {property:first@xs}<ul>{/property:first@xs}<li>{$xs}</li>{property:last@xs}</ul>{/property:last@xs}
{/data:xs}
{data:xs last=2}
  {property:first@xs ? '[' : ''/}{$xs}{property:last@xs ? ']' : ''/}
{/data:xs}
{data:xs first=2}
  {$first@xs}
{/data:xs}

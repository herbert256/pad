{meta title='A closed root that delegates focus', about='The pair straight in a page - mode=\'closed\' and focus, the light DOM slotted.'}
<search-box>
  {shadow mode='closed', focus}
    <label><slot name="label"></slot> <input type="search"></label>
  {/shadow}
  <span slot="label">Search the shop</span>
</search-box>

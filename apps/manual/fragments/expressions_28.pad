{common:table}
{common:demo}[{pad:echo 'b' | in('a', 'b')/}] [{pad:echo in('b', 'a', 'b')/}]{/common:demo}
{common:demo}[{pad:echo 'Alice' | like('A%')/}] [{pad:echo like('Alice', 'A%')/}]{/common:demo}
{common:demo}[{pad:echo 7 | range(1, 9)/}] [{pad:echo range(7, 1, 9)/}]{/common:demo}
{common:demo}[{pad:echo contains('banana', 'nan')/}]{/common:demo}
{/common:table}

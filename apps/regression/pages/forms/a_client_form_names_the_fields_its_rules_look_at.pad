{input:form 'trip', client, error}
<label for="delivery">Delivery</label> <select name="delivery" id="delivery"><option>collect</option><option>ship</option></select>
{input:field 'address', label='Address', rules='required_if:delivery,ship'/}
{input:field 'password', type='password', label='Password'/}
{input:field 'confirm', type='password', label='Confirm', rules='same:password'/}
{input:field 'start', type='date', label='Start'/}
{input:field 'end', type='date', label='End', rules='after:start'/}
{input:field 'kinds[]', type='checkbox', value='gift', label='Gift'/}
{input:field 'card', label='Card text', rules='required_if:kinds[],gift|not_in:none'/}
<button>Send</button>
{/input:form}

a[{sequence:range '1..10', keep='even', multiply=3}{$sequence} {/sequence:range}]
b[{sequence:range '1..10', multiply=3, keep='even'}{$sequence} {/sequence:range}]
c[{sequence:range '1..10', remove='odd', add=100}{$sequence} {/sequence:range}]
d[{sequence:range '1..10', flag='prime', add=1}{$sequence} {/sequence:range}]
e[{sequence:range '1..10', keep, odd, remove='square', prime}{$sequence} {/sequence:range}]

{pad:meta title='A nested menu', about='One body renders every level; branch leaves the inner list out for a leaf.'/}
{format:auto 'treeMenu'}
[
  { "title": "Home" },
  { "title": "Shop", "children": [
      { "title": "Books" },
      { "title": "Music", "children": [ { "title": "Jazz" }, { "title": "Folk" } ] } ] },
  { "title": "Contact" }
]
{/format:auto}
<ul>
{pad:tree 'treeMenu'}
  <li>{$title}{pad:branch}<ul>{pad:recurse/}</ul>{/pad:branch}</li>
{/pad:tree}
</ul>

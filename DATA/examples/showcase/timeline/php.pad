{meta title='Twenty years of PHP', about='The vertical form for a long list - dates on the left, cards on the right - the rows as JSON between the tags.'}
{timeline date='released', label='version', text='brought', vertical, title='PHP releases'}
  [ { "version": "PHP 5.0", "released": "2004-07-13", "brought": "A new object model with the Zend Engine 2" },
    { "version": "PHP 5.3", "released": "2009-06-30", "brought": "Namespaces, closures and late static binding" },
    { "version": "PHP 5.4", "released": "2012-03-01", "brought": "Traits, the short array syntax and the built-in web server" },
    { "version": "PHP 7.0", "released": "2015-12-03", "brought": "A twice as fast engine, scalar type declarations and return types" },
    { "version": "PHP 7.4", "released": "2019-11-28", "brought": "Typed properties and arrow functions" },
    { "version": "PHP 8.0", "released": "2020-11-26", "brought": "The JIT compiler, named arguments, match and union types" },
    { "version": "PHP 8.1", "released": "2021-11-25", "brought": "Enums, readonly properties and fibers" },
    { "version": "PHP 8.2", "released": "2022-12-08", "brought": "Readonly classes and standalone null, true and false types" },
    { "version": "PHP 8.3", "released": "2023-11-23", "brought": "Typed class constants and json_validate()" },
    { "version": "PHP 8.4", "released": "2024-11-21", "brought": "Property hooks and asymmetric visibility" } ]
{/timeline}

{meta title='The regions of Europe and Asia, and the Americas between', about='Twelve views of pad/subs/maps/types/ from a page array, each drawn small without values - its countries grey, the land around them lighter.'/}
<div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(180px, 1fr)); gap:16px">
  {views}
  <figure style="margin:0">{map $view, width=180/}<figcaption><code>{$view}</code></figcaption></figure>
  {/views}
</div>

{meta title='Filtered at every depth', about='A where option on the tree is carried along by recurse - hidden rows are left out at every level.'}
{data 'recurseSite'}
[
  { "page": "About", "hidden": 0, "children": [
      { "page": "Team", "hidden": 0 },
      { "page": "Drafts", "hidden": 1 } ] },
  { "page": "Admin", "hidden": 1, "children": [ { "page": "Users", "hidden": 0 } ] },
  { "page": "Blog", "hidden": 0 }
]
{/data}
<ul>
{tree 'recurseSite', where='$hidden eq 0'}
  <li>{$page}{branch}<ul>{recurse}</ul>{/branch}</li>
{/tree}
</ul>

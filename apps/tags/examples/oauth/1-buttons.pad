{meta title='Log in with ...', about='A button per provider; href= sends this one nowhere, the default is the page oauth/<provider>.'/}
<p>
  {oauth 'github', href='#github'/}
  {oauth 'gitlab', href='#gitlab'/}
  {oauth 'google', href='#google'/}
  {oauth 'oidc', href='#company', label='Your company account'/}
</p>

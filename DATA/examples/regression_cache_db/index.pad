<p>backend: {$backend}</p><p>two fetches of the probe answer with one body: <b>{$verdict}</b></p><?php // Fetches the probe twice. The probe's body embeds its build moment in nanoseconds, so // two equal bodies mean the second fetch was answered from the db cache. $one = padCurl ( $padHost . 'regression_cache_db/?probe&padInclude' ); $two = padCurl ( $padHost . 'regression_cache_db/?probe&padInclude' ); $verdict = ( trim ( $one ['data'] ) != '' and $one ['data'] === $two ['data'] ) ? 'yes' : 'NO'; $backend = $padCacheServerType;?>
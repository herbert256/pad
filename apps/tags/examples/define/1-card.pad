{meta title='A card without a file', about='The define is used twice, each time with its own title, tone and content.'}
{define 'defineCard'}{parms title, tone='info'}<div class="{#tone}"><strong>{#title}</strong>: @content@</div>{/define}
{defineCard title='Revenue'}12.500{/defineCard}
{defineCard title='Returns', tone='warn'}3{/defineCard}

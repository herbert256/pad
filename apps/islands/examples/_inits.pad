<header class="example-head">
  <nav class="crumbs" aria-label="Breadcrumb"><a href="?index">Examples</a><span aria-hidden="true">/</span>{$example.groupTitle}</nav>
  <h1><span class="example-icon" aria-hidden="true">{$example.icon}</span>{$example.title}</h1>
  <p class="lede">{$example.lede}</p>
  <div class="chips">
    {serverChips}<code class="chip is-server">{$serverChips}</code>{/serverChips}
    {clientChips}<code class="chip is-client">{$clientChips}</code>{/clientChips}
  </div>
</header>

<section class="stage" aria-label="The example">
  <div class="stage-label"><span class="dot"></span> Live</div>

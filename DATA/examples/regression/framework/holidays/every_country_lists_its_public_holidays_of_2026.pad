at: {holidays:auto 'at', year=2026}{$date} {$local}|{/holidays:auto}
be: {holidays:auto 'be', year=2026}{$date} {$local}|{/holidays:auto}
ca: {holidays:auto 'ca', year=2026, lang='fr'}{$date} {$local}|{/holidays:auto}
dk: {holidays:auto 'dk', year=2026}{$date} {$local} {$type}|{/holidays:auto}
es: {holidays:auto 'es', year=2026}{$date} {$local}|{/holidays:auto}
fr: {holidays:auto 'fr', year=2026}{$date} {$local}|{/holidays:auto}
fr-974: {holidays:auto 'fr-974', year=2026, where='$region'}{$date} {$local}|{/holidays:auto}
ie: {holidays:auto 'ie', year=2026}{$date} {$name}|{/holidays:auto}
it: {holidays:auto 'it', year=2026}{$date} {$local}|{/holidays:auto}
lu: {holidays:auto 'lu', year=2026}{$date} {$local}|{/holidays:auto}
no: {holidays:auto 'no', year=2026}{$date} {$local}|{/holidays:auto}
pl: {holidays:auto 'pl', year=2026}{$date} {$local}|{/holidays:auto}
se: {holidays:auto 'se', year=2026}{$date} {$local} {$type}|{/holidays:auto}

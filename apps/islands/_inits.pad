<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="csrf-token" content="{csrf token}">
  <title>{$title}</title>
  <link rel="stylesheet" href="{$padRoot}islands/islands.css?v={$islandsCss}">
  {vite 'src/main.js', react}
</head>
<body>

<header class="topbar">
  <div class="wrap topbar-inner">

    <a class="brand" href="?index" aria-label="PAD + islands home">
      <svg class="brand-mark" viewBox="0 0 40 24" aria-hidden="true">
        <circle cx="6" cy="16" r="5" fill="#61dafb"/><circle cx="16" cy="9" r="5" fill="#42b883"/>
        <circle cx="24" cy="17" r="5" fill="#ff3e00"/><circle cx="33" cy="9" r="5" fill="#673ab8"/>
      </svg>
      <span>PAD <em>+</em> islands</span>
    </a>

    <nav class="menu" aria-label="Sections">
      {local:nav.json}
        <a href="?{$page}"{if $navSection eq $section} class="is-active" aria-current="page"{/if}>{$label}</a>
      {/local:nav.json}
    </nav>

    <button type="button" class="theme" data-theme-toggle aria-label="Switch between light and dark">
      <svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.5"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg>
    </button>

  </div>
</header>

<main class="wrap main">
@page@
</main>

<footer class="footer">
  <div class="wrap">
    <p><strong>PAD</strong> renders the page and places the islands &middot; <strong>React, Vue, Svelte, Preact, Solid</strong> bring them to life, built by Vite</p>
    <p class="footer-small">The sources are in <code>apps/islands/_frontend/</code>, the build in <code>www/islands/build/</code>, linked by <code>{open}vite 'src/main.js'{close}</code></p>
  </div>
</footer>

</body>
</html>

    [ { "label": "Orders",            "link": "?examples/commandpalette/shop_admin", "group": "Pages" },
      { "label": "Customers",         "link": "?examples/commandpalette/shop_admin", "group": "Pages", "keywords": "clients buyers" },
      { "label": "Kettles in stock",  "link": "?examples/commandpalette/shop_admin", "group": "Pages", "keywords": "products inventory" },
      { "label": "New order",         "link": "?examples/commandpalette/shop_admin", "group": "Actions" },
      { "label": "Refund an order",   "link": "?examples/commandpalette/shop_admin", "group": "Actions", "keywords": "money back" },
      { "label": "Print the packing slips", "link": "?examples/commandpalette/shop_admin", "group": "Actions" } ]
  {/format:auto}
  {widget:commandpalette 'Go to', data='commands', placeholder='Search pages and actions'/}

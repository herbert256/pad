{pad:meta title='From a store', about='The odd numbers removed from a stored list of the first ten triangular numbers.'/}
{sequence:triangular rows=10, push='triangles'/}
<p>All:  {pad:pull 'triangles'}{$sequence} {/pad:pull}</p>
<p>Not odd: {remove:auto triangles, odd}{$sequence} {/remove:auto}</p>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>name</key>
    <string>PAD Indent</string>
    <key>scope</key>
    <string>text.html.pad</string>
    <key>settings</key>
    <dict>
        <key>increaseIndentPattern</key>
        <string>\{(?:if|while|until|case|data|content|ignore|trace|tidy|record|array|check|sequence|code)\b[^{}]*\}[^{}]*$</string>
        <key>decreaseIndentPattern</key>
        <string>^\s*(?:\{/[A-Za-z_][A-Za-z0-9_:]*\}|\{(?:else|elseif|when)\b[^{}]*\})</string>
    </dict>
</dict>
</plist>

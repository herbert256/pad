{pad:meta title='An identicon per account', about='The value is trimmed and lower-cased first - the last row is the second one spelled differently.'/}
<table>
  {array:accounts}
    <tr>
      <td>{avatar:identicon $email, size=40/}</td>
      <td>{$email}</td>
    </tr>
  {/array:accounts}
</table>

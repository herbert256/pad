{pad:meta title='A value that must not occur', about='An unknown status ends the request with a report naming it, instead of rendering an empty cell.'/}
{pad:case $status}
  {pad:when 'open'}    <span class="open">Open</span>
  {pad:when 'paid'}    <span class="paid">Paid</span>
  {pad:when 'shipped'} <span class="done">Shipped</span>
  {pad:else}           {pad:error 'unknown order status'/}
{/pad:case}

<header class="example-head">
  <p class="lede"><span class="example-icon" aria-hidden="true">{$example.icon}</span>{$example.lede}</p>
  <div class="chips">
    {array:serverChips}<code class="chip is-server">{$serverChips}</code>{/array:serverChips}
    {array:clientChips}<code class="chip is-client">{$clientChips}</code>{/array:clientChips}
  </div>
</header>

<section class="stage" aria-label="The example">
  <div class="stage-label"><span class="dot"></span> Live</div>

{pad:data 'y'}
  city: Paris
  country: FR
{/pad:data}[{data:y}{property:key@y/}={$y};{/data:y}]
{pad:data 'l'}
  - name: a
  - name: b
{/pad:data}[{data:l}{$name};{/data:l}]

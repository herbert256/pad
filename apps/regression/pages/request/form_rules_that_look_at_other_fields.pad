{input:form 'trip', error}
{input:field 'delivery'/}
{input:field 'user[address]', label='Address', rules='required_if:delivery,ship'/}
{input:field 'user[email]', type='email', rules='email'/}
{input:field 'phone', rules='required_without:user[email]'/}
{input:field 'start', type='date', rules='required|after:2026-01-01'/}
{input:field 'end', type='date', rules='after:start'/}
{input:field 'login', rules='required|not_in:admin,root'/}
{/input:form}
{$tripState}

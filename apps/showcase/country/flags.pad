  {country 'NLD'} {country 'FRA'} {country 'ITA'}
  {country 'ESP'} {country 'SWE'} {country 'NOR'}
  {country 'CAN'} {country 'MEX'} {country 'ARG'}
  {country 'ZAF'} {country 'KEN'} {country 'EGY'}
  {country 'IND'} {country 'CHN'} {country 'KOR'}
  {country 'AUS'} {country 'NZL'} {country 'FJI'}
</div>

{pad:content 'c'}yes{pad:else}no{/pad:content}{pad:content 'w'}{pad:when 1}one{pad:when 2}two{pad:else}other{/pad:content}{pad:content 'e'}yes@else@no{/pad:content}{pad:set $x = 1/}1[{pad:if $x eq 1, content='c'}{/pad:if}] 2[{pad:if $x eq 2, content='c'}{/pad:if}] 3[{pad:case $x, content='w'}{/pad:case}] 4[{pad:if $x eq 1, content='e'}{/pad:if}] 5[{pad:if $x eq 2, content='e'}{/pad:if}] 6[{pad:auth content='c'}{/pad:auth}]

{pad:meta title='Phrases, prefixes, words left out', about='A phrase must be there, a prefix stands for every word that begins so, a minus leaves a row out.'/}
<ul>
  <li>"a dragon": {search:auto 'collectionBooks', q='"a dragon"'}{$title} {/search:auto}</li>
  <li>adv*: {search:auto 'collectionBooks', q='adv*'}{$title} {/search:auto}</li>
  <li>planet -spice: {search:auto 'collectionBooks', q='planet -spice'}{$title} {/search:auto}</li>
</ul>

{pad:meta title='A carrier for data=', about='With data= the content renders once per row, under the name the tag is given.'/}
{format:auto 'colours'}["red", "green", "blue"]{/format:auto}
<ul>
  {pad:pad data='colours', name='colour'}
    <li>{property:current@colour/}: {$colours}</li>
  {/pad:pad}
</ul>

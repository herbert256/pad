<h3>A column list</h3>
<p>{artists fields="name, formed", rows=3}{$name} ({$formed}){notLast@artists}, {/notLast@artists}{/artists}</p>

<h3>Expressions with an alias</h3>
<ul>
  {tracks fields="title, concat(seconds div 60, ':', lpad(seconds mod 60, 2, '0')) as length", $album_id=3}
  <li>{$title} {$length}</li>
  {/tracks}
</ul>

<h3>Declared as column => alias</h3>
<ul>
  {albumCards}<li>{$album}, {$year}</li>{/albumCards}
</ul>

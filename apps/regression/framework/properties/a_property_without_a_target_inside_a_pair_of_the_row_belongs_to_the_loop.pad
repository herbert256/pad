A{array:items}{pad:ifchanged $g}{property:notFirst@}</ul>{/property:notFirst@}<h2>{$g}</h2><ul>{/pad:ifchanged}<li>{$n}</li>{/array:items}</ul>
B{array:items}[{pad:ifchanged $g}{property:current@/}{/pad:ifchanged}]{/array:items}
C{array:items}<li>{pad:spaceless}{$n}{property:notLast@}, {/property:notLast@}{/pad:spaceless}</li>{/array:items}
D{array:items}{pad:guest}{pad:if current@ eq 2}two{/pad:if}{&current}{/pad:guest};{/array:items}
E{array:items}{pad:fragment 'row'}{property:first@}<ul>{/property:first@}{$n}{/pad:fragment}{/array:items}

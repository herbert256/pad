{meta title='Product page', about='Overview, specifications and reviews of a kettle behind three tabs - the specifications shown first.'}
<div style="width:100%; max-width:640px">
  <h2>Aurora electric kettle</h2>
  {tabs active='Specifications'}
    {tab 'Overview'}
      <p>A 1.7 litre kettle in brushed steel that boils a full jug in under four minutes
      and keeps it warm for half an hour. The lid opens with one touch, the water window
      lights up blue while it heats.</p>
    {/tab}
    {tab 'Specifications'}
      <table>
        <tr><th>Capacity</th><td>1.7 litres</td></tr>
        <tr><th>Power</th><td>2200 W</td></tr>
        <tr><th>Keep warm</th><td>30 minutes at 80 °C</td></tr>
        <tr><th>Weight</th><td>1.1 kg</td></tr>
      </table>
    {/tab}
    {tab 'Reviews (3)'}
      {reviews}
        <p><strong>{$name}</strong> - {$stars} of 5<br>{$text}</p>
      {/reviews}
    {/tab}
  {/tabs}
</div>

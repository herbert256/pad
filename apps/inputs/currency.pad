{pad:meta title='Currency'/}
{include:about/}

{input:form 'try', class='inputs-try', error}
  {input:currency 'price',
    currency='EUR',
    value='12.50',
    label='Price in euros',
    min=0,
    rules='required|numeric|between:0,1000000'
  /}
  <button class="inputs-send">Send</button>
{/input:form}

{include:received/}

{include:template/}

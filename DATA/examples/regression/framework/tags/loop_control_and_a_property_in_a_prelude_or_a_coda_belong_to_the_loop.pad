A[{array:rows}<ul>{pad:if count@rows gt 1}too many{pad:break/}{/pad:if}@start@<li>{$a}</li>@end@</ul>{/array:rows}]
B[{array:rows}<ul>{pad:cease/}@start@<li>{$a}</li>@end@</ul>{/array:rows}]
C[{array:rows}<ul>@start@<li>{$a}</li>@end@{pad:if 1}{property:current@/}/{property:count@/}{/pad:if}</ul>{/array:rows}]
D[{pad:set $i = 0/}{pad:while $i lt 3}<ul>{pad:cease/}@start@<li>{$i}</li>{pad:increment $i/}@end@</ul>{/pad:while}]

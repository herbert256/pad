{pad:data 'rows'}[{"s":"a"},{"s":"b"},{"s":"c"}]{/pad:data}{data:rows where='$s not in ("a", "b")'}{$s}{/data:rows}|{data:rows where='$s not like "a%"'}{$s}{/data:rows}|{pad:if 5 not in (5, 6)}T{pad:else}F{/pad:if}|{data:rows}{pad:if $s ne 'a' and $s not in ('b')}{$s}{/pad:if}{/data:rows}|{data:rows}{pad:if $s not matches '/^[ab]$/'}{$s}{/pad:if}{/data:rows}|{pad:if 5 not range (1, 4)}T{pad:else}F{/pad:if}|{pad:if not 5 in (1)}T{pad:else}F{/pad:if}

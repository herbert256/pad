{pad:meta title='Source or snapshot', about='Named on the opening tag the content renders with today\'s values; named on the closing tag it is rendered once and kept.'/}
{pad:set $price = 10/}
{pad:content 'contentLive'}the price is {$price}{/pad:content}
{pad:content}the price was {$price}{/pad:content 'contentFixed'}
{pad:set $price = 12/}
<p>Live: {content:contentLive/}</p>
<p>Snapshot: {content:contentFixed/}</p>

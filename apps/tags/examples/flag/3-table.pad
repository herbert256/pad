{pad:meta title='Value and flag side by side', about='A stored list and its flags against the type prime, in a two-row table.'/}
{sequence:range '10..17', push='teens'/}
<table>
  <tr>
    <th>n</th>
    {pad:pull teens}
      <td>{$sequence}</td>
    {/pad:pull}
  </tr>
  <tr>
    <th>prime</th>
    {pad:flag teens, prime}
      <td>{$sequence}</td>
    {/pad:flag}
  </tr>
</table>

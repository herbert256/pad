{pad:meta title='In a form', about='Inside a {input:form} the text area refills from what that form sent; other items are attributes.'/}
{input:form 'feedback', method='get'}
  {input:field 'subject', label='Subject', value='Hello'/}
  {input:textarea 'body', label='Your message', rows=5, maxlength=500, placeholder='Write here', required/}
  <button>Send</button>
{/input:form}

{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "pad",
  "word": "identifier",
  "rules": {
    "template": {
      "type": "REPEAT",
      "content": {
        "type": "SYMBOL",
        "name": "_node"
      }
    },
    "_node": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "text"
        },
        {
          "type": "SYMBOL",
          "name": "comment"
        },
        {
          "type": "SYMBOL",
          "name": "construct"
        },
        {
          "type": "SYMBOL",
          "name": "block"
        },
        {
          "type": "SYMBOL",
          "name": "ignore_block"
        },
        {
          "type": "SYMBOL",
          "name": "tag"
        },
        {
          "type": "SYMBOL",
          "name": "field_tag"
        },
        {
          "type": "SYMBOL",
          "name": "close_tag"
        }
      ]
    },
    "text": {
      "type": "TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "PATTERN",
            "value": "[^{@\\s][^{@]*"
          },
          {
            "type": "PATTERN",
            "value": "\\{[^A-Za-z_$%!?#&^\\/~\\-]"
          },
          {
            "type": "PATTERN",
            "value": "\\{-[^-]"
          },
          {
            "type": "PATTERN",
            "value": "\\{--[^\\s]"
          },
          {
            "type": "STRING",
            "value": "@"
          }
        ]
      }
    },
    "comment": {
      "type": "TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "PATTERN",
            "value": "\\{#([^A-Za-z_#]|#+[^#}])([^#]|#+[^#}])*#+\\}"
          },
          {
            "type": "PATTERN",
            "value": "\\{##+\\}"
          },
          {
            "type": "PATTERN",
            "value": "\\{#[A-Za-z_][A-Za-z0-9_]*\\s*#+([^#}]([^#]|#+[^#}])*#+)?\\}"
          },
          {
            "type": "PATTERN",
            "value": "\\{#[A-Za-z_][A-Za-z0-9_]*[^A-Za-z0-9_\\s}|#]([^#]|#+[^#}])*#+\\}"
          },
          {
            "type": "PATTERN",
            "value": "\\{#[A-Za-z_][A-Za-z0-9_]*\\s+[^\\s}|#]([^#]|#+[^#}])*#+\\}"
          },
          {
            "type": "PATTERN",
            "value": "\\{--\\s([^-]|-[^-]|--+[^-}])*--+\\}"
          }
        ]
      }
    },
    "construct": {
      "type": "PATTERN",
      "value": "@(page|content|start|end|else|tidy)@"
    },
    "block": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_block_start"
        },
        {
          "type": "SYMBOL",
          "name": "open_tag"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "body"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "_block_end"
        },
        {
          "type": "SYMBOL",
          "name": "close_tag"
        }
      ]
    },
    "body": {
      "type": "REPEAT1",
      "content": {
        "type": "SYMBOL",
        "name": "_node"
      }
    },
    "ignore_block": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_block_start"
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "SYMBOL",
            "name": "_ignore_open_tag"
          },
          "named": true,
          "value": "open_tag"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "raw_text"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "_block_end"
        },
        {
          "type": "SYMBOL",
          "name": "close_tag"
        }
      ]
    },
    "_ignore_open_tag": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_open"
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "SYMBOL",
            "name": "_ignore_name"
          },
          "named": true,
          "value": "tag_name"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "arguments"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "_close"
        }
      ]
    },
    "_ignore_name": {
      "type": "FIELD",
      "name": "name",
      "content": {
        "type": "ALIAS",
        "content": {
          "type": "STRING",
          "value": "ignore"
        },
        "named": true,
        "value": "identifier"
      }
    },
    "tag": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_open"
        },
        {
          "type": "SYMBOL",
          "name": "tag_name"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "arguments"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "_close"
        }
      ]
    },
    "open_tag": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_open"
        },
        {
          "type": "SYMBOL",
          "name": "tag_name"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "arguments"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "_close"
        }
      ]
    },
    "close_tag": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_open"
        },
        {
          "type": "STRING",
          "value": "/"
        },
        {
          "type": "SYMBOL",
          "name": "tag_name"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "arguments"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "_close"
        }
      ]
    },
    "field_tag": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_open"
        },
        {
          "type": "SYMBOL",
          "name": "variable"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "arguments"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "_close"
        }
      ]
    },
    "_open": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "{"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "IMMEDIATE_TOKEN",
              "content": {
                "type": "STRING",
                "value": "~"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "_close": {
      "type": "SEQ",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "STRING",
              "value": "~"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "STRING",
          "value": "}"
        }
      ]
    },
    "tag_name": {
      "type": "CHOICE",
      "members": [
        {
          "type": "FIELD",
          "name": "name",
          "content": {
            "type": "SYMBOL",
            "name": "identifier"
          }
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "FIELD",
              "name": "prefix",
              "content": {
                "type": "ALIAS",
                "content": {
                  "type": "SYMBOL",
                  "name": "identifier"
                },
                "named": true,
                "value": "prefix"
              }
            },
            {
              "type": "IMMEDIATE_TOKEN",
              "content": {
                "type": "STRING",
                "value": ":"
              }
            },
            {
              "type": "FIELD",
              "name": "name",
              "content": {
                "type": "ALIAS",
                "content": {
                  "type": "IMMEDIATE_TOKEN",
                  "content": {
                    "type": "PATTERN",
                    "value": "[A-Za-z_][A-Za-z0-9_]*"
                  }
                },
                "named": true,
                "value": "identifier"
              }
            }
          ]
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "FIELD",
              "name": "property",
              "content": {
                "type": "ALIAS",
                "content": {
                  "type": "SYMBOL",
                  "name": "identifier"
                },
                "named": true,
                "value": "property"
              }
            },
            {
              "type": "IMMEDIATE_TOKEN",
              "content": {
                "type": "STRING",
                "value": "@"
              }
            },
            {
              "type": "CHOICE",
              "members": [
                {
                  "type": "FIELD",
                  "name": "target",
                  "content": {
                    "type": "ALIAS",
                    "content": {
                      "type": "IMMEDIATE_TOKEN",
                      "content": {
                        "type": "PATTERN",
                        "value": "[A-Za-z_][A-Za-z0-9_]*|-?[0-9]+"
                      }
                    },
                    "named": true,
                    "value": "identifier"
                  }
                },
                {
                  "type": "BLANK"
                }
              ]
            }
          ]
        }
      ]
    },
    "arguments": {
      "type": "REPEAT1",
      "content": {
        "type": "SYMBOL",
        "name": "_argument"
      }
    },
    "_argument": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "string"
        },
        {
          "type": "SYMBOL",
          "name": "number"
        },
        {
          "type": "SYMBOL",
          "name": "format"
        },
        {
          "type": "SYMBOL",
          "name": "variable"
        },
        {
          "type": "SYMBOL",
          "name": "identifier"
        },
        {
          "type": "SYMBOL",
          "name": "option"
        },
        {
          "type": "SYMBOL",
          "name": "prefixed_name"
        },
        {
          "type": "SYMBOL",
          "name": "property_reference"
        },
        {
          "type": "SYMBOL",
          "name": "pipe"
        },
        {
          "type": "SYMBOL",
          "name": "operator"
        },
        {
          "type": "SYMBOL",
          "name": "placeholder"
        },
        {
          "type": "SYMBOL",
          "name": "field_tag"
        },
        {
          "type": "SYMBOL",
          "name": "tag"
        },
        {
          "type": "STRING",
          "value": ","
        },
        {
          "type": "STRING",
          "value": "="
        },
        {
          "type": "STRING",
          "value": ":"
        },
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "STRING",
          "value": ")"
        },
        {
          "type": "STRING",
          "value": "["
        },
        {
          "type": "STRING",
          "value": "]"
        }
      ]
    },
    "option": {
      "type": "PREC_RIGHT",
      "value": 1,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "FIELD",
            "name": "name",
            "content": {
              "type": "ALIAS",
              "content": {
                "type": "SYMBOL",
                "name": "identifier"
              },
              "named": true,
              "value": "option_name"
            }
          },
          {
            "type": "STRING",
            "value": "="
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "FIELD",
                "name": "value",
                "content": {
                  "type": "CHOICE",
                  "members": [
                    {
                      "type": "SYMBOL",
                      "name": "string"
                    },
                    {
                      "type": "SYMBOL",
                      "name": "number"
                    },
                    {
                      "type": "SYMBOL",
                      "name": "variable"
                    },
                    {
                      "type": "SYMBOL",
                      "name": "identifier"
                    },
                    {
                      "type": "SYMBOL",
                      "name": "field_tag"
                    }
                  ]
                }
              },
              {
                "type": "BLANK"
              }
            ]
          }
        ]
      }
    },
    "pipe": {
      "type": "PREC_RIGHT",
      "value": 0,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "|"
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "SEQ",
                "members": [
                  {
                    "type": "CHOICE",
                    "members": [
                      {
                        "type": "SEQ",
                        "members": [
                          {
                            "type": "FIELD",
                            "name": "prefix",
                            "content": {
                              "type": "ALIAS",
                              "content": {
                                "type": "SYMBOL",
                                "name": "identifier"
                              },
                              "named": true,
                              "value": "prefix"
                            }
                          },
                          {
                            "type": "IMMEDIATE_TOKEN",
                            "content": {
                              "type": "STRING",
                              "value": ":"
                            }
                          }
                        ]
                      },
                      {
                        "type": "BLANK"
                      }
                    ]
                  },
                  {
                    "type": "FIELD",
                    "name": "function",
                    "content": {
                      "type": "ALIAS",
                      "content": {
                        "type": "SYMBOL",
                        "name": "identifier"
                      },
                      "named": true,
                      "value": "function_name"
                    }
                  }
                ]
              },
              {
                "type": "BLANK"
              }
            ]
          }
        ]
      }
    },
    "prefixed_name": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "prefix",
          "content": {
            "type": "ALIAS",
            "content": {
              "type": "SYMBOL",
              "name": "identifier"
            },
            "named": true,
            "value": "prefix"
          }
        },
        {
          "type": "IMMEDIATE_TOKEN",
          "content": {
            "type": "STRING",
            "value": ":"
          }
        },
        {
          "type": "FIELD",
          "name": "name",
          "content": {
            "type": "ALIAS",
            "content": {
              "type": "IMMEDIATE_TOKEN",
              "content": {
                "type": "PATTERN",
                "value": "[A-Za-z_][A-Za-z0-9_]*"
              }
            },
            "named": true,
            "value": "identifier"
          }
        }
      ]
    },
    "property_reference": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "property",
          "content": {
            "type": "ALIAS",
            "content": {
              "type": "SYMBOL",
              "name": "identifier"
            },
            "named": true,
            "value": "property"
          }
        },
        {
          "type": "IMMEDIATE_TOKEN",
          "content": {
            "type": "STRING",
            "value": "@"
          }
        },
        {
          "type": "FIELD",
          "name": "target",
          "content": {
            "type": "ALIAS",
            "content": {
              "type": "IMMEDIATE_TOKEN",
              "content": {
                "type": "PATTERN",
                "value": "[A-Za-z_][A-Za-z0-9_]*|-?[0-9]+"
              }
            },
            "named": true,
            "value": "identifier"
          }
        }
      ]
    },
    "placeholder": {
      "type": "STRING",
      "value": "@"
    },
    "variable": {
      "type": "TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SEQ",
            "members": [
              {
                "type": "PATTERN",
                "value": "[$%!?#&^]+"
              },
              {
                "type": "CHOICE",
                "members": [
                  {
                    "type": "PATTERN",
                    "value": "[A-Za-z_][A-Za-z0-9_]*"
                  },
                  {
                    "type": "PATTERN",
                    "value": "-?[0-9]+"
                  },
                  {
                    "type": "PATTERN",
                    "value": "[<>*][0-9]*"
                  }
                ]
              },
              {
                "type": "REPEAT",
                "content": {
                  "type": "PATTERN",
                  "value": "[.:]([A-Za-z_][A-Za-z0-9_]*|[0-9]+)"
                }
              },
              {
                "type": "CHOICE",
                "members": [
                  {
                    "type": "PATTERN",
                    "value": "@([A-Za-z_][A-Za-z0-9_]*|-?[0-9]+)"
                  },
                  {
                    "type": "BLANK"
                  }
                ]
              }
            ]
          },
          {
            "type": "STRING",
            "value": "$$"
          }
        ]
      }
    },
    "string": {
      "type": "TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "PATTERN",
            "value": "'([^'\\\\]|\\\\.)*'"
          },
          {
            "type": "PATTERN",
            "value": "\"([^\"\\\\]|\\\\.)*\""
          }
        ]
      }
    },
    "number": {
      "type": "PATTERN",
      "value": "\\d+(\\.\\d+)?"
    },
    "format": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 1,
        "content": {
          "type": "PATTERN",
          "value": "%[-+ 0#]*('.)?[0-9]*(\\.[0-9]+)?[bcdeEfFgGosuxX]"
        }
      }
    },
    "operator": {
      "type": "TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "STRING",
            "value": "=="
          },
          {
            "type": "STRING",
            "value": "!="
          },
          {
            "type": "STRING",
            "value": "<="
          },
          {
            "type": "STRING",
            "value": ">="
          },
          {
            "type": "STRING",
            "value": "<>"
          },
          {
            "type": "STRING",
            "value": "&&"
          },
          {
            "type": "STRING",
            "value": ".."
          },
          {
            "type": "PATTERN",
            "value": "[-+*\\/<>!.%^?&]"
          }
        ]
      }
    },
    "identifier": {
      "type": "PATTERN",
      "value": "[A-Za-z_][A-Za-z0-9_]*"
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s+"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [
    {
      "type": "SYMBOL",
      "name": "_block_start"
    },
    {
      "type": "SYMBOL",
      "name": "_block_end"
    },
    {
      "type": "SYMBOL",
      "name": "raw_text"
    },
    {
      "type": "SYMBOL",
      "name": "_error_sentinel"
    }
  ],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}
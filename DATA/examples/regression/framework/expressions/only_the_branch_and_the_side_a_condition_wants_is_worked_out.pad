[{echo 1 ? 'yes' : $missing}][{echo 0 ? $missing : 'no'}][{echo 'x' ?: $missing . '!'}][{echo 0 and $missing}][{echo 1 or 7 / 0}][{echo 'ok' ?? (7 / 0)}][{echo 0 and php:branchCount(1)}][{echo 1 || php:branchCount(1)}][{echo 'ok' ?? php:branchCount('e')}][{$branchCalls}][{echo 1 and php:branchCount(1)}][{echo '' ?? php:branchCount('e')}][{$branchCalls}][{echo 'v' | php:branchCount | $later}]

{pad:set $i = 0/}A[{pad:while $i lt 3}<ul>@start@<li>{$i}</li>{pad:increment $i/}@end@</ul>{/pad:while}] after={$i}
{pad:set $i = 0/}D[{pad:while}<ul>@start@<li>{$i}</li>{pad:increment $i/}@end@</ul>{/pad:while $i lt 3}]
{pad:set $i = 5/}U[{pad:until $i le 3}<ol>@start@<li>{$i}</li>{pad:decrement $i/}@end@</ol>{/pad:until}]

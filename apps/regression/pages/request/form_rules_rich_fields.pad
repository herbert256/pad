{pad:form 'trip', error}
{input:slider 'volume', rules='integer|between:10,90'/}
{input:stepper 'guests', label='Guests', rules='required|integer|between:1,8'/}
{input:toggle 'terms', label='Terms', rules='accepted'/}
{input:stars 'score', label='Score', rules='required'/}
{input:colorpicker 'tint', rules='color'/}
{input:datepicker 'day', rules='required|date'/}
{input:timepicker 'at', rules='time'/}
{input:taginput 'topics', rules='required|max:20'/}
{input:signature 'signed', rules='required'/}
{input:mdeditor 'note', rules='max:12'/}
{input:newpassword 'password', rules='required|min:8'/}
{input:otp 'code', rules='required|digits:6'/}
{input:combobox 'city', options='Rome, Oslo', rules='in:Rome,Oslo'/}
{/pad:form}
{$state}

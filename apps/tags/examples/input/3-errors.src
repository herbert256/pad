{meta title='The message beside the field', about='After a post padValidate found wrong, the field shows the posted value and its message, tied to it for a screen reader.'}
{# contact.php: if ( padPosted ( 'contact' ) ) $errors = padValidate ( [ 'email' => 'required|email' ] ); #}
{form 'contact'}
  {input 'email', type='email', label='E-mail'}
  <button>Send</button>
{/form}


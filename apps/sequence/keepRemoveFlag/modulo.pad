{common:table}

{common:demo}{sequence:loop 25, push='mySequence'/} {/common:demo}

{common:demo}{pad:pull mySequence, make,   modulo=4} {$sequence} {/pad:pull}{/common:demo}

{common:demo}{pad:pull mySequence, keep,   modulo=4} {$sequence} {/pad:pull}{/common:demo}

{common:demo}{pad:pull mySequence, remove, modulo=4} {$sequence} {/pad:pull}{/common:demo}

{common:demo}{pad:pull mySequence, flag,   modulo=4} {$sequence} {/pad:pull}{/common:demo}

{/common:table}

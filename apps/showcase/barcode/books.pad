  <figure style="margin:0; text-align:center">{bookland 'ISBN 0-306-40615-2'/}<figcaption>an ISBN-10, made an ISBN-13</figcaption></figure>
  <figure style="margin:0; text-align:center">{ean13 '977031784700', addon='07'/}<figcaption>ISSN 0317-8471, issue 7</figcaption></figure>

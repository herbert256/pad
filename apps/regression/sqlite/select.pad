where: [{select:staffSel where="salary >= 2000", order="salary"}{$name} {/select:staffSel}]
order: [{select:staffSel order="salary desc", fields="name"}{$name} {/select:staffSel}]
first: [{select:staffSel order="name", rows=2}{$name} {/select:staffSel}]
bound: [{select:staffSel where="name = $who"}{$name} @else@none{/select:staffSel}]
minus: [{select:staffSel where="salary > 2000-$adj", order="name"}{$name} @else@none{/select:staffSel}]
spliced: [{select:staffSel where="salary > 2000-{$adj}", order="name"}{$name} @else@none{/select:staffSel}]
field: [{pad:field "count(*) from staff where salary > 2000-{$adj}"/}]
distinctrow: [{select:staffSel fields="floor(salary / 2000) as band", distinctrow, order="band"}{$band} {/select:staffSel}]
member: [{select:staffSel fields="name", where="salary < 2000", union="topPaid", order="name"}{$name} {/select:staffSel}]

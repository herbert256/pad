[{sequence:range '1..6', make, multiple=3, build='order'}{$sequence} @else@none{/sequence:range}][{sequence:range '1..6', make, step=3, build='order'}{$sequence} {/sequence:range}][{sequence:range '1..6', make, chance=1, build='order'}{$sequence} {/sequence:range}][{sequence:range '1..5', make, golomb, build='order'}{$sequence} {/sequence:range}][{sequence:range '92..95', make, fibonacci}{$sequence} {/sequence:range}][{sequence:range '1..2000', make, fibonacci, count}{$sequence}{/sequence:range}]

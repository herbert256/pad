{pad:meta title='Arithmetic on a range', about='One make, then two applied in the order written.'/}
<p>add=10: {make:range '1..5', add=10}{$sequence} {/make:range}</p>
<p>add=10, multiply=2: {make:range '1..5', add=10, multiply=2}{$sequence} {/make:range}</p>
<p>modulo=3: {make:range '1..9', modulo=3}{$sequence} {/make:range}</p>

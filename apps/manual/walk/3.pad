{common:table}
  {common:demo}
    {pad:set $loop = 1/}

    {pad:while $loop LE 5, toData='abc'}
      {pad:increment $loop/}
    {/pad:while}
  {/common:demo}

  {common:demo}
    {content:myTable}
      {data:abc}
        <tr>
          <td> {property:first}  X {/property:first}  </td>
          <td> {property:middle} X {/property:middle} </td>
          <td> {property:last}   X {/property:last}   </td>
          <td> {property:border} X {/property:border} </td>
        </tr>
      {/data:abc}
    {/content:myTable}
  {/common:demo}
{/common:table}

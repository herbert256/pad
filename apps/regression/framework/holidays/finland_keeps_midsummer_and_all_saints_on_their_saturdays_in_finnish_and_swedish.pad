{holidays 'fi', year=2027}{$date} {$local} {$type}|{/holidays}
{holidays 'fi-01', year=2026, lang='sv', where='$region'}{$date} {$local} {$type}|{/holidays}
{holidays 'fi', year=1992, where='$name eq "Epiphany" or $name eq "Ascension Day"'}{$date} {$name}|{/holidays}
{holidays 'fi', from='2025-06-19', to='2025-11-02', where='$type eq "public"'}{$date} {$name}|{/holidays}

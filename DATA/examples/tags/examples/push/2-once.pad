{pad:meta title='Once per key', about='Three uses of a component each push its script line; once= keeps only the first, the bare once drops a repeated text.'/}
{sequence:loop 3, name='use'}
  {pad:push 'pushScripts', once='chart'}<li>script src="chart.js" (pushed by use {$use})</li>{/pad:push}
  {pad:push 'pushScripts', once}<li>link href="chart.css"</li>{/pad:push}
{/sequence:loop}
<ul>{pad:stack 'pushScripts'/}</ul>

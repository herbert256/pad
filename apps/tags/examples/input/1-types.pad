{pad:meta title='Field types', about='A label before a text field, after a checkbox or radio; value= is what shows before anything was sent.'/}
{pad:form 'order', method='get'}
  {pad:input 'name', label='Name', value='Ann'/}
  {pad:input 'size', type='radio', id='size-s', label='Small', value='S'/}
  {pad:input 'size', type='radio', id='size-l', label='Large', value='L', checked/}
  {pad:input 'gift', type='checkbox', label='Gift wrap', value='yes'/}
  {pad:input 'step', type='hidden', value='2'/}
{/pad:form}

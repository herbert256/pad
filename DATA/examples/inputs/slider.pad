{pad:meta title='Slider'/}
{include:about/}

{pad:form 'try', class='inputs-try', error}
  {input:slider 'volume', label='Volume', unit='%', rules='integer|between:10,90'/}
  {input:slider 'tempo', label='Tempo', min=40, max=200, step=4, value=120, unit=' bpm', marks='60, 90, 120, 150, 180'/}
  <button class="inputs-send">Send</button>
{/pad:form}

{include:received/}

{include:template/}

<table>
  <tr>
    <td>
      <table border=1>
        {select:offices sort}
          {select:employees}
            <tr>
              <td> {$city} </td>
              <td> {$lastName}, {$firstName} </td>
            </tr>
          {/select:employees}
        {/select:offices}
      </table>
    </td>
    <td> &nbsp; </td>
    <td>
      <table border=1>
        {select:employees}
          {select:offices}
            <tr>
              <td> {$lastName}, {$firstName} </td>
              <td> {$city} </td>
            </tr>
          {/select:offices}
        {/select:employees}
      </table>
    </td>
  </tr>
</table>

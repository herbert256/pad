{pad:meta title='A header for both', about='{pad:guest} and {pad:auth} side by side: {pad:guest} hands over no data, {pad:auth} hands over the user\'s row.'/}
<header>
  {pad:guest}<a href="?login">Log in</a>{/pad:guest}
  {pad:auth}<span>{$name}</span> <a href="?logout">Log out</a>{/pad:auth}
</header>

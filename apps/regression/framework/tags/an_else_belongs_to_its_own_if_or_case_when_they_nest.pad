{pad:set $x = 2/}{pad:set $y = 1/}H[{pad:case $x}{pad:when 1}{pad:if $y eq 1}a{pad:else}b{/pad:if}{pad:when 2}two{/pad:case}]
I[{pad:case $x}{pad:when 2}{pad:if $y eq 2}a{pad:else}b{/pad:if}{/pad:case}]
J[{pad:if $x eq 2}{pad:case $y}{pad:when 2}one{pad:else}notone{/pad:case}{pad:else}nottwo{/pad:if}]
K[{pad:if $x eq 3}{pad:case $y}{pad:when 1}one{pad:else}notone{/pad:case}{pad:else}nottwo{/pad:if}]
L[{pad:case $x}{pad:when 1}{pad:if $y eq 1}a{pad:else}b{/pad:if}{pad:else}other{/pad:case}]

{pad:meta title='Declared parameters', about='The badge tag declares label (required), tone and count (with defaults); the callers leave out what they like.'/}
<p>
  {app:parmsBadge label='New'/}
  {app:parmsBadge label='Inbox', count=3/}
  {app:parmsBadge label='Errors', tone='danger', count=12/}
</p>

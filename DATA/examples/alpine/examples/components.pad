<div class="cols-2">

  <section>
    <div class="panel-title">Accordion - accordion({open}^faq{close})</div>
    <div class="accordion" x-data="accordion({^faq})">
      {faq}
      <div class="accordion-item" :class="isOpen({current@faq}) && 'is-open'">
        <button class="accordion-head" @click="toggle({current@faq})" :aria-expanded="isOpen({current@faq})">{$q}<span aria-hidden="true">+</span></button>
        <div class="accordion-body" x-show="isOpen({current@faq})" x-transition>{$a}</div>
      </div>
      {/faq}
    </div>
  </section>

  <section>
    <div class="panel-title">Tabs - tabs({open}^tabs{close})</div>
    <div class="tabs" x-data="tabs({^tabs})">
      <div class="pills" role="tablist">
        <template x-for="tab in list" :key="tab.key">
          <button class="pill" role="tab" :class="tab.key === active && 'is-on'" :aria-selected="tab.key === active" @click="active = tab.key" x-text="tab.label"></button>
        </template>
      </div>
      <p class="panel tab-text" x-text="current().text">{$tabs.0.text}</p>
    </div>

    <div class="panel-title" style="margin-top: 26px">Dialog - dialog()</div>
    <div x-data="dialog()">
      <button @click="show()">Open the dialog</button>
      <div class="backdrop" x-show="open" x-transition.opacity x-cloak @click.self="hide()" @keydown.escape.window="hide()">
        <div class="dialog" role="dialog" aria-modal="true" aria-label="A dialog" x-show="open" x-transition>
          <h3>Rendered by PAD, shown by Alpine</h3>
          <p class="muted">This box was in the page from the start; Alpine only decides when it shows.</p>
          <button class="btn-ghost" @click="hide()" x-ref="close">Close</button>
        </div>
      </div>
    </div>
  </section>

</div>

<script src="{$padRoot}alpine/examples/components.js"></script>

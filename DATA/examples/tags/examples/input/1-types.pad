{pad:meta title='Field types', about='A label before a text field, after a checkbox or radio; value= is what shows before anything was sent.'/}
{input:form 'order', method='get'}
  {input:field 'name', label='Name', value='Ann'/}
  {input:field 'size', type='radio', id='size-s', label='Small', value='S'/}
  {input:field 'size', type='radio', id='size-l', label='Large', value='L', checked/}
  {input:field 'gift', type='checkbox', label='Gift wrap', value='yes'/}
  {input:field 'step', type='hidden', value='2'/}
{/input:form}

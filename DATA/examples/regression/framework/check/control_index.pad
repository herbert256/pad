{local:staff}

  {$name} <br>

{/local:staff}

{local:staff}

  {pad:if $name eq 'jack'}
    {pad:continue 'staff'/}
  {/pad:if}

  {$name} <br>

{/local:staff}

{local:staff}

  {pad:if $name eq 'jack'}
    {pad:cease 'staff'/}
  {/pad:if}

  {$name} <br>

{/local:staff}

{local:staff}

  {pad:if $name eq 'jack'}
    {pad:break 'staff'/}
  {/pad:if}

  {$name} <br>

{/local:staff}

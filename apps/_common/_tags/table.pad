<p> 
  <table border="1" cellpadding="10" cellspacing="0" class="pad-play-box">
    <tr>
      {pad:if #firstFile}
        <th bgcolor="#dddddd">{#firstFile}</th>
      {/pad:if}
      {pad:if #secondFile}
        <th bgcolor="#dddddd">{#secondFile}</th>
      {/pad:if}
      {pad:if #withPHP}
        <th bgcolor="#dddddd">PHP</th>
      {/pad:if}
      <th bgcolor="#dddddd">HTML</th>
      <th bgcolor="#dddddd">RESULT@PLAY@</th>
    </tr>
    @content@
  </table>
</p>

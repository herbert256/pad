{meta title='Cells as content', about='A line a row, a comma between cells; a cell starting with = is a formula, computed on the server, its column formatted.'/}
{spreadsheet 'shop', formats='B:€ #,##0.00, D:€ #,##0.00', totals='D'}
  Item,Price,Qty,Total
  Apples,1.20,3,=B2*C2
  Pears,0.80,5,=B3*C3
  Plums,2.25,2,=B4*C4
{/spreadsheet}

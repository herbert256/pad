{sequence '1..9', push='s'/}[{reverse '1..5', 'sum'}{$sequence} {/reverse}][{action:reverse '1..5', 'first'}{$sequence} {/action:reverse}][{reverse '1..5', 'first', 2}{$sequence} {/reverse}][{sequence 'prime', 3, 'reverse'}{$sequence} {/sequence}][{sum 'prime', 3}{$sequence} {/sum}][{set $a = 'sum'}{action:reverse s, $a}{$sequence} {/action:reverse}][{sequence '1..5', sort, 'reverse'}{$sequence} {/sequence}][{pull 's', 'shift', 2}{$sequence} {/pull}]
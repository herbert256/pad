{meta title='PHP with numbered lines', about='lines numbers the lines and mark sets line 4 apart; the braces need no ignore.'}
{highlight 'php', lines, mark='4'}
  <?php
    function total ( $rows ) {
      $sum = 0;
      foreach ( $rows as $row ) $sum += $row ['price'];
      return $sum;
    }
  ?>
{/highlight}

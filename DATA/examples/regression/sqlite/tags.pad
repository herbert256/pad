<p>{pad:field "phone from staff where name = 'bob'"/}</p>
<p>{pad:array "name from staff where salary > 2000 order by name"}{$name} {/pad:array}</p>
<p>{pad:check "staff where name = 'jerry'"}jerry is there{/pad:check}</p>
<p>{local:staffByPhone pattern='%3%', max=2}{$name} {/local:staffByPhone}</p>

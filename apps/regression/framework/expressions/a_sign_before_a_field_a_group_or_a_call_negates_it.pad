[{pad:echo 5 * -$b/}][{pad:echo $a - -$b/}][{pad:echo 5 * -(1 + 2)/}][{pad:echo 10 / -$n/}][{pad:echo 2 ** -$n/}]
[{pad:echo 5 * - 3/}][{pad:echo 2 - - 3/}][{pad:echo 3 - -$n * 2/}][{pad:echo 5 * -php:abs(3)/}][{pad:echo 1 + +$b/}]
[{pad:echo 10 | * -$n/}][{pad:echo 'abcdef' | substr(-$n)/}][{pad:echo 'abcdef' | substr(1, -$n)/}][{pad:echo php:max(1, -$n)/}]
[{pad:if $neg gt -$b}T{pad:else}F{/pad:if}][{pad:echo -$b/}][{pad:echo 10 | - 3/}]

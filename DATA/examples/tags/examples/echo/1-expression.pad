{pad:meta title='Expressions', about='Arithmetic, a joined text and a ternary - and a quoted text that stays text.'/}
{pad:set $price = 4.5/}
{pad:set $qty = 3/}
<p>Total: {pad:echo $price * $qty/}</p>
<p>{pad:echo $qty . ' ' . ( $qty gt 1 ? 'tickets' : 'ticket' )/}</p>
<p>{pad:echo 5 + 3/} versus {pad:echo '5 + 3'/}</p>

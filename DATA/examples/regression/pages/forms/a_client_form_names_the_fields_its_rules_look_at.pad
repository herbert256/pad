{pad:form 'trip', client, error}
<label for="delivery">Delivery</label> <select name="delivery" id="delivery"><option>collect</option><option>ship</option></select>
{pad:input 'address', label='Address', rules='required_if:delivery,ship'/}
{pad:input 'password', type='password', label='Password'/}
{pad:input 'confirm', type='password', label='Confirm', rules='same:password'/}
{pad:input 'start', type='date', label='Start'/}
{pad:input 'end', type='date', label='End', rules='after:start'/}
{pad:input 'kinds[]', type='checkbox', value='gift', label='Gift'/}
{pad:input 'card', label='Card text', rules='required_if:kinds[],gift|not_in:none'/}
<button>Send</button>
{/pad:form}

<p>Have a question or feedback? Send us a message!</p>

{if $successMsg}
  <div class="message">{$successMsg}</div>
{/if}

{if $hasErrors}
  <div class="message error">Please correct the errors below.</div>
{/if}

{form 'contact'}

  <p>{input 'name', label='Your Name: *'}</p>

  <p>{input 'email', type='email', label='Your Email: *'}</p>

  <p>{input 'subject', label='Subject: *'}</p>

  <p>{textarea 'message', label='Message: *', rows=6}</p>

  <p>
    <input type="submit" value="Send Message">
  </p>

{/form}

<p style="color: #999; font-size: 12px;">* Required fields</p>

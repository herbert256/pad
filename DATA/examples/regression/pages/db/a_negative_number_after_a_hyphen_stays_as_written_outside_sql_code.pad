text:    [{$lo}-{$hi}] [row-{$id}] <i id="item-{$id}"></i>
echo:    [{pad:echo 'UTC-{$id}'/}]
literal: [{pad:field "concat('X-{$id}')"/}]
code:    [{pad:field "2000-{$adj}"/}]
fields:  [{select:staffSel fields="name, concat('X-{$id}') as code", rows=1}{$code}{/select:staffSel}]
join:    [{select:staffSel join="staff as b on b.name = staff.name and concat('X-{$id}') = 'X--1'", fields="staff.name", rows=1}{$name}{/select:staffSel}]

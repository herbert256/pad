{meta title='Multiselect'/}
{about/}

{form 'try', class='inputs-try', error}
  {multiselect 'interests', label='Interests', options='PHP, Maps, Music, Charts, Games, Forms', value='PHP, Maps', rules='required|in:PHP,Maps,Music,Charts,Games,Forms'/}
  {input:multiselect 'days', label='Days', rules='in:Monday,Tuesday,Wednesday,Thursday,Friday'}
    Monday
    Tuesday
    Wednesday
    Thursday
    Friday
  {/input:multiselect}
  <button class="inputs-send">Send</button>
{/form}

{received/}

{template/}

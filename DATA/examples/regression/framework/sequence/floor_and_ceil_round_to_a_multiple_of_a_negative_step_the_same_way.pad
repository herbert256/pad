d[{sequence:floor -2, rows=5}{$sequence} {/sequence:floor}] c[{sequence:ceil -2, rows=5}{$sequence} {/sequence:ceil}] m[{sequence:range '1..5', make, floor=-2}{$sequence} {/sequence:range}] n[{sequence:range '-5..-1', make, ceil=-2}{$sequence} {/sequence:range}] k[{sequence:range '1..10', keep, multiple=-3}{$sequence} {/sequence:range}] s[{sequence:range '1..4', make, step=-2}{$sequence} {/sequence:range}]

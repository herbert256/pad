[{sequence:golomb from=2.5, increment='1...3', rows=3}{$sequence} @else@none{/sequence:golomb}][{sequence:fibonacci from=-2.5, increment='1...3', rows=3}{$sequence} @else@none{/sequence:fibonacci}][{sequence:fibonacci increment='0...0', rows=3}{$sequence} @else@none{/sequence:fibonacci}][{sequence:fibonacci increment='-3...-1', rows=3}{$sequence} @else@none{/sequence:fibonacci}][{sequence:square increment='-3...-1', rows=3}{$sequence} @else@none{/sequence:square}][{sequence:fibonacci increment='1...1', rows=4}{$sequence} {/sequence:fibonacci}][{sequence:fibonacci increment='0...2', rows=4, count}{$sequence}{/sequence:fibonacci}]

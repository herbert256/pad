op=[{pad:echo '{$op}'/}] result=[{sequence:range '1..3', eval='@ * 2'}{$sequence} {/sequence:range}] a=[{pad:echo '{$dash}'/}] b=[{sequence:range '5..3', eval='@ - 1'}{$sequence} {/sequence:range}] {pad:define 'twice'}* 2{/pad:define}c=[{sequence:range '1..3', eval='@ {define:twice/}'}{$sequence} {/sequence:range}]

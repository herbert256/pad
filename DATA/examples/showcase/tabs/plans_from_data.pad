{pad:meta title='A tab per row', about='The tabs made in a loop - one per plan of the data, its features inside.'/}
<div style="width:100%; max-width:640px">
  {widget:tabs}
    {array:plans}
      {widget:tab $name}
        <p><strong>{$price}</strong> a month - {$about}</p>
        <ul>{array:features}<li>{$features}</li>{/array:features}</ul>
      {/widget:tab}
    {/array:plans}
  {/widget:tabs}
</div>

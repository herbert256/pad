{holidays 'nl', year=2014, where='$local eq "Koningsdag"'}{$date} {/holidays}
{holidays 'nl', year=2025, where='$local eq "Koningsdag"'}{$date} {/holidays}
{holidays 'nl', year=2026, where='$local eq "Koningsdag"'}{$date} {/holidays}
{holidays 'nl', year=2013, where='$local eq "Koningsdag"'}{$date} @else@none{/holidays}
{holidays 'nl', year=2006, where='$local eq "Koninginnedag"'} {$date}{/holidays}

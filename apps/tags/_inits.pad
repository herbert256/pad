{common:padFrame}

  {slot 'head'}
    {asset 'tags.css', tag}
  {/slot}

  {slot 'title'}
    <form class="search" action="" method="get" role="search">
      <input type="hidden" name="search" value="">
      <label class="sr-only" for="q">Search the tags</label>
      <input type="search" id="q" name="q" value="{$tagsSearch}" placeholder="Search {$tagsCount} tags" autocomplete="off">
    </form>
  {/slot}

{/common:padFrame}

@page@

<footer class="foot">
  <p>{$tagsCount} built-in tags of PAD, each with its syntax, its own options and live examples - every result on this site rendered by the tag it documents.</p>
</footer>

{common:padFrameEnd}

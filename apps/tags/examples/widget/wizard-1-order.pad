{pad:meta title='An order in steps', about='Every tab a step, one at a time, with Back and Next - radio buttons and CSS, as tabs are.'/}
{widget:wizard label='Your order'}
  {widget:tab 'Address'}
    <p><label>Street <input name="street"></label></p>
  {/widget:tab}
  {widget:tab 'Delivery'}
    <p><label><input type="radio" name="when" checked> Tomorrow</label> <label><input type="radio" name="when"> Saturday</label></p>
  {/widget:tab}
  {widget:tab 'Payment'}
    <p>Pay by card or by bank transfer when the parcel is on its way.</p>
  {/widget:tab}
{/widget:wizard}

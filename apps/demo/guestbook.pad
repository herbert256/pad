<p>Sign our guestbook and leave a message for other visitors!</p>

{pad:flash}
  <div class="message">{$message}</div>
{/pad:flash}

{pad:if $error}
  <div class="message error">{$error}</div>
{/pad:if}

<h2>Sign the Guestbook</h2>

<form method="post">
  <input type="hidden" name="action" value="add">
  <p>
    <label for="guestbook-name">Your Name:</label><br>
    <input type="text" id="guestbook-name" name="name" required>
  </p>
  <p>
    <label for="guestbook-comment">Your Message:</label><br>
    <textarea id="guestbook-comment" name="comment" rows="4" required></textarea>
  </p>
  <p>
    <input type="submit" value="Sign Guestbook">
  </p>
</form>

<h2>Guestbook Entries</h2>

{pad:if $hasEntries}
  {array:entries}
    <div class="guest-entry">
      <div class="guest-name">{$name}</div>
      <div class="guest-date">{$date}</div>
      <p>{$comment}</p>
    </div>
  {/array:entries}
@else@
  <p>No entries yet. Be the first to sign!</p>
{/pad:if}

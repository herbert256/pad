{pad:meta title='elseif and else', about='The branches are tried in order - the first that holds wins.'/}
{array:temperatures}
  {pad:if $degrees lt 0}
    <p>{$city}: freezing</p>
  {pad:elseif $degrees lt 20}
    <p>{$city}: mild</p>
  {pad:else}
    <p>{$city}: warm</p>
  {/pad:if}
{/array:temperatures}

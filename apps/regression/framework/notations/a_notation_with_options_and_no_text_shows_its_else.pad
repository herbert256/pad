{data 'rows'}[{"t":""}]{/data}
{rows}
[{morse $t, plain}@else@-{/morse}]
[{math $t, display='block'}@else@-{/math}]
[{signals $t, size=20}@else@-{/signals}]
[{piano $t, size=60}@else@-{/piano}]
[{notation:chord $t, size=80}@else@-{/notation:chord}]
[{go $t, numbers}@else@-{/go}]
[{abc $t, width=300}@else@-{/abc}]
[{draughts $t, board=8}@else@-{/draughts}]
[{chess $t, size=100}@else@-{/chess}]
[{notation 'braille', $t, cells}@else@-{/notation}]
{/rows}

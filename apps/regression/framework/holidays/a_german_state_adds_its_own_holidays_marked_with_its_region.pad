{holidays 'de', year=2026}{$local}|{/holidays}
{holidays 'de-by', year=2026, where='$region'}{$date} {$local} [{$region}]|{/holidays}
{holidays 'de', region='sn', year=2026, where='$region'}{$date} {$local} [{$region}]|{/holidays}
{holidays 'de-bb', year=2017, where='$local eq "Reformationstag"'}{$date} [{$region}]|{/holidays}
{holidays 'de-by', year=2017, where='$local eq "Reformationstag"'}{$date} [{$region}]|{/holidays}

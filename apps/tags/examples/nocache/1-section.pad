{pad:meta title='A live part in a cached section', about='The list is kept five minutes; the greeting renders on every request - try ?examples/nocache/1-section&visitor=Ann.'/}
{pad:cache 'nocacheDemo', ttl=300}
  <p>{pad:nocache}Hello, {$nocacheVisitor}!{/pad:nocache}</p>
  <ul>
    {array:nocacheProducts}
      <li>{$name}</li>
    {/array:nocacheProducts}
  </ul>
{/pad:cache}

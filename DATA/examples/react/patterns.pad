<header class="example-head">
  <p class="lede">
    Every way the two meet, one page each - the live example on top, the template, the PHP and
    the component under it. The chips marked PAD are its part on the server, the ones in the
    accent colour React's in the browser.
  </p>
</header>

{array:groups}
<div class="group-head">
  <h2>{$title}</h2>
  <span class="badge">{$count} examples</span>
</div>
<p class="group-text">{$text}</p>
<div class="grid">
  {array:examples}
  <a class="card" href="?{$page}">
    <span class="card-icon" aria-hidden="true">{$icon}</span>
    <span class="card-go" aria-hidden="true">→</span>
    <h3>{$title}</h3>
    <p>{$lede}</p>
    <div class="chips">{array:server}<code class="chip is-server">{$server}</code>{/array:server}{array:client}<code class="chip is-client">{$client}</code>{/array:client}</div>
  </a>
  {/array:examples}
</div>
{/array:groups}

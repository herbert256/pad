{common:padFrame}
  {pad:slot 'head'}{pad:asset 'showcase.css', tag/}{pad:asset 'showcase.js', tag/}{/pad:slot}
{/common:padFrame}
{pad:if $isExample}
<div class="page example">

  <p class="lead"><span class="family-name">{$familyLabel}</span> {$exampleText}</p>

  <div class="stage{pad:if $oneCell} is-pair{/pad:if}">

    {pad:if not $oneCell}
    <section class="cell cell-data" aria-label="The data">
      <header class="cell-head">
        <span class="cell-num">1</span>
        <span class="cell-name">The data</span>
        <span class="cell-file">{$dataFile}</span>
        <span class="badge badge-{$dataLang}">{$dataLang}</span>
        <button type="button" class="copy" data-copy="data-src" aria-label="Copy the data">Copy</button>
      </header>
      <pre class="code" id="data-src"><code>{!dataHtml}</code></pre>
    </section>
    {/pad:if}

    <section class="cell cell-tag" aria-label="The tag">
      <header class="cell-head">
        <span class="cell-num">{pad:if $oneCell}1{pad:else}2{/pad:if}</span>
        <span class="cell-name">{pad:if $tagPair}The tag and its data{pad:elseif $tagOnly}The tag{pad:else}The template{/pad:if}</span>
        <span class="cell-file">{$tagFile}</span>
        <span class="badge badge-pad">pad</span>
        <button type="button" class="copy" data-copy="tag-src" aria-label="Copy the tag">Copy</button>
      </header>
      <pre class="code" id="tag-src"><code>{!tagHtml}</code></pre>
    </section>

    <section class="cell cell-chart" aria-label="The result">
      <header class="cell-head">
        <span class="cell-num">{pad:if $oneCell}2{pad:else}3{/pad:if}</span>
        <span class="cell-name">The result</span>
        <span class="cell-file">rendered on the server</span>
        {!playLink}
      </header>
      <div class="canvas">
{/pad:if}
@page@
{pad:if $isExample}
      </div>
    </section>

  </div>

  <nav class="pager" aria-label="More examples">
    <a class="pager-link prev" href="?{$prevPage}"><span class="pager-dir">← Previous</span><span class="pager-title">{$prevTitle}</span></a>
    <a class="pager-link next" href="?{$nextPage}"><span class="pager-dir">Next →</span><span class="pager-title">{$nextTitle}</span></a>
  </nav>

</div>
{/pad:if}
{common:padFrameEnd/}

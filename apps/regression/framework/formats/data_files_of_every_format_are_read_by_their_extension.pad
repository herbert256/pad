[{plan}{$title} {$start} {stops}{$name}={$hours};{/stops}{/plan}]
[{settings}{$name} {$database.host}:{$database.port} {$mail.from}{/settings}]
[{contacts}{$name} {$email} {$org}|{/contacts}]
[{agenda}{$summary} {$start} {$end}|{/agenda}]
[{ride}{$type} {$name}{$track} {$lat},{$lon} {$ele}|{/ride}]
[{places}{$name} {$lat},{$lon}|{/places}]
[{visits}{$page}={$hits};{/visits}]
[{scores}{$player}={$points};{/scores}]
[{stock}{$item}={$count};{/stock}]
[{sales}{$region}|{$sold}|{$day}|{$paid}|{$total}|{$F};{/sales}]
[{local:plan.toml}{$title}{/local:plan.toml}][{local:sales.xlsx sheet='Notes'}{$note}{/local:sales.xlsx}]

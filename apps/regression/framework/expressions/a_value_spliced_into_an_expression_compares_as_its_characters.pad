1[{array:people where='$email eq {$q}'}{$name}{/array:people}] 2[{array:people where='$email eq "{$q}"'}{$name}{/array:people}] 3[{array:people where='$city eq {$c}'}{$name}{/array:people}] 4[{pad:if '{$c}' eq 'Paris, TX'}y{pad:else}n{/pad:if}] 5[{pad:if {$c} eq 'Paris, TX'}y{pad:else}n{/pad:if}] 6[{pad:case '{$q}'}{pad:when 'ann@x.com'}hit{pad:else}miss{/pad:case}] 7[{pad:echo php:str_contains('{$c}', ',') ? 'has' : 'no'/}] 8[{pad:echo '{$c}' . '' | php:strlen/}] 9[{pad:echo '{$c}' | php:strtoupper/}] 10[{pad:if '{$c}' . '!' eq 'Paris, TX!'}y{pad:else}n{/pad:if}] 11[{pad:echo php:trim('{$t}')/}] 12[{pad:echo php:explode(' ', '{$t}') | php:implode('/', @)/}]
